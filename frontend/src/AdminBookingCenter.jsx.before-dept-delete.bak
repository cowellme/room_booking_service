import {useEffect, useMemo, useRef, useState} from 'react';
import {Archive, AlertTriangle, Building2, CalendarCheck, Check, ChevronRight, CircleX, Clock3, History,
        MapPin, MessageSquarePlus, Repeat2, Search, ShieldCheck, Sparkles, Trash2, UserRound, Users, Wrench, X} from 'lucide-react';
import {CLOSED_BOOKING_STATUSES as CLOSED, formatBookingDate as formatDate,
        formatBookingMoment as formatMoment, ROOM_TYPE_LABELS as roomTypeLabels,
        SOURCE_LABELS, STATUS_LABELS, todayIso, localIso, formatDepartmentCode} from './bookingCenterConfig';
import {BatchBookingDialog,DepartmentsDialog,OperationalGrid,ServiceBlockDialog,TransferDialog} from './AdminOperations';
import {additionalEquipmentOptions, equipmentSearchFilter} from './roomConfig';
import RoomEquipmentBlock from './RoomEquipmentBlock';

const groupSeriesItems=items=>{const groups=new Map();for(const item of items){const key=item.series_id?'series:'+item.series_id:'item:'+item.id;if(!groups.has(key))groups.set(key,[]);groups.get(key).push(item)}return [...groups.values()].map(group=>{group.sort((a,b)=>String(a.date+' '+a.time_start).localeCompare(String(b.date+' '+b.time_start)));const first=group[0];return group.length===1?first:{...first,series_items:group,series_count:group.length,series_dates:[group[0].date,group[group.length-1].date]}})};
const entriesOf=item=>item.series_items||[item];
const canArchive=item=>{if(item.archived_at||CLOSED.includes(item.status))return true;const now=new Date();const today=todayIso();const current=`${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}`;return item.date<today||(item.date===today&&item.time_end<=current)};
const chronological=(a,b)=>`${a.date||''} ${a.time_start||''} ${a.time_end||''}`.localeCompare(`${b.date||''} ${b.time_start||''} ${b.time_end||''}`)||Number(a.id||0)-Number(b.id||0);

export default function AdminBookingCenter({request,notice,rooms,buildings,user,focusedBooking,initialRoom,clearInitialRoom,onChanged,active=true,seriesRequest,clearSeriesRequest}){
  const [items,setItems]=useState([]);const [scope,setScope]=useState('all');const [tab,setTab]=useState('all');
  const [search,setSearch]=useState('');const [detail,setDetail]=useState(null);const [wizard,setWizard]=useState(null);
  const [view,setView]=useState(()=>localStorage.getItem('admin-bookings-view')||'list');
  const [pastFrom,setPastFrom]=useState('');const [pastTo,setPastTo]=useState(()=>nowMonthEnd());
  const [clock,setClock]=useState(new Date());
  const [cancelTarget,setCancelTarget]=useState(null);const [deleteTarget,setDeleteTarget]=useState(null);const [editTarget,setEditTarget]=useState(null);const [loading,setLoading]=useState(true);
  const [departments,setDepartments]=useState([]);const [operation,setOperation]=useState(null);const [transferTarget,setTransferTarget]=useState(null);const [rejectTarget,setRejectTarget]=useState(null);
  const [highlightedBooking,setHighlightedBooking]=useState(null);const [batchRoomIds,setBatchRoomIds]=useState([]);
  const load=()=>{setLoading(true);return request(`/api/admin/booking-center?scope=${scope}&_=${Date.now()}`).then(data=>setItems([...data].sort(chronological))).catch(e=>notice(e.message)).finally(()=>setLoading(false))};
  const loadDepartments=()=>request('/api/departments').then(setDepartments).catch(()=>{});
  useEffect(()=>{if(active)load()},[scope,active]);
  useEffect(()=>{loadDepartments()},[]);
  useEffect(()=>{if(!initialRoom)return;setWizard({booking:{building_id:String(initialRoom.building_id),room_type:initialRoom.type||'',preferred_room_id:initialRoom.id,preferred_room:initialRoom}});clearInitialRoom?.()},[initialRoom]);
  useEffect(()=>{if(!seriesRequest)return;setWizard(null);setBatchRoomIds(seriesRequest.room?[seriesRequest.room.id]:[]);setOperation('batch');clearSeriesRequest?.()},[seriesRequest?.token]);
  useEffect(()=>{localStorage.setItem('admin-bookings-view',view)},[view]);
  useEffect(()=>{const timer=setInterval(()=>setClock(new Date()),30000);return()=>clearInterval(timer)},[]);
  useEffect(()=>{if(!focusedBooking?.id)return;setScope('all');setTab('all');setSearch('');setView('list');setHighlightedBooking(focusedBooking.id);const timer=setTimeout(()=>setHighlightedBooking(null),4200);return()=>clearTimeout(timer)},[focusedBooking?.token]);
  useEffect(()=>{if(!highlightedBooking||loading)return;const timer=setTimeout(()=>document.querySelector(`[data-booking-ids~="${highlightedBooking}"]`)?.scrollIntoView({behavior:'smooth',block:'center'}),120);return()=>clearTimeout(timer)},[highlightedBooking,loading,items.length]);
  const now=todayIso();
  const metrics=useMemo(()=>({
    today:items.filter(x=>x.date===now&&!CLOSED.includes(x.status)).length,
    approved:items.filter(x=>x.status==='approved'&&x.date>=now).length,
    cancelled:items.filter(x=>x.cancelled_at?.slice(0,10)===now).length,
  }),[items,now]);
  const visible=items.filter(item=>{
    const text=`${item.title} ${item.room_number} ${item.building} ${item.customer_name||''} ${item.booked_by} ${item.department_code||''} ${item.department_name||''} ${item.external_reference||''}`.toLowerCase();
    if(search&&!text.includes(search.toLowerCase()))return false;
    if(tab==='today')return !item.archived_at&&item.date===now;
    if(tab==='upcoming')return !item.archived_at&&item.date>now&&!CLOSED.includes(item.status);
    if(tab==='cancelled')return !item.archived_at&&['cancelled','cancelled_by_user','cancelled_by_admin'].includes(item.status)&&item.cancellation_reason&&item.cancelled_by;
    if(tab==='past')return !item.archived_at&&item.date<now&&(!pastFrom||item.date>=pastFrom)&&(!pastTo||item.date<=pastTo);
    if(tab==='archive')return Boolean(item.archived_at);
    return !item.archived_at;
  });
  const refresh=async(message)=>{if(message)notice(message);setDetail(null);setCancelTarget(null);setEditTarget(null);await load();onChanged?.()};
  const openDetail=async item=>{try{setDetail(await request(`/api/admin/booking-center/${item.id}`))}catch(e){notice(e.message)}};
  const setStatus=async(item,status,reason=null)=>{const series=Boolean(item.series_items);try{await request(series?`/api/admin/booking-series/${item.series_id}/status`:`/api/admin/booking-center/${item.id}/status`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({status,reason})});setRejectTarget(null);refresh(series?(status==='approved'?'Серия бронирований подтверждена':'Серия бронирований отклонена'):status==='approved'?'Бронирование подтверждено':status==='rejected'?'Заявка отклонена':'Статус бронирования обновлён')}catch(e){notice(e.message)}};
  const setArchived=async(item,archived=true)=>{try{for(const entry of entriesOf(item).filter(entry=>archived?!entry.archived_at&&canArchive(entry):entry.archived_at))await request(`/api/admin/booking-center/${entry.id}/archive`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({archived})});refresh(archived?'Бронирование перенесено в архив':'Бронирование восстановлено из архива')}catch(e){notice(e.message)}};
  return <section className="content-page admin-booking-center">
    <header className="booking-center-heading"><div><small>РАБОЧИЙ ЦЕНТР АДМИНИСТРАТОРА</small><h1>Мои бронирования</h1><p>Проверяйте занятость, подбирайте альтернативы и сохраняйте полную историю решений.</p></div><div className="booking-primary-actions"><button className="secondary" onClick={()=>setOperation('departments')}><Users/>Подразделения</button><button className="secondary" onClick={()=>setOperation('block')}><AlertTriangle/>Блокировка</button><button className="secondary" onClick={()=>{setBatchRoomIds([]);setOperation('batch')}}><Sparkles/>Серия</button><button className="primary phone-booking-button" onClick={()=>setWizard({})}><CalendarCheck/>Оформить бронь</button></div></header>
    <div className="booking-kpis">
      <div className="booking-today-clock"><Clock3/><span><small>СЕГОДНЯ</small><b>{clock.toLocaleDateString('ru-RU',{weekday:'long',day:'numeric',month:'long'})}</b><time>{clock.toLocaleTimeString('ru-RU',{hour:'2-digit',minute:'2-digit',hour12:false})}</time></span></div>
      <Kpi icon={<Clock3/>} label="Сегодня" value={metrics.today} tone="blue" onClick={()=>setTab('today')}/>
      <Kpi icon={<Check/>} label="Подтверждены" value={metrics.approved} tone="green" onClick={()=>setTab('upcoming')}/>
      <Kpi icon={<CircleX/>} label="Отменены сегодня" value={metrics.cancelled} tone="orange" onClick={()=>setTab('cancelled')}/>
    </div>
    <div className="booking-center-controls"><div className="booking-tabs">{[['all','Все бронирования'],['today','Сегодня'],['upcoming','Предстоящие'],['cancelled','Отменённые'],['past','Прошедшие'],['archive','Архив']].map(([key,label])=><button key={key} className={tab===key?'active':''} onClick={()=>setTab(key)}>{label}</button>)}</div><div className="booking-scope"><button className={scope==='mine'?'active':''} onClick={()=>setScope('mine')}>Только мои</button><button className={scope==='all'?'active':''} onClick={()=>setScope('all')}>Все бронирования</button></div></div>
    {tab==='past'&&<div className="past-booking-calendar"><CalendarCheck/><b>Период прошедших бронирований</b><label>С <input type="date" lang="ru-RU" max={now} value={pastFrom} onChange={e=>setPastFrom(e.target.value)}/></label><label>По <input type="date" lang="ru-RU" max={now} value={pastTo} onChange={e=>setPastTo(e.target.value)}/></label><button className="secondary" onClick={()=>{setPastFrom('');setPastTo(nowMonthEnd())}}>Сбросить</button></div>}
    <div className="booking-list-toolbar"><label className="booking-center-search"><Search/><input value={search} onChange={e=>setSearch(e.target.value)} placeholder="Поиск по событию, аудитории, корпусу, подразделению или внешней заявке"/><span>{visible.length} записей</span></label><div className="booking-view-switch">{[['grid','Оперативная сетка'],['cards','Карточки'],['compact','Компактный'],['list','Обычный список']].map(([key,label])=><button key={key} className={view===key?'active':''} onClick={()=>setView(key)}>{label}</button>)}</div></div>
    {view==='grid'?<OperationalGrid items={visible} rooms={rooms} openBooking={initial=>setWizard({booking:initial})} openDetail={openDetail}/>:<div className={`admin-booking-list ${view}-view`}>{loading?<BookingSkeleton/>:visible.length?groupSeriesItems(visible).map(item=><BookingCard key={item.id} item={item} highlighted={entriesOf(item).some(entry=>entry.id===highlightedBooking)} open={()=>openDetail(item)} openEntry={openDetail} approve={()=>setStatus(item,'approved')} reject={()=>setRejectTarget(item)} alternatives={()=>setWizard({booking:item,replace:true})} repeat={()=>setWizard({booking:{...item,date:'',time_start:'',time_end:'',preferred_room_id:item.room_id,preferred_room:rooms.find(room=>room.id===item.room_id)}})} transfer={()=>setTransferTarget(item)} cancel={()=>setCancelTarget(item)} remove={()=>setDeleteTarget(item)} archive={()=>setArchived(item,!item.archived_at)}/>):<div className="booking-center-empty"><CalendarCheck/><b>В этом разделе записей нет</b><span>Измените фильтр или оформите новое бронирование.</span><button className="primary" onClick={()=>setWizard({})}>Оформить бронь</button></div>}</div>}
    {wizard&&<PhoneBookingWizard initial={wizard.booking} replaceId={wizard.replace?wizard.booking.id:null} rooms={rooms} buildings={buildings} departments={departments} request={request} user={user} close={()=>setWizard(null)} done={message=>{setWizard(null);setTab('all');setScope('all');refresh(message||'Бронирование подтверждено и добавлено в календарь')}}/>}
    {detail&&<BookingDetail item={detail} request={request} reload={()=>openDetail(detail)} close={()=>setDetail(null)} edit={()=>setEditTarget(detail)} alternatives={()=>{setDetail(null);setWizard({booking:detail,replace:true})}} transfer={()=>setTransferTarget(detail)} cancel={()=>setCancelTarget(detail)} remove={()=>setDeleteTarget(detail)} archive={()=>setArchived(detail,!detail.archived_at)} status={status=>setStatus(detail,status)}/>} 
    {cancelTarget&&<CancelDialog item={cancelTarget} request={request} close={()=>setCancelTarget(null)} done={()=>refresh('Отмена сохранена в истории')}/>} 
    {deleteTarget&&<DeleteBookingDialog item={deleteTarget} request={request} close={()=>setDeleteTarget(null)} done={()=>{const series=Boolean(deleteTarget.series_items);setDeleteTarget(null);refresh(series?'Серия полностью удалена':'Ошибочная бронь полностью удалена')}}/>}
    {editTarget&&<EditBooking item={editTarget} rooms={rooms} departments={departments} request={request} close={()=>setEditTarget(null)} done={()=>refresh('Бронирование обновлено')}/>} 
    {transferTarget&&<TransferDialog item={transferTarget} rooms={rooms} request={request} close={()=>setTransferTarget(null)} done={()=>{setTransferTarget(null);refresh('Бронирование перенесено, исходная запись сохранена в истории')}}/>}
    {rejectTarget&&<RejectBookingDialog item={rejectTarget} close={()=>setRejectTarget(null)} submit={reason=>setStatus(rejectTarget,'rejected',reason)}/>} 
    {operation==='block'&&<ServiceBlockDialog rooms={rooms} request={request} close={()=>setOperation(null)} done={()=>{setOperation(null);refresh('Служебная блокировка добавлена в календарь')}}/>}
    {operation==='batch'&&<BatchBookingDialog initialRoomIds={batchRoomIds} rooms={rooms} departments={departments} request={request} close={()=>setOperation(null)} done={message=>{setOperation(null);refresh(message)}}/>}
    {operation==='departments'&&<DepartmentsDialog departments={departments} request={request} close={()=>setOperation(null)} done={()=>{loadDepartments();notice('Подразделение добавлено')}}/>}
  </section>
}

function Kpi({icon,label,value,tone,onClick}){return <button className={`booking-kpi ${tone}`} onClick={onClick}><span>{icon}</span><b>{value}</b><small>{label}</small></button>}

function BookingSkeleton(){return <div className="booking-skeleton" aria-label="Загрузка бронирований">{Array.from({length:4},(_,index)=><article key={index}><i/><span><b/><b/><b/></span><em/></article>)}</div>}

function nowMonthEnd(){const value=new Date();return localIso(new Date(value.getFullYear(),value.getMonth()+1,0))}

function BookingCard({item,highlighted,open,openEntry,approve,reject,alternatives,repeat,transfer,cancel,remove,archive}){const series=Boolean(item.series_items);const archivable=entriesOf(item).some(entry=>entry.archived_at||canArchive(entry));const person=item.customer_name||item.booked_by;const owner=item.owner_name||item.booked_by;const kindLabels={maintenance:'Ремонт',setup:'Застройка',teardown:'Демонтаж',unavailable:'Недоступна'};return <article id={`admin-booking-${item.id}`} data-booking-ids={entriesOf(item).map(entry=>entry.id).join(' ')} className={`admin-booking-card ${highlighted?'booking-focus-highlight':''} ${item.has_conflict?'conflict':''} kind-${item.record_kind||'booking'}`}>
  <button className="booking-card-delete-icon" onClick={remove} title={series?'Удалить всю серию':'Удалить бронь'} aria-label={`Удалить ${series?'серию':'бронь'} ${item.title}`}><Trash2/></button>
  <div className="booking-card-date"><strong>{formatDate(item.date)}</strong><b>{item.time_start}–{item.time_end}</b><span>{SOURCE_LABELS[item.source]||item.source}</span>{item.created_at&&<small className="booking-created-at">Создана: {formatMoment(item.created_at)}</small>}</div>
  <div className="booking-card-main"><div className="booking-card-title"><em className={`status ${item.status}`}>{STATUS_LABELS[item.status]||item.status}</em>{item.record_kind!=='booking'&&<em className={`record-kind ${item.record_kind}`}>{kindLabels[item.record_kind]}</em>}{item.series_id&&<em className="series-pill">Серия</em>}{item.has_conflict&&<em className="conflict-pill"><AlertTriangle/>Конфликт</em>}</div><h3>{item.title}</h3>{item.series_items&&<div className="series-summary"><b>Серия бронирований</b><span>{item.series_count} записей · {formatDate(item.series_dates[0])} — {formatDate(item.series_dates[1])}</span><small>Нажмите на дату, чтобы открыть отдельную бронь серии.</small><div className="series-entry-list">{item.series_items.map(entry=><button type="button" key={entry.id} onClick={()=>openEntry(entry)}>{formatDate(entry.date)} · Ауд. {entry.room_number}{entry.status!==item.status?` · ${STATUS_LABELS[entry.status]||entry.status}`:''}</button>)}</div></div>}<div className="booking-room-highlight" style={{'--building-color':item.color}}><span><Building2/>Корпус <b>{item.building}</b></span><span>Аудитория <strong>{item.room_number}</strong></span></div><div className="booking-card-meta">{item.department_code&&<span><b>{item.department_code}</b> · {item.department_name}</span>}<span><UserRound/>{person}</span>{owner!==person&&<span><ShieldCheck/>{owner}</span>}<span><Users/>{item.participants||'—'} участников</span>{item.external_reference&&<span>Внешняя заявка: {item.external_reference}</span>}</div>{item.status==='pending'&&<div className="soft-hold-note"><Clock3/>Мягкий резерв до {item.hold_expires_at?formatMoment(item.hold_expires_at):'решения администратора'}</div>}{item.transfer_reason&&<div className="booking-cancellation-note"><b>Причина переноса: {item.transfer_reason}</b>{item.previous_booking_id&&<small>Исходная бронь № {item.previous_booking_id}</small>}</div>}{item.cancellation_reason&&<div className="booking-cancellation-note"><b>Причина: {item.cancellation_reason}</b><span>{item.cancellation_comment}</span><small>Отменил(а): {item.cancelled_by}</small></div>}</div>
  <div className="booking-card-actions">{!series&&<button className="secondary" onClick={open}>Подробности<ChevronRight/></button>}{item.record_kind==='booking'&&!series&&<button className="secondary repeat-booking" onClick={repeat} title="Создать новую бронь с теми же данными"><Repeat2/>Повторить</button>}{item.status==='pending'&&<><button className="soft-danger" onClick={reject}>{series?'Отказать по серии':'Отказать'}</button><button className="primary" onClick={approve}>{series?'Подтвердить серию':'Подтвердить'}</button></>} {!CLOSED.includes(item.status)&&item.status!=='pending'&&(item.record_kind==='booking'||series)&&<>{!series&&<><button className="secondary" onClick={alternatives}>Найти замену</button><button className="secondary" onClick={transfer}>Перенести</button></>}<button className="danger-link" onClick={cancel}>{series?'Отменить серию':'Отменить'}</button></>}{archivable&&<button className="archive-button" onClick={archive}><Archive/>{item.archived_at?(series?'Вернуть серию из архива':'Вернуть из архива'):(series?'Серию в архив':'В архив')}</button>}</div>
</article>}

function PhoneBookingWizard({initial,replaceId,rooms,buildings,departments,request,user,close,done}){
  const [step,setStep]=useState(1);const [results,setResults]=useState(null);const [selected,setSelected]=useState(initial?.preferred_room||null);const [error,setError]=useState('');const [saving,setSaving]=useState(false);
  const [form,setForm]=useState({date:initial?.date||'',time_start:initial?.time_start||'',time_end:initial?.time_end||'',participants:initial?.participants||'',building_id:initial?.building_id?String(initial.building_id):'',room_type:initial?.room_type||'',equipment:replaceId?(initial?.requested_equipment||[]):[],title:initial?.title||'',customer_name:initial?.customer_name||'',customer_contact:initial?.customer_contact||'',comment:initial?.comment||'',department_id:initial?.department_id||'',external_channel:initial?.external_channel||(initial?.preferred_room&&!initial?.id?'service':'phone'),external_reference:initial?.external_reference||'',external_url:initial?.external_url||''});
  const [equipmentSearch,setEquipmentSearch]=useState('');const [invalid,setInvalid]=useState([]);const availabilityRef=useRef(null);
  const equipmentOptions=useMemo(()=>additionalEquipmentOptions(rooms),[rooms]);
  const equipmentRoom=selected?(rooms.find(room=>room.id===selected.id)||selected):null;
  const visibleEquipment=equipmentOptions.filter(item=>item.toLowerCase().includes(equipmentSearch.toLowerCase()));
  const change=(key,value)=>setForm(current=>({...current,[key]:value}));
  const toggleEquipment=value=>change('equipment',form.equipment.includes(value)?form.equipment.filter(x=>x!==value):[...form.equipment,value]);
  const validateRequired=()=>{const required={date:form.date,time_start:form.time_start,time_end:form.time_end,participants:Number(form.participants)>0,building_id:form.building_id,title:form.title.trim().length>=2,customer_name:form.customer_name.trim().length>=2,customer_contact:form.customer_contact.trim().length>=3,department_id:form.department_id};const missing=Object.entries(required).filter(([,value])=>!value).map(([key])=>key);if(form.time_start&&form.time_end&&form.time_end<=form.time_start&&!missing.includes('time_end'))missing.push('time_end');if(missing.length){setInvalid(missing);setError('Заполните все обязательные поля, включая ФИО, подразделение и телефон');setStep(1);window.setTimeout(()=>setInvalid([]),2400);return false}setInvalid([]);setError('');return true};
  const chooseRoom=room=>{if(!validateRequired())return;setSelected(room);setStep(3)};
  const fetchAvailability=async goNext=>{setError('');try{const body={date:form.date,time_start:form.time_start,time_end:form.time_end,participants:Number(form.participants)||1,building_id:form.building_id?Number(form.building_id):null,room_type:form.room_type||null,equipment:equipmentSearchFilter(form.equipment),exclude_booking_id:initial?.id||null};const data=await request('/api/admin/availability',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});setResults(data);const preferred=data.free.find(room=>room.id===initial?.preferred_room_id);if(goNext&&preferred){setSelected(preferred);setStep(3)}else if(goNext)setStep(2);else window.setTimeout(()=>availabilityRef.current?.scrollIntoView({behavior:'smooth',block:'start'}),120)}catch(e){setError(e.message)}};
  useEffect(()=>{if(step!==1||!form.date||!form.building_id||!form.time_start||!form.time_end||form.time_start>=form.time_end)return;const timer=setTimeout(()=>fetchAvailability(false),450);return()=>clearTimeout(timer)},[step,form.date,form.building_id,form.time_start,form.time_end,form.participants,form.room_type,form.equipment.join('|')]);
  const check=()=>{if(validateRequired())fetchAvailability(true)};
  const submit=async()=>{if(!selected||!validateRequired())return;setSaving(true);setError('');try{if(replaceId){await request(`/api/admin/booking-center/${replaceId}`,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({room_id:selected.id,date:form.date,time_start:form.time_start,time_end:form.time_end,title:form.title.trim(),comment:form.comment.trim()||null,requested_equipment:form.equipment,customer_name:form.customer_name.trim(),customer_contact:form.customer_contact.trim()||null,participants:Number(form.participants),department_id:form.department_id?Number(form.department_id):null})});done('Бронь перенесена в подобранную аудиторию');return}await request('/api/admin/phone-bookings',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({room_id:selected.id,date:form.date,time_start:form.time_start,time_end:form.time_end,title:form.title.trim(),booking_type:'other',group_name:null,teacher:null,comment:form.comment.trim()||null,requested_equipment:form.equipment,customer_name:form.customer_name.trim(),customer_contact:form.customer_contact.trim()||null,participants:Number(form.participants),department_id:form.department_id?Number(form.department_id):null,external_channel:form.external_channel||null,external_reference:form.external_reference.trim()||null,external_url:form.external_url.trim()||null})});done()}catch(e){setError(e.message);setSaving(false)}};
  const preferredResult=results?.free.find(room=>room.id===initial?.preferred_room_id);const displayedResults=results&&preferredResult?{...results,free:[preferredResult],summary:{...results.summary,free:1}}:results;
  return <div className="center-modal"><button className="center-backdrop" onClick={close}/><section className="phone-wizard"><header><div><small>{replaceId?`ПОДБОР ЗАМЕНЫ ДЛЯ БРОНИ № ${replaceId}`:'ОФОРМЛЕНИЕ БРОНИ'}</small><h2>{step===1?'Параметры запроса':step===2?'Свободные варианты':'Подтверждение брони'}</h2></div><button className="icon" onClick={close}><X/></button></header><div className="wizard-progress">{[1,2,3].map(number=><span className={step>=number?'active':''} key={number}><b>{step>number?<Check/>:number}</b>{['Запрос','Подбор','Подтверждение'][number-1]}</span>)}</div>{initial?.preferred_room&&step===1&&<div className="user-preselected-room admin-preselected-room" style={{'--room-color':initial.preferred_room.color}}><img src={initial.preferred_room.images?.[0]} alt=""/><span><small>ВЫБРАННАЯ АУДИТОРИЯ</small><b>{initial.preferred_room.building} · аудитория {initial.preferred_room.number}</b><em>{initial.preferred_room.name} · {initial.preferred_room.capacity} мест</em></span><Check/></div>}
    {step===1&&<><div className="wizard-fields">
      <label className={`${form.date?'is-complete':''} ${invalid.includes('date')?'is-invalid':''}`}><span>Дата</span><RussianDatePicker value={form.date} min={todayIso()} onChange={value=>change('date',value)}/><small>{form.date?<>✓ {formatDate(form.date)}</>:'Выберите день, месяц и год'}</small></label>
      <label className={`${form.time_start?'is-complete':''} ${invalid.includes('time_start')?'is-invalid':''}`}><span>Начало</span><Time24Select value={form.time_start} onChange={value=>change('time_start',value)}/></label>
      <label className={`${form.time_end&&form.time_end>form.time_start?'is-complete':''} ${invalid.includes('time_end')?'is-invalid':''}`}><span>Окончание</span><Time24Select value={form.time_end} onChange={value=>change('time_end',value)}/></label>
      <label className={`${Number(form.participants)>0?'is-complete':''} ${invalid.includes('participants')?'is-invalid':''}`}><span>Участников</span><input type="number" min="1" value={form.participants} onChange={e=>change('participants',e.target.value)} placeholder="Введите количество"/></label>
      <label className={`${form.building_id?'is-complete':''} ${invalid.includes('building_id')?'is-invalid':''}`}><span>Корпус</span><select value={form.building_id} onChange={e=>change('building_id',e.target.value)}><option value="">Выберите корпус</option>{buildings.map(b=><option value={b.id} key={b.id}>{b.name}</option>)}</select></label>
      <label className={form.room_type?'is-complete':''}><span>Тип аудитории</span><select value={form.room_type} onChange={e=>change('room_type',e.target.value)}><option value="">Любой тип</option>{Object.entries(roomTypeLabels).map(([key,label])=><option value={key} key={key}>{label}</option>)}</select></label>
      <label className={`full ${form.title?'is-complete':''} ${invalid.includes('title')?'is-invalid':''}`}><span>Название мероприятия</span><input value={form.title} onChange={e=>change('title',e.target.value)} placeholder="Например, совещание проектной группы"/></label>
      <label className={`${form.customer_name?'is-complete':''} ${invalid.includes('customer_name')?'is-invalid':''}`}><span>Заказчик</span><input value={form.customer_name} onChange={e=>change('customer_name',e.target.value)} placeholder="ФИО заказчика"/></label>
      <label className={`${form.department_id?'is-complete':''} ${invalid.includes('department_id')?'is-invalid':''}`}><span>Структурное подразделение *</span><select value={form.department_id} onChange={e=>change('department_id',e.target.value)} required><option value="">Выберите подразделение</option>{departments.map(item=><option value={item.id} key={item.id}>{formatDepartmentCode(item.code)} · {item.name}</option>)}</select></label>
      <label className={`${form.customer_contact?'is-complete':''} ${invalid.includes('customer_contact')?'is-invalid':''}`}><span>Телефон *</span><input type="tel" value={form.customer_contact} onChange={e=>change('customer_contact',e.target.value)} placeholder="+7 999 000-00-00" required minLength="3"/></label>
      <label><span>Источник запроса</span><select value={form.external_channel} onChange={e=>change('external_channel',e.target.value)}><option value="phone">Звонок по телефону</option><option value="service">Оформлено в сервисе без звонка</option><option value="pyrus">Pyrus</option><option value="telegram">Telegram</option><option value="email">Email</option><option value="other">Другой</option></select></label>
      <label><span>Номер внешней заявки</span><input value={form.external_reference} onChange={e=>change('external_reference',e.target.value)} placeholder="Необязательное поле"/></label>
      <label><span>Ссылка на заявку</span><input type="url" value={form.external_url} onChange={e=>change('external_url',e.target.value)} placeholder="Необязательное поле"/></label>
      <RoomEquipmentBlock className="full" rooms={[equipmentRoom]}/>
      <details className={`full wizard-equipment-dropdown ${form.equipment.length?'is-complete':''}`}><summary><span><Wrench/>Дополнительное техническое оснащение</span><b>{form.equipment.length||'Не выбрано'}</b><ChevronRight/></summary><label className="equipment-quick-search"><Search/><input aria-label="Поиск технического оснащения" value={equipmentSearch} onChange={e=>setEquipmentSearch(e.target.value)}/></label><div>{visibleEquipment.map(item=><label key={item}><input type="checkbox" checked={form.equipment.includes(item)} onChange={()=>toggleEquipment(item)}/><span>{item}</span></label>)}</div></details>
      <label className={`full ${form.comment?'is-complete':''}`}><span>Комментарий</span><textarea value={form.comment} onChange={e=>change('comment',e.target.value)} placeholder="Необязательное поле"/></label>
    </div>{displayedResults&&form.building_id&&<div ref={availabilityRef}><InlineAvailableRooms results={displayedResults} choose={room=>{setSelected(room);setStep(3)}}/></div>}</>}
    {step===2&&<AvailabilityResults results={results} selected={selected} choose={chooseRoom}/>} 
    {step===3&&selected&&<div className="booking-confirmation"><div className="confirmation-room"><img src={selected.images?.[0]} alt=""/><div><small>ВЫБРАННАЯ АУДИТОРИЯ</small><h3>Ауд. {selected.number}</h3><p>{selected.building} · {selected.capacity} мест</p></div></div><dl><div><dt>Дата и время</dt><dd>{formatDate(form.date)}, {form.time_start}–{form.time_end}</dd></div><div><dt>Мероприятие</dt><dd>{form.title}</dd></div><div><dt>Заказчик</dt><dd>{form.customer_name} · {form.customer_contact}</dd></div><div><dt>Ответственный</dt><dd>{user.full_name}</dd></div><div><dt>Оснащение аудитории</dt><dd>{(equipmentRoom?.equipment||[]).join(', ')||'Не указано'}</dd></div><div><dt>Дополнительное оснащение</dt><dd>{form.equipment.join(', ')||'Без дополнительных требований'}</dd></div></dl><div className="system-recommendation good"><ShieldCheck/><span><b>Можно подтверждать</b>Аудитория свободна, вместимость соответствует запросу.</span></div></div>}
    {error&&<p className="error">{error}</p>}<footer>{step>1&&<button className="secondary" onClick={()=>setStep(step-1)}>Назад</button>}<span/>{step===1&&<button className="primary" onClick={check}>Проверить доступность<ChevronRight/></button>}{step===3&&<button className="primary" disabled={saving} onClick={submit}>{saving?'Сохраняем…':replaceId?'Перенести бронь в эту аудиторию':'Подтвердить и забронировать'}</button>}</footer>
  </section></div>
}

function Time24Select({value,onChange,name}){const options=Array.from({length:29},(_,index)=>{const minutes=8*60+index*30;return `${String(Math.floor(minutes/60)).padStart(2,'0')}:${String(minutes%60).padStart(2,'0')}`});return <select name={name} value={value} onChange={e=>onChange?.(e.target.value)}><option value="">Выберите время</option>{options.map(time=><option value={time} key={time}>{time}</option>)}</select>}

function RussianDatePicker({value,onChange,min}){return <input type="date" lang="ru-RU" min={min} value={value} onChange={event=>onChange(event.target.value)}/>}

function InlineAvailableRooms({results,choose}){return <section className="inline-available"><header><div><small>ДОСТУПНЫ НА ВЫБРАННУЮ ДАТУ</small><h3>Свободные аудитории выбранного корпуса</h3></div><span>{results.free.length}</span></header><div>{results.free.length?results.free.map(room=><button type="button" key={room.id} onClick={()=>choose(room)}><img src={room.images?.[0]} alt=""/><span><b>Ауд. {room.number}</b><small>{room.building}</small><em>{room.capacity} мест · {roomTypeLabels[room.type]||room.type}</em>{room.pending_requests?.length>0&&<strong className="soft-request-warning">Параллельных заявок: {room.pending_requests.length}</strong>}</span><ChevronRight/></button>):<p>По заданным параметрам свободных аудиторий нет. Измените время, вместимость или оснащение.</p>}</div></section>}

function AvailabilityResults({results,choose}){const groups=[['free','Подходит и свободна','green'],['occupied','Занята в это время','red'],['alternatives','Возможные альтернативы','blue']];return <div className="availability-results"><div className="availability-summary"><ShieldCheck/><span><b>{results.summary.free} подходящих свободных</b>Ещё {results.summary.alternatives} альтернатив и {results.summary.occupied} занятых вариантов</span></div>{groups.map(([key,title,tone])=><section key={key}><h3 className={tone}>{title}<span>{results[key].length}</span></h3><div>{results[key].length?results[key].map(room=><article className={`availability-room ${tone}`} key={room.id}><img src={room.images?.[0]} alt=""/><div><b>Ауд. {room.number}</b><small>{room.building}</small><p>{room.capacity} мест · {roomTypeLabels[room.type]||room.type}</p>{room.conflict&&<em>Занята {room.conflict.time_start}–{room.conflict.time_end}: {room.conflict.title}</em>}{!room.conflict&&room.nearest_booking&&<em>Ближайшая бронь: {room.nearest_booking.time_start}–{room.nearest_booking.time_end}</em>}{room.pending_requests?.length>0&&<strong className="soft-request-warning">Есть параллельные заявки: {room.pending_requests.length}</strong>}</div>{key!=='occupied'&&<button className="primary" onClick={()=>choose(room)}>Выбрать</button>}</article>):<p className="availability-empty">В этой группе вариантов нет</p>}</div></section>)}</div>}

function BookingDetail({item,request,reload,close,edit,alternatives,transfer,cancel,remove,archive,status}){
  const [comment,setComment]=useState('');const [commentError,setCommentError]=useState('');
  const addComment=async event=>{event.preventDefault();try{await request(`/api/admin/booking-center/${item.id}/comments`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({text:comment})});setComment('');await reload()}catch(error){setCommentError(error.message)}};
  return <div className="center-modal"><button className="center-backdrop" onClick={close}/><aside className="booking-detail-panel"><header><div><small>БРОНИРОВАНИЕ № {item.id}</small><h2>{item.title}</h2></div><button className="icon" onClick={close}><X/></button></header>
    <div className={`system-recommendation ${item.assessment?.available?'good':'bad'}`}>{item.assessment?.available?<ShieldCheck/>:<AlertTriangle/>}<span><b>{item.assessment?.available?'Аудитория доступна':'Нужна проверка'}</b>{item.assessment?.message}</span></div>
    <section><h3>Запрос</h3><dl className="detail-grid"><div><dt>Дата и время</dt><dd>{formatDate(item.date)}, {item.time_start}–{item.time_end}</dd></div><div><dt>Аудитория</dt><dd>Ауд. {item.room_number}, {item.building}</dd></div><div><dt>Заказчик</dt><dd>{item.customer_name||'Не указан'}{item.customer_contact?` · ${item.customer_contact}`:''}</dd></div><div><dt>Ответственный</dt><dd>{item.owner_name}</dd></div><div><dt>Подразделение</dt><dd>{item.department_code?`${item.department_code} · ${item.department_name}`:'Не указано'}</dd></div><div><dt>Источник</dt><dd>{SOURCE_LABELS[item.source]||item.source}</dd></div><div><dt>Внешняя заявка</dt><dd>{item.external_url?<a href={item.external_url} target="_blank" rel="noreferrer">{item.external_reference||'Открыть ссылку'}</a>:item.external_reference||'Нет'}</dd></div><div><dt>Участники</dt><dd>{item.participants||'Не указано'}</dd></div><div><dt>Дополнительное оснащение</dt><dd>{(item.requested_equipment||[]).join(', ')||'Не запрошено'}</dd></div><div><dt>Комментарий к заявке</dt><dd>{item.comment||'Нет'}</dd></div></dl>{item.transfer_reason&&<div className="detail-cancellation transfer"><b>Причина переноса: {item.transfer_reason}</b>{item.previous_booking_id&&<p>Исходная бронь № {item.previous_booking_id} сохранена в истории.</p>}</div>}{item.cancellation_reason&&<div className="detail-cancellation"><b>Причина отмены: {item.cancellation_reason}</b><p>{item.cancellation_comment}</p><small>Отменил(а): {item.cancelled_by} · {formatMoment(item.cancelled_at)}</small>{item.notify_customer&&<small>Отмечено: нужно дополнительно сообщить заказчику</small>}</div>}</section>
    <section className="booking-comments"><h3><MessageSquarePlus/>Рабочие комментарии</h3><form onSubmit={addComment}><textarea value={comment} onChange={event=>setComment(event.target.value)} required minLength="2" placeholder="Комментарий, поручение или уточнение для коллег"/><button className="primary">Добавить</button></form>{commentError&&<p className="error">{commentError}</p>}<div>{item.comments?.map(entry=><article key={entry.id}><span><b>{entry.author}</b><time>{formatMoment(entry.created_at)}</time><p>{entry.text}</p></span></article>)}</div></section>
    <section><h3><History/>История изменений</h3><div className="booking-timeline">{item.events?.map(event=><article key={event.id}><i/><div><b>{event.summary}</b><p>{event.actor}</p>{event.data?.reason&&<p>Причина: {event.data.reason}</p>}{event.data?.comment&&<p>Комментарий: {event.data.comment}</p>}<time>{formatMoment(event.created_at)}</time></div></article>)}</div></section>
    <footer>{!CLOSED.includes(item.status)&&item.record_kind==='booking'&&<><button className="secondary" onClick={alternatives}>Найти замену</button><button className="secondary" onClick={edit}>Изменить</button><button className="secondary" onClick={transfer}>Перенести</button></>}{item.status==='pending'&&<button className="primary" onClick={()=>status('approved')}>Подтвердить</button>}{item.status==='approved'&&item.record_kind==='booking'&&<><button className="secondary" onClick={()=>status('completed')}>Состоялось</button><button className="secondary" onClick={()=>status('no_show')}>Неявка</button></>}{item.status==='completed'&&item.record_kind==='booking'&&<button className="secondary" onClick={()=>status('no_show')}>Отметить неявку</button>}{item.status==='no_show'&&<button className="secondary" onClick={()=>status('completed')}>Всё же состоялось</button>}{!CLOSED.includes(item.status)&&<button className="soft-danger" onClick={cancel}>Отменить</button>}{canArchive(item)&&<button className="archive-button" onClick={archive}><Archive/>{item.archived_at?'Вернуть из архива':'В архив'}</button>}<button className="delete-booking-button" onClick={remove}><Trash2/>Удалить</button></footer>
  </aside></div>
}

function RejectBookingDialog({item,close,submit}){const [reason,setReason]=useState('');return <div className="center-modal nested"><button className="center-backdrop" onClick={close}/><form className="action-dialog" onSubmit={event=>{event.preventDefault();submit(reason)}}><header><div><small>{item.series_items?`РЕШЕНИЕ ПО СЕРИИ · ${item.series_count} БРОНИРОВАНИЙ`:`РЕШЕНИЕ ПО ЗАЯВКЕ № ${item.id}`}</small><h2>{item.series_items?'Отклонить серию':'Отклонить заявку'}</h2></div><button type="button" className="icon" onClick={close}><X/></button></header><p>Пользователь увидит эту причину в истории заявки.</p><label><span>Причина отказа</span><textarea value={reason} onChange={event=>setReason(event.target.value)} required minLength="2" placeholder="Объясните причину и при необходимости предложите другой вариант"/></label><footer><button type="button" className="secondary" onClick={close}>Назад</button><button className="soft-danger">Отклонить заявку</button></footer></form></div>}

function CancelDialog({item,request,close,done}){const targets=entriesOf(item).filter(entry=>!CLOSED.includes(entry.status));const [saving,setSaving]=useState(false);const [error,setError]=useState('');const submit=async e=>{e.preventDefault();setSaving(true);const form=new FormData(e.currentTarget);try{for(const entry of targets)await request(`/api/admin/booking-center/${entry.id}/cancel`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({reason:form.get('reason'),comment:form.get('comment'),replacement_offered:form.has('replacement_offered'),notify_customer:form.has('notify_customer')})});done()}catch(err){setError(err.message);setSaving(false)}};return <div className="center-modal nested"><button className="center-backdrop" onClick={close}/><form className="action-dialog" onSubmit={submit}><header><div><small>ОТМЕНА С СОХРАНЕНИЕМ ИСТОРИИ</small><h2>{item.series_items?'Отменить серию':'Отменить бронирование'}</h2></div><button type="button" className="icon" onClick={close}><X/></button></header>{item.series_items&&<p><b>Будет отменено записей серии: {targets.length}.</b></p>}<p>Бронь не будет удалена. Факт отмены, причина, комментарий и ответственный администратор сохранятся в истории.</p><label><span>Причина отмены</span><select name="reason" required><option value="">Выберите причину</option><option>Отмена заказчиком</option><option>Изменение планов подразделения</option><option>Техническая недоступность аудитории</option><option>Перенос мероприятия</option><option>Другая причина</option></select></label><label><span>Комментарий</span><textarea name="comment" required minLength="2" placeholder="Уточните обстоятельства отмены"/></label><label className="check-row"><input type="checkbox" name="replacement_offered"/><span>Заказчику предложена замена</span></label><label className="check-row"><input type="checkbox" name="notify_customer" defaultChecked/><span>Нужно дополнительно сообщить заказчику (звонок или письмо)</span></label>{error&&<p className="error">{error}</p>}<footer><button type="button" className="secondary" onClick={close}>Назад</button><button className="soft-danger" disabled={saving}>{saving?'Сохраняем…':'Подтвердить отмену'}</button></footer></form></div>}

function DeleteBookingDialog({item,request,close,done}){const [saving,setSaving]=useState(false);const [error,setError]=useState('');const remove=async()=>{setSaving(true);setError('');try{for(const entry of entriesOf(item))await request(`/api/admin/booking-center/${entry.id}`,{method:'DELETE'});await done()}catch(failure){setError(failure.message);setSaving(false)}};return <div className="center-modal nested"><button className="center-backdrop" onClick={close}/><section className="action-dialog delete-booking-dialog" role="dialog" aria-modal="true"><header><div><small>БЕЗВОЗВРАТНОЕ УДАЛЕНИЕ</small><h2>{item.series_items?`Точно удалить всю серию (${item.series_count})?`:'Точно удалить бронь?'}</h2></div><button type="button" className="icon" onClick={close}><X/></button></header><div className="delete-booking-warning"><AlertTriangle/><span><b>Это действие нельзя отменить</b><p>Бронь и связанная с ней история будут полностью удалены. Для обычной отмены используйте кнопку «Отменить».</p></span></div><div className="delete-booking-summary"><strong>{item.title}</strong><span>{item.series_items?`${formatDate(item.series_dates[0])} — ${formatDate(item.series_dates[1])}`:formatDate(item.date)}, {item.time_start}–{item.time_end}</span><b>{item.building} · аудитория {item.room_number}</b></div>{error&&<p className="error">{error}</p>}<footer><button type="button" className="secondary" onClick={close}>Нет, оставить</button><button type="button" className="confirm-delete-button" disabled={saving} onClick={remove}><Trash2/>{saving?'Удаляем…':'Да, удалить безвозвратно'}</button></footer></section></div>}

function EditBooking({item,rooms,departments,request,close,done}){const [error,setError]=useState('');const [saving,setSaving]=useState(false);const [start,setStart]=useState(item.time_start);const [end,setEnd]=useState(item.time_end);const submit=async e=>{e.preventDefault();setSaving(true);const data=Object.fromEntries(new FormData(e.currentTarget));data.room_id=Number(data.room_id);data.department_id=Number(data.department_id);data.participants=data.participants?Number(data.participants):null;try{await request(`/api/admin/booking-center/${item.id}`,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});done()}catch(err){setError(err.message);setSaving(false)}};return <div className="center-modal nested"><button className="center-backdrop" onClick={close}/><form className="action-dialog edit-booking-dialog" onSubmit={submit}><header><div><small>КОРРЕКТИРОВКА БРОНИРОВАНИЯ</small><h2>Изменить параметры</h2></div><button type="button" className="icon" onClick={close}><X/></button></header><div className="wizard-fields"><label className="full"><span>Аудитория</span><select name="room_id" defaultValue={item.room_id}>{rooms.map(room=><option value={room.id} key={room.id}>{room.number} · {room.building} · {room.capacity} мест</option>)}</select></label><label><span>Дата</span><input name="date" type="date" lang="ru" min={todayIso()} defaultValue={item.date} required/></label><label><span>Начало</span><Time24Select name="time_start" value={start} onChange={setStart}/></label><label><span>Окончание</span><Time24Select name="time_end" value={end} onChange={setEnd}/></label><label><span>Участников</span><input name="participants" type="number" min="1" defaultValue={item.participants||''}/></label><label className="full"><span>Название</span><input name="title" defaultValue={item.title} required minLength="2"/></label><label><span>ФИО ответственного *</span><input name="customer_name" defaultValue={item.customer_name||''} required minLength="2"/></label><label><span>Структурное подразделение *</span><select name="department_id" defaultValue={item.department_id||''} required><option value="" disabled>Выберите подразделение</option>{departments.map(department=><option value={department.id} key={department.id}>{department.code} · {department.name}</option>)}</select></label><label><span>Телефон *</span><input name="customer_contact" type="tel" defaultValue={item.customer_contact||''} required minLength="3"/></label><label className="full"><span>Комментарий</span><textarea name="comment" defaultValue={item.comment||''}/></label></div>{error&&<p className="error">{error}</p>}<footer><button type="button" className="secondary" onClick={close}>Отмена</button><button className="primary" disabled={saving}>{saving?'Проверяем…':'Сохранить изменения'}</button></footer></form></div>}
