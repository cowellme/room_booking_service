import { useEffect, useMemo, useRef, useState } from 'react';
import { AlertCircle, Briefcase, Building2, CalendarCheck, Camera, Circle, Lock, Mail, Phone, Upload, UserRound, CalendarDays, CheckCircle2, ChevronDown, ChevronLeft, ChevronRight, Clock3, Eye, EyeOff, Info, LogOut, MapPin, Plus, RotateCcw, School, Search, ShieldCheck, Users, Wrench, X } from 'lucide-react';
import AdminBookingCenter, { PhoneBookingWizard } from './AdminBookingCenter';
import AnalyticsPage from './Analytics';
import UserBookingPortal from './UserBookingPortal';
import RoomEquipmentBlock from './RoomEquipmentBlock';
import {groupSeriesItems} from './bookingCenterConfig';
import {BOOKING_TYPE_LABELS, ROOM_TYPE_LABELS as ROOM_TYPES, additionalEquipmentOptions, roomEquipmentCategories} from './roomConfig';
import './userBooking.css';
import { AttachmentList, AttachmentPicker, uploadAttachments, uploadFailureNotice } from './BookingAttachments';
import { ExtraRoomsPicker, RoomSetList, attachRoomSets, extraRoomsPayload, extraRoomsReady } from './RoomSets';

let csrfToken = '';
let onSessionExpired = null;
const api = async (url, options, retryCsrf=true) => {
  const config = {...options, credentials:'include', headers:{...options?.headers, ...(csrfToken && options?.method && options.method !== 'GET' ? {'X-CSRF-Token':csrfToken}:{})}};
  const response = await fetch(url, config);
  const data = await response.json().catch(()=>({}));
  if(response.status===401&&!url.startsWith('/api/auth/')) onSessionExpired?.();
  if(response.status===403&&retryCsrf&&options?.method&&options.method!=='GET'&&String(data.detail||'').includes('CSRF')){
    const sessionResponse=await fetch('/api/auth/me',{credentials:'include'});
    const session=await sessionResponse.json().catch(()=>({}));
    if(sessionResponse.ok&&session.csrf_token){csrfToken=session.csrf_token;return api(url,options,false)}
  }
  if (!response.ok) {
    const detail=Array.isArray(data.detail)?data.detail.map(item=>item.msg||item.message||JSON.stringify(item)).join('; '):data.detail;
    throw new Error(typeof detail==='string'?detail:'Ошибка сервера');
  }
  return data;
};
const iso = d => `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
const RU_MONTHS=['Январь','Февраль','Март','Апрель','Май','Июнь','Июль','Август','Сентябрь','Октябрь','Ноябрь','Декабрь'];
const RU_WEEKDAYS_SHORT=['пн','вт','ср','чт','пт','сб','вс'];
const RU_WEEKDAYS_LONG=['понедельник','вторник','среда','четверг','пятница','суббота','воскресенье'];
const RU_MONTHS_GEN=['января','февраля','марта','апреля','мая','июня','июля','августа','сентября','октября','ноября','декабря'];
const monthTitle = d => `${RU_MONTHS[d.getMonth()]} ${d.getFullYear()}`;
const addDays = (date, amount) => { const value=new Date(date); value.setDate(value.getDate()+amount); return value };
const startOfWeek = date => addDays(date, -((date.getDay()+6)%7));
const roomPhoto = id => { const n=((Number(id)-1)%6)+1; return `/img/rooms/room-${n}.${n===6?'jpg':'png'}` };
const buildingPhoto = id => `/img/buildings/building-${((Number(id)-1)%3)+1}.png`;
const BUILDING_COLORS = ['#C81340','#295EA8','#16836B','#8A4FB0','#D56B22','#307D91'];
const SERVICE_BLOCK_LABELS = {maintenance:'РЕМОНТ',setup:'МОНТАЖ / ЗАСТРОЙКА',teardown:'ДЕМОНТАЖ',unavailable:'НЕДОСТУПНО'};
const isServiceBlock = item => Boolean(SERVICE_BLOCK_LABELS[item.record_kind]);
const calendarBuildingLabel = name => /пречист/i.test(name||'') ? 'Пречистенка' : String(name||'Корпус').replace(/учебный корпус/ig,'корп.').replace(/корпус №?/ig,'корп.').trim();
const PAGE_STORAGE_KEY = 'room-booking-current-page';
const allowedPagesFor = role => role==='admin' ? ['calendar','bookings','admin','analytics','rooms','profile'] : ['calendar','bookings','rooms','profile'];
const restoredPageFor = role => { const fallback='calendar'; try { const saved=localStorage.getItem(PAGE_STORAGE_KEY); return allowedPagesFor(role).includes(saved)?saved:fallback } catch { return fallback } };

export default function App() {
  const [rooms, setRooms] = useState([]); const [buildings, setBuildings] = useState([]);
  const [selectedDay, setSelectedDay] = useState(new Date()); const [selectedRoom, setSelectedRoom] = useState(null); const [modal, setModal] = useState(false);
  const [notice, setNotice] = useState('');
  const [page, setPage] = useState('calendar');
  const [user, setUser] = useState(null); const [authModal, setAuthModal] = useState(null); const [authChecked,setAuthChecked]=useState(false);
  const [calendarRefresh,setCalendarRefresh]=useState(0);
  const [userDraftRoom,setUserDraftRoom]=useState(null);const [seriesRequest,setSeriesRequest]=useState(null);
  const [roomsBuildingFilter,setRoomsBuildingFilter]=useState('');
  const [focusedBooking,setFocusedBooking]=useState(null);
  const [pendingRequests,setPendingRequests]=useState([]);const [newRequest,setNewRequest]=useState(null);const [moderationFocus,setModerationFocus]=useState(null);
  const [accountMenu,setAccountMenu]=useState(false);
  const accountMenuRef=useRef(null);const historyReadyRef=useRef(false);
  const [userEvents,setUserEvents]=useState([]);const [eventToast,setEventToast]=useState(null);const [bookingsRefresh,setBookingsRefresh]=useState(0);const lastEventRef=useRef(null);
  const pendingIdsRef=useRef(new Set());const pendingReadyRef=useRef(false);
  const loadRooms = () => api('/api/rooms').then(setRooms).catch(e=>setNotice(e.message));
  useEffect(()=>{loadRooms();api('/api/buildings').then(setBuildings).catch(e=>setNotice(e.message))},[]);
  useEffect(()=>{ api('/api/auth/me').then(data=>{setUser(data.user);csrfToken=data.csrf_token;setPage(restoredPageFor(data.user.role))}).catch(()=>{}).finally(()=>setAuthChecked(true)); },[]);
  useEffect(()=>{if(!notice)return;const timer=setTimeout(()=>setNotice(''),3800);return()=>clearTimeout(timer)},[notice]);
  useEffect(()=>{if(!user||!allowedPagesFor(user.role).includes(page))return;try{localStorage.setItem(PAGE_STORAGE_KEY,page)}catch{}},[page,user]);
  useEffect(()=>{if(!user||!allowedPagesFor(user.role).includes(page))return;if(!historyReadyRef.current){historyReadyRef.current=true;window.history.replaceState({page},'',`#${page}`)}else if(window.history.state?.page!==page)window.history.pushState({page},'',`#${page}`)},[page,user]);
  useEffect(()=>{const onPop=event=>{const target=event.state?.page;if(user&&allowedPagesFor(user.role).includes(target)){setModal(false);setPage(target)}};window.addEventListener('popstate',onPop);return()=>window.removeEventListener('popstate',onPop)},[user]);
  useEffect(()=>{delete document.documentElement.dataset.theme},[]);
  useEffect(()=>{onSessionExpired=()=>{csrfToken='';historyReadyRef.current=false;setModal(false);setUser(null);setPage('welcome');setNotice('Сессия истекла — войдите снова')};return()=>{onSessionExpired=null}},[]);
  const seenEventKey=user?`room-booking-seen-event-${user.id}`:'';
  const loadEvents=()=>{const first=lastEventRef.current===null;let stored=null;try{const raw=localStorage.getItem(seenEventKey);stored=raw===null?null:Number(raw)||0}catch{}const after=first?(stored??0):lastEventRef.current;return api(`/api/me/notifications?after=${after}`).then(items=>{const top=items.length?items[items.length-1].id:after;lastEventRef.current=top;if(first&&stored===null){try{localStorage.setItem(seenEventKey,String(top))}catch{}return}if(!items.length)return;setUserEvents(current=>[...current,...items]);if(!first){setEventToast(items[items.length-1]);playNotificationSound();setBookingsRefresh(value=>value+1);setCalendarRefresh(value=>value+1)}}).catch(()=>{})};
  useEffect(()=>{lastEventRef.current=null;setUserEvents([]);setEventToast(null);if(!user||user.role==='admin')return;loadEvents();const timer=setInterval(loadEvents,30000);return()=>clearInterval(timer)},[user?.id,user?.role]);
  useEffect(()=>{if(page!=='bookings'||!user||user.role==='admin'||lastEventRef.current===null||!userEvents.length)return;try{localStorage.setItem(seenEventKey,String(lastEventRef.current))}catch{}setUserEvents([])},[page,user?.id,userEvents.length]);
  useEffect(()=>{if(!eventToast)return;const timer=setTimeout(()=>setEventToast(null),15000);return()=>clearTimeout(timer)},[eventToast]);
  useEffect(()=>{if(!accountMenu)return;const close=event=>{if(!accountMenuRef.current?.contains(event.target))setAccountMenu(false)};document.addEventListener('pointerdown',close);return()=>document.removeEventListener('pointerdown',close)},[accountMenu]);
  const loadPending=()=>api('/api/admin/bookings').then(items=>{setPendingRequests(items);const ids=new Set(items.map(item=>item.id));if(pendingReadyRef.current){const fresh=items.filter(item=>!pendingIdsRef.current.has(item.id));if(fresh.length){const latest=fresh[fresh.length-1];setNewRequest(latest);playNotificationSound()}}else pendingReadyRef.current=true;pendingIdsRef.current=ids}).catch(()=>{});
  useEffect(()=>{if(user?.role!=='admin'){setPendingRequests([]);pendingReadyRef.current=false;pendingIdsRef.current=new Set();return}loadPending();const timer=setInterval(loadPending,10000);return()=>clearInterval(timer)},[user?.id,user?.role]);
  const openBooking = (room=null, day=null) => { if(!user){setAuthModal({intent:'user'});return}setSelectedRoom(room);setSelectedDay(day);setModal(true); };
  const openCatalogBooking = room => {setUserDraftRoom(room);setPage('bookings');setModal(false)};
  const homePage=()=>'calendar';
  const logout = async()=>{try{await api('/api/auth/logout',{method:'POST'})}catch{}finally{csrfToken='';try{localStorage.removeItem(PAGE_STORAGE_KEY)}catch{}historyReadyRef.current=false;setUserDraftRoom(null);setSeriesRequest(null);setUser(null);setPage('welcome')}};
  const signedIn=data=>{setUser(data.user);csrfToken=data.csrf_token;setPage('calendar');setAuthModal(null);loadRooms()};
  if(!authChecked) return <div className="welcome-screen"><div className="welcome-loading">Загрузка сервиса…</div></div>;
  if(!user) return <><WelcomeScreen openAuth={setAuthModal}/>{authModal&&<AuthModal intent={authModal.intent} initialRegister={authModal.register} close={()=>setAuthModal(null)} done={signedIn}/>}{notice&&<Toast message={notice} close={()=>setNotice('')}/>}</>;
  return <div className="app-shell density-comfortable">
    <nav><button className="brand" onClick={()=>setPage(homePage())}><img src="/img/logo.svg" alt="Знак академии"/><span>Бронирование аудиторий</span></button><div className="nav-links"><button className={page==='calendar'?'active':''} onClick={()=>setPage('calendar')}>Календарь</button><button className={page==='bookings'?'active':''} onClick={()=>setPage('bookings')}>Мои бронирования{userEvents.length>0&&<b className="nav-pending-count" title="Новые решения по вашим заявкам">{userEvents.length}</b>}</button>{user.role==='admin'&&<button className={page==='admin'?'active':''} onClick={()=>setPage('admin')}>Модерация{pendingRequests.length>0&&<b className="nav-pending-count">{groupSeriesItems(pendingRequests).length}</b>}</button>}<button className={page==='rooms'?'active':''} onClick={()=>{setRoomsBuildingFilter('');setPage('rooms')}}>Аудитории</button>{user.role==='admin'&&<button className={page==='analytics'?'active':''} onClick={()=>setPage('analytics')}>Аналитика</button>}<button className={page==='profile'?'active':''} onClick={()=>setPage('profile')}>Профиль</button></div><div className="nav-tools"><div className="account-menu-wrap" ref={accountMenuRef}><button className="user-strip" onClick={()=>setAccountMenu(!accountMenu)}>{user.avatar_url?<img className="nav-avatar" src={user.avatar_url} alt=""/>:<span className="nav-avatar fallback">{user.full_name?.[0]}</span>}<span><b>{user.full_name}</b><small>{user.role==='admin'?'Администратор':'Пользователь'}</small></span><ChevronDown/></button>{accountMenu&&<div className="account-menu logout-only"><button className="account-logout" onClick={logout}><LogOut/>Выйти</button></div>}</div></div></nav>
    <main>
      {page === 'calendar' && <AdminCalendar buildings={buildings} openBooking={openBooking} openBookingDetails={item=>{setFocusedBooking({id:item.id,token:Date.now()});setPage('bookings')}} refreshKey={calendarRefresh} goToRooms={buildingId=>{setRoomsBuildingFilter(String(buildingId||''));setPage('rooms')}} isAdmin={user.role==='admin'} currentUserId={user.id} notice={setNotice}/>} 
      {page === 'rooms' && <RoomsPage rooms={rooms} buildings={buildings} openBooking={user.role==='admin'?openCatalogBooking:openBooking} initialBuilding={roomsBuildingFilter}/>} 
      <div style={{display:page==='bookings'?'contents':'none'}}><MyBookingsPage key={user.id} refreshKey={bookingsRefresh} active={page==='bookings'} seriesRequest={seriesRequest} clearSeriesRequest={()=>setSeriesRequest(null)} notice={setNotice} user={user} rooms={rooms} buildings={buildings} focusedBooking={focusedBooking} initialRoom={userDraftRoom} clearInitialRoom={()=>setUserDraftRoom(null)} goToRooms={()=>setPage('rooms')} onChanged={()=>{setCalendarRefresh(x=>x+1);loadRooms()}}/></div>
      {page === 'admin' && user?.role==='admin' && <AdminPage notice={setNotice} items={pendingRequests} buildings={buildings} focusId={moderationFocus} refresh={loadPending}/>}
      {page === 'analytics' && user?.role==='admin' && <AnalyticsPage request={api} notice={setNotice}/>} 
      {page === 'profile' && <ProfilePage user={user} logout={logout} onUpdate={setUser} notice={setNotice}/>} 
    </main>{modal&&<PhoneBookingWizard initial={{date:selectedDay?iso(selectedDay):'',preferred_room:selectedRoom?(rooms.find(r=>r.id===selectedRoom.id)||selectedRoom):null,preferred_room_id:selectedRoom?.id,building_id:selectedRoom?.building_id,fixed_room:Boolean(selectedRoom)}} rooms={rooms} buildings={buildings} request={api} user={user} onSeries={room=>{setModal(false);if(user.role!=='admin')setUserDraftRoom(room);setSeriesRequest({room,token:Date.now()});setPage('bookings')}} close={()=>setModal(false)} done={message=>{setModal(false);setNotice(message||(user.role==='admin'?'Бронирование подтверждено':'Заявка отправлена на модерацию'));setCalendarRefresh(x=>x+1);loadRooms()}}/>}{newRequest&&<button className="new-request-toast" onClick={()=>{setModerationFocus(newRequest.id);setPage('admin');setNewRequest(null)}}><ShieldCheck/><span><small>НОВАЯ ЗАЯВКА НА РАССМОТРЕНИЕ</small><b>{newRequest.title}</b><em>{newRequest.building} · аудитория {newRequest.room_number}</em></span><ChevronRight/></button>}{eventToast&&<button className="new-request-toast" onClick={()=>{setFocusedBooking({id:eventToast.booking_id,token:Date.now()});setPage('bookings');setEventToast(null)}}><ShieldCheck/><span><small>{EVENT_TOAST_LABELS[eventToast.type]||'ИЗМЕНЕНИЕ ПО ВАШЕЙ ЗАЯВКЕ'}</small><b>{eventToast.title}</b><em>{eventToast.building} · аудитория {eventToast.room_number}{eventToast.series_count>1?` · серия, дат: ${eventToast.series_count}`:''}{eventToast.reason?` · ${eventToast.reason}`:''}</em></span><ChevronRight/></button>}{notice&&<Toast message={notice} close={()=>setNotice('')}/>} 
  </div>
}

const EVENT_TOAST_LABELS={approved:'ВАША ЗАЯВКА ПОДТВЕРЖДЕНА',rejected:'ВАША ЗАЯВКА ОТКЛОНЕНА',expired:'ЗАЯВКА НЕ РАССМОТРЕНА ДО НАЧАЛА МЕРОПРИЯТИЯ',cancelled_by_admin:'БРОНЬ ОТМЕНЕНА АДМИНИСТРАТОРОМ',transferred:'БРОНЬ ПЕРЕНЕСЕНА АДМИНИСТРАТОРОМ',updated:'БРОНЬ ИЗМЕНЕНА АДМИНИСТРАТОРОМ'};

function Toast({message,close}){const tone=noticeTone(message);const Icon=tone==='success'?CheckCircle2:tone==='error'?AlertCircle:Info;return <button className={`toast ${tone}`} onClick={close}><Icon/><span>{message}</span><X size={15}/><i/></button>}

function noticeTone(message){const text=String(message).toLowerCase();if(/ошиб|не удалось|невер|отклон|запрещ|конфликт|истекл|нельзя|занят|вмещает/.test(text))return'error';if(/сохран|создан|подтверж|одобрен|обновлен|обновлён|успеш/.test(text))return'success';return'info'}
function playNotificationSound(){try{const AudioContext=window.AudioContext||window.webkitAudioContext;const context=new AudioContext();const gain=context.createGain();gain.connect(context.destination);gain.gain.setValueAtTime(.0001,context.currentTime);gain.gain.exponentialRampToValueAtTime(.16,context.currentTime+.02);gain.gain.exponentialRampToValueAtTime(.0001,context.currentTime+.5);[660,880].forEach((frequency,index)=>{const oscillator=context.createOscillator();oscillator.type='sine';oscillator.frequency.value=frequency;oscillator.connect(gain);oscillator.start(context.currentTime+index*.12);oscillator.stop(context.currentTime+.22+index*.12)});setTimeout(()=>context.close(),800)}catch{}}

function AdminCalendar({buildings,openBooking,openBookingDetails,refreshKey,goToRooms,isAdmin=true,currentUserId,notice}) {
  const [view,setView]=useState(()=>{try{return localStorage.getItem('calendar-operational-view')||'week'}catch{return'week'}}); const [cursor,setCursor]=useState(new Date());
  const [rooms,setRooms]=useState([]); const [bookings,setBookings]=useState([]); const [selectedDay,setSelectedDay]=useState(new Date());
  const [selectedGridRoom,setSelectedGridRoom]=useState(null); const [roomDetail,setRoomDetail]=useState(null); const [scheduleCell,setScheduleCell]=useState(null);
  const [search,setSearch]=useState(''); const [buildingIds,setBuildingIds]=useState([]);
  const [types,setTypes]=useState([]); const [capacity,setCapacity]=useState(''); const [equipment,setEquipment]=useState([]);
  const [openFilter,setOpenFilter]=useState(null);
  const range=useMemo(()=>calendarRange(view,cursor),[view,cursor]);
  useEffect(()=>{let active=true;api('/api/rooms').then(items=>active&&setRooms(items)).catch(error=>notice(error.message));return()=>{active=false}},[notice]);
  useEffect(()=>{let active=true;api(`/api/bookings?date_from=${iso(range.from)}&date_to=${iso(range.to)}`).then(items=>{if(active)setBookings(items.filter(item=>item.status==='approved'||item.status==='completed'||isServiceBlock(item)))}).catch(error=>notice(error.message));return()=>{active=false}},[range.from.getTime(),range.to.getTime(),refreshKey,isAdmin,notice]);
  useEffect(()=>{const close=event=>{if(!event.target.closest('.multi-filter'))setOpenFilter(null)};document.addEventListener('pointerdown',close);return()=>document.removeEventListener('pointerdown',close)},[]);
  useEffect(()=>{try{localStorage.setItem('calendar-operational-view',view)}catch{}},[view]);
  const equipmentByRoom=useMemo(()=>new Map(rooms.map(room=>[room.id,roomEquipmentCategories(room)])),[rooms]);
  const equipmentOptions=useMemo(()=>[...new Set([...equipmentByRoom.values()].flat())].sort((a,b)=>a.localeCompare(b,'ru')),[equipmentByRoom]);
  const normalizedSearch=search.toLowerCase().replace(/аудитория|ауд\.?/g,'').trim();
  const filtered=rooms.filter(r=>(!normalizedSearch||`${r.number} ${r.name} ${r.building}`.toLowerCase().includes(normalizedSearch))&&(!buildingIds.length||buildingIds.includes(String(r.building_id)))&&(!types.length||types.includes(r.type))&&(!capacity||r.capacity>=Number(capacity))&&(!equipment.length||equipment.every(x=>(equipmentByRoom.get(r.id)||[]).includes(x))));
  const activeFilterCount=buildingIds.length+types.length+equipment.length+(capacity?1:0);
  const sidebarGroups=buildings.map(b=>({building:b,rooms:rooms.filter(r=>r.building_id===b.id)})).filter(x=>x.rooms.length);
  const bookingsByDate=useMemo(()=>{const grouped=new Map();for(const booking of bookings){if(!grouped.has(booking.date))grouped.set(booking.date,[]);grouped.get(booking.date).push(booking)}for(const items of grouped.values())items.sort(compareBookingTime);return grouped},[bookings]);
  const agenda=selectedGridRoom?(bookingsByDate.get(iso(selectedDay))||[]).filter(item=>item.room_id===selectedGridRoom.id):[];
  const move=amount=>setCursor(view==='month'?new Date(cursor.getFullYear(),cursor.getMonth()+amount,1):addDays(cursor,amount*(view==='week'?7:1)));
  const reset=()=>{setSearch('');setBuildingIds([]);setTypes([]);setCapacity('');setEquipment([])};
  return <section className="admin-calendar-page">
    <div className="calendar-intro"><div><h1>{isAdmin?'УПРАВЛЕНИЕ ПРОСТРАНСТВАМИ':'КАЛЕНДАРЬ ЗАГРУЖЕННОСТИ'}</h1><p>{isAdmin?'Найдите нужную аудиторию и забронируйте её за пару минут.':'Посмотрите расписание аудиторий, выберите свободное время и отправьте заявку администратору.'}</p></div><button className="primary calendar-top-booking" onClick={()=>openBooking(null,null)}><Plus/>{isAdmin?'Бронирование':'Отправить заявку'}</button></div>
    <div className="calendar-filter-shell"><div className="calendar-primary-search"><label className="search-filter-label"><span><b>Быстрый поиск по номеру аудитории</b><small></small></span><div className="filter-search-wide"><Search/><input value={search} onChange={e=>setSearch(e.target.value)} placeholder="Например: 2254 или 104" autoComplete="off"/>{search&&<button type="button" aria-label="Очистить поиск" onClick={()=>setSearch('')}><X/></button>}</div></label><div className="calendar-search-result"><strong>{filtered.length}</strong><span>{filtered.length===1?'аудитория найдена':filtered.length>1&&filtered.length<5?'аудитории найдено':'аудиторий найдено'}</span>{normalizedSearch&&<small>по запросу «{search}»</small>}</div></div><div className="calendar-filter-heading"><span><b>Уточнить параметры</b></span>{activeFilterCount>0&&<em>Выбрано параметров: {activeFilterCount}</em>}</div><div className="filter-row-v2">
      <MultiFilter id="buildings" openId={openFilter} setOpenId={setOpenFilter} label="Корпуса" options={buildings.map(b=>({value:String(b.id),label:b.name}))} value={buildingIds} setValue={setBuildingIds}/>
      <MultiFilter id="types" openId={openFilter} setOpenId={setOpenFilter} label="Тип аудитории" options={Object.entries(ROOM_TYPES).map(([value,label])=>({value,label}))} value={types} setValue={setTypes}/>
      <label className="single-filter"><span>Вместимость</span><select value={capacity} onChange={e=>setCapacity(e.target.value)}><option value="">Любая</option><option value="10">от 10 мест</option><option value="25">от 25 мест</option><option value="50">от 50 мест</option><option value="100">от 100 мест</option></select></label>
      <MultiFilter id="equipment" openId={openFilter} setOpenId={setOpenFilter} label="Техническое оснащение" options={equipmentOptions.map(x=>({value:x,label:x}))} value={equipment} setValue={setEquipment}/>
      <label className="single-filter calendar-view-filter"><span>Вид календаря</span><select value={view} onChange={event=>setView(event.target.value)}><option value="month">Месяц</option><option value="week">Неделя</option><option value="day">День</option></select></label>
      <button className="reset-filters" onClick={reset} disabled={!search&&!activeFilterCount}><RotateCcw/>Сбросить всё</button>
    </div></div>
    <div className="admin-calendar-workspace">
      <aside className="rooms-browser"><header className="rooms-browser-heading"><h3>Корпуса <span>{filtered.length}</span></h3>{buildingIds.length>0&&<button onClick={()=>setBuildingIds([])}>Показать все</button>}</header>{sidebarGroups.map(({building,rooms:items})=>{const active=buildingIds.length===1&&buildingIds[0]===String(building.id);return <section className={`building-room-group corpus-only ${active?'active':''}`} style={{'--building-color':building.color||'#c81340'}} key={building.id}><div className="building-group-head"><button className="building-group-title" onClick={()=>setBuildingIds(active?[]:[String(building.id)])}><img src={building.image||buildingPhoto(building.id)} alt=""/><span className="building-title-info"><span>{building.name}<small>{items.length} аудиторий</small>{active&&<em>ВЫБРАННЫЙ КОРПУС</em>}</span>{active?<CheckCircle2/>:<Building2/>}</span></button><button className="building-all-rooms" onClick={()=>goToRooms(building.id)}>Все аудитории</button></div></section>})}</aside>
      <OperationalCalendarGrid view={view} cursor={cursor} setCursor={setCursor} move={move} rooms={filtered} bookings={bookings} selectedDay={selectedDay} setSelectedDay={setSelectedDay} selectedRoom={selectedGridRoom} setSelectedRoom={setSelectedGridRoom} openRoom={setRoomDetail} openBooking={openBooking} openSchedule={(room,day,items)=>setScheduleCell({room,day,items})} isAdmin={isAdmin}/>
    </div>
    {roomDetail&&<RoomDetailModal room={roomDetail} close={()=>setRoomDetail(null)}/>} 
    {scheduleCell&&<DayCellScheduleModal {...scheduleCell} isAdmin={isAdmin} close={()=>setScheduleCell(null)} addBooking={()=>{setScheduleCell(null);openBooking(scheduleCell.room,scheduleCell.day)}}/>}
  </section>
}

function OperationalCalendarGrid({view,cursor,setCursor,move,rooms,bookings,selectedDay,setSelectedDay,selectedRoom,setSelectedRoom,openRoom,openBooking,openSchedule,isAdmin}) {
  const displayDays=useMemo(()=>view==='month'?Array.from({length:new Date(cursor.getFullYear(),cursor.getMonth()+1,0).getDate()},(_,index)=>new Date(cursor.getFullYear(),cursor.getMonth(),index+1)):calendarDays(view,cursor),[view,cursor]);
  const dayColumnWidth=view==='day'?320:view==='week'?150:128;
  const columns=`180px repeat(${displayDays.length}, minmax(${dayColumnWidth}px, 1fr))`;
  const byCell=useMemo(()=>{const map=new Map();for(const item of bookings){const key=`${item.room_id}:${item.date}`;if(!map.has(key))map.set(key,[]);map.get(key).push(item)}for(const list of map.values())list.sort(compareBookingTime);return map},[bookings]);
  return <section className={`calendar-operations-shell ${view}`}>
    <div className="calendar-toolbar-v2"><h2>{calendarHeading(view,cursor)}</h2><div className="calendar-nav-v2"><button onClick={()=>move(-1)} aria-label="Назад"><ChevronLeft/></button><button onClick={()=>setCursor(new Date())}>Сегодня</button><button onClick={()=>move(1)} aria-label="Вперёд"><ChevronRight/></button></div></div>
    <div className="calendar-operations-scroll">
      <div className="calendar-operations-table" style={{'--operations-columns':columns}}>
        <div className="calendar-operations-head"><b>Аудитория</b>{displayDays.map(day=>{const dayKey=iso(day);return <button className={`${[0,6].includes(day.getDay())?'weekend ':''}${dayKey===iso(new Date())?'today':''}`} key={dayKey} onClick={()=>setSelectedDay(day)}><span>{RU_WEEKDAYS_SHORT[(day.getDay()+6)%7]}</span><strong>{day.getDate()}</strong><small>{RU_MONTHS[day.getMonth()].slice(0,3).toLowerCase()}</small></button>})}</div>
        {rooms.length?rooms.map(room=><div className={`calendar-operations-row ${selectedRoom?.id===room.id?'is-selected-room':''}`} key={room.id}><button className="calendar-operations-room" onClick={()=>openRoom(room)} title="Открыть карточку аудитории"><img src={room.images?.[0]||roomPhoto(room.id)} alt=""/><span><b>Ауд. {room.number}</b><small>{calendarBuildingLabel(room.building)}</small><em>{room.capacity} мест · открыть карточку</em></span></button>{displayDays.map(day=>{const dayKey=iso(day);const selected=selectedRoom?.id===room.id&&dayKey===iso(selectedDay);const records=byCell.get(`${room.id}:${dayKey}`)||[];const visibleRecords=records.slice(0,3);return <div className={`${[0,6].includes(day.getDay())?'weekend ':''}${dayKey===iso(new Date())?'today ':''}${selected?'selected-cell':''}`} key={dayKey} onClick={()=>{setSelectedDay(day);setSelectedRoom(room);openSchedule(room,day,records)}}><div className="calendar-operations-records">{visibleRecords.map(item=><button className={`calendar-operation-booking ${item.status==='pending'?'pending-request':''} ${isServiceBlock(item)?`service-block ${item.record_kind}`:''}`} style={{'--booking-color':item.color||BUILDING_COLORS[(Number(item.building_id||1)-1)%BUILDING_COLORS.length]}} title={`${item.time_start}–${item.time_end} · ${item.title}`} onClick={event=>{event.stopPropagation();setSelectedDay(day);setSelectedRoom(room);openSchedule(room,day,records)}} key={item.id}><b>{item.time_start}–{item.time_end}</b><span>{isServiceBlock(item)?`${SERVICE_BLOCK_LABELS[item.record_kind]} · ${item.title}`:item.title}</span></button>)}{records.length>3&&<button className="calendar-operation-more" onClick={event=>{event.stopPropagation();setSelectedDay(day);setSelectedRoom(room);openSchedule(room,day,records)}}>Ещё {records.length-3}</button>}</div><button className="calendar-operation-add" title={`Оформить бронь: аудитория ${room.number}, ${day.toLocaleDateString('ru-RU')}`} onClick={event=>{event.stopPropagation();setSelectedDay(day);setSelectedRoom(room);openBooking(room,day)}}><Plus/></button></div>})}</div>):<div className="calendar-operations-empty"><Search/><b>По выбранным фильтрам аудиторий нет</b><span>Измените корпус, тип, вместимость или оснащение.</span></div>}
      </div>
    </div>
  </section>
}

function DayCellScheduleModal({room,day,items,isAdmin,close,addBooking}) {
  const ordered=[...items].sort(compareBookingTime);
  return <div className="day-schedule-overlay"><button className="day-schedule-backdrop" onClick={close}/><section className="day-schedule-modal"><header><div><small>РАСПИСАНИЕ НА ДЕНЬ</small><h2>{day.toLocaleDateString('ru-RU',{weekday:'long',day:'numeric',month:'long',year:'numeric'})}</h2><p><b>Аудитория {room.number}</b> · {room.building}</p></div><button className="icon" onClick={close} aria-label="Закрыть"><X/></button></header><div className="day-schedule-summary"><span><CalendarDays/><b>{ordered.length}</b>{ordered.length===1?'запись':ordered.length>1&&ordered.length<5?'записи':'записей'}</span><span><Clock3/><b>{ordered.length?`${ordered[0].time_start}–${ordered.at(-1).time_end}`:'Свободна весь день'}</b></span></div><div className="day-schedule-timeline">{ordered.length?ordered.map(item=><article className={`${isServiceBlock(item)?`service-block ${item.record_kind}`:''} ${item.status==='pending'?'pending-request':''}`} style={{'--booking-color':item.color||'#c81340'}} key={item.id}><time><b>{item.time_start}</b><span>{item.time_end}</span></time><i/><div>{isServiceBlock(item)&&<em>{SERVICE_BLOCK_LABELS[item.record_kind]}</em>}<h3>{item.title}</h3><p>{room.building} · Ауд. {room.number}</p><dl><div><dt>Ответственный</dt><dd>{item.owner_name||item.booked_by||'Не указан'}</dd></div><div><dt>Подразделение</dt><dd>{item.department_name||item.department_code||'Не указано'}</dd></div><div><dt>Контакт</dt><dd>{item.customer_contact||'Не указан'}</dd></div></dl></div></article>):<div className="day-schedule-empty"><CalendarCheck/><b>Аудитория свободна</b><span>На выбранный день бронирований и блокировок нет.</span></div>}</div><footer><button className="secondary" onClick={close}>Закрыть</button><button className="primary" onClick={addBooking}><Plus/>{isAdmin?'Добавить бронирование':'Отправить заявку'}</button></footer></section></div>
}

function MultiFilter({id,label,options,value,setValue,openId,setOpenId}) { const [localOpen,setLocalOpen]=useState(false);const root=useRef(null);const controlled=typeof setOpenId==='function';const open=controlled?openId===id:localOpen;const changeOpen=next=>controlled?setOpenId(next?id:null):setLocalOpen(next);const toggle=item=>setValue(value.includes(item)?value.filter(x=>x!==item):[...value,item]);useEffect(()=>{if(controlled)return;const close=event=>{if(!root.current?.contains(event.target))setLocalOpen(false)};document.addEventListener('pointerdown',close);return()=>document.removeEventListener('pointerdown',close)},[controlled]);return <label className="multi-filter-wrap" ref={root}><span>{label}</span><details className="multi-filter" open={open} onToggle={event=>{if(event.currentTarget.open!==open)changeOpen(event.currentTarget.open)}}><summary>{value.length?`Выбрано: ${value.length}`:'Выберите'}{value.length>0&&<b>{value.length}</b>}<ChevronDown/></summary><div>{options.length?options.map(o=><label key={o.value}><input type="checkbox" checked={value.includes(o.value)} onChange={()=>toggle(o.value)}/><span>{o.label}</span></label>):<small>Нет вариантов</small>}</div></details></label> }

function AgendaPanel({day,room,items,addBooking,openBookingDetails,isAdmin,currentUserId}) { const [open,setOpen]=useState(null);const formattedCreated=value=>value?new Date(value).toLocaleString('ru-RU',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit',hour12:false}):'Не указано';return <aside className="agenda-panel-v2"><header><small>БРОНИРОВАНИЯ И БЛОКИРОВКИ</small><h3>{day.toLocaleDateString('ru-RU',{day:'numeric',month:'long',year:'numeric'})}</h3>{room?<><b className="agenda-selected-room">Ауд. {room.number}</b><em>{room.building}</em><span>{items.length} записей</span><button className="primary agenda-add-booking" onClick={addBooking}><Plus/>{isAdmin?'Добавить бронирование':'Отправить заявку'}</button></>:<span>Нажмите на ячейку «день — аудитория»</span>}</header>{!room?<div className="agenda-empty"><CalendarDays/><b>Выберите аудиторию и день</b><span>Здесь появится её полное расписание на выбранную дату.</span></div>:items.length?items.map(item=>{const canNavigate=isAdmin||item.owner_id===currentUserId;return <article key={item.id} className={`agenda-booking ${item.status==='pending'?'pending-request':''} ${isServiceBlock(item)?`service-block ${item.record_kind}`:''}`}><button onClick={()=>canNavigate?openBookingDetails(item):setOpen(open===item.id?null:item.id)}>{isServiceBlock(item)&&<em className="service-block-label"><Wrench/>{SERVICE_BLOCK_LABELS[item.record_kind]}</em>}<time>{item.time_start}–{item.time_end}</time><h4>{item.title}</h4><strong>{item.building} · Ауд. {item.room_number}</strong><i style={{background:isServiceBlock(item)?'var(--service-color)':item.color||BUILDING_COLORS[(Number(item.building_id||1)-1)%BUILDING_COLORS.length]}}>{item.building}</i>{item.owner_name||item.booked_by?<p>Забронировал: <b>{item.owner_name||item.booked_by}</b></p>:null}<p>Оформлено: <b>{formattedCreated(item.created_at)}</b></p><p>Подразделение: <b>{item.department_name||item.department_code||'Не указано'}</b></p><p>Телефон / контакт: <b>{item.customer_contact||'Не указан'}</b></p>{item.status==='pending'&&<p className="calendar-pending-note">Заявка ожидает решения администратора</p>}<span>{canNavigate?'Открыть на странице бронирований':'Подробнее'} {canNavigate?<ChevronRight/>:<ChevronDown className={open===item.id?'open':''}/>}</span></button>{open===item.id&&!canNavigate&&<div className="agenda-more">{isServiceBlock(item)&&<p><b>ВИД БЛОКИРОВКИ:</b> {SERVICE_BLOCK_LABELS[item.record_kind]}</p>}<p><b>Тип:</b> {BOOKING_TYPE_LABELS[item.booking_type]||item.booking_type}</p>{item.teacher&&<p><b>Преподаватель:</b> {item.teacher}</p>}{item.group_name&&<p><b>Группа:</b> {item.group_name}</p>}</div>}</article>}):<div className="agenda-empty"><CalendarDays/><b>Аудитория свободна весь день</b><span>{isAdmin?'Нажмите кнопку выше, чтобы создать новую бронь.':'Можно выбрать свободное время и отправить заявку администратору.'}</span></div>}</aside> }

function calendarRange(view,cursor) { if(view==='month'){const days=calendarDays('month',cursor);return {from:days[0],to:days[days.length-1]}} if(view==='week'){const from=startOfWeek(cursor);return {from,to:addDays(from,6)}} return {from:new Date(cursor.getFullYear(),cursor.getMonth(),cursor.getDate()),to:new Date(cursor.getFullYear(),cursor.getMonth(),cursor.getDate())} }
function compareBookingTime(a,b) { return String(a.time_start||'').localeCompare(String(b.time_start||''))||String(a.time_end||'').localeCompare(String(b.time_end||''))||Number(a.id||0)-Number(b.id||0) }
function calendarDays(view,cursor) { if(view==='day') return [new Date(cursor)]; if(view==='week'){const first=startOfWeek(cursor);return Array.from({length:7},(_,i)=>addDays(first,i))} const first=new Date(cursor.getFullYear(),cursor.getMonth(),1);const start=startOfWeek(first);const last=new Date(cursor.getFullYear(),cursor.getMonth()+1,0);const count=Math.ceil((((last-start)/86400000)+1)/7)*7;return Array.from({length:count},(_,i)=>addDays(start,i)) }
function calendarHeading(view,cursor) { if(view==='month') return monthTitle(cursor); if(view==='day') return `${cursor.getDate()} ${RU_MONTHS_GEN[cursor.getMonth()]} ${cursor.getFullYear()}`;const first=startOfWeek(cursor),last=addDays(first,6);return first.getMonth()===last.getMonth()?`${first.getDate()} — ${last.getDate()} ${RU_MONTHS_GEN[last.getMonth()]} ${last.getFullYear()}`:`${first.getDate()} ${RU_MONTHS_GEN[first.getMonth()]} — ${last.getDate()} ${RU_MONTHS_GEN[last.getMonth()]} ${last.getFullYear()}` }
function calendarWeekdayHeaders(view,days) { if(view==='day') return [days[0]]; if(view==='week') return days.slice(0,7); const monday=startOfWeek(new Date(2026,0,5)); return Array.from({length:7},(_,i)=>addDays(monday,i)) }

function WelcomeScreen({openAuth}) {
  return <main className="welcome-screen"><div className="welcome-shape one"/><div className="welcome-shape two"/><div className="welcome-shape three"/><div className="welcome-shape four"/><section className="welcome-card"><img src="/img/logo.svg" alt="Логотип сервиса"/><p className="welcome-kicker">СЕРВИС УПРАВЛЕНИЯ АУДИТОРИЯМИ</p><h1>Бронирование аудиторий</h1><p className="welcome-copy">Выберите подходящую аудиторию, отправьте заявку и следите за её статусом в личном кабинете.</p><div className="welcome-actions"><button className="role-button user-role" onClick={()=>openAuth({intent:'user'})}><Users size={20}/><span>Войти как<strong>пользователь</strong></span></button><button className="role-button admin-role" onClick={()=>openAuth({intent:'admin'})}><ShieldCheck size={20}/><span>Войти как<strong>администратор</strong></span></button></div><button className="welcome-register" onClick={()=>openAuth({intent:'user',register:true})}>Впервые в сервисе? Зарегистрироваться</button><div className="welcome-features"><span><b><School/></b>Выбор аудиторий</span><span><b><CalendarCheck/></b>Бронирование</span><span><b><ShieldCheck/></b>Управление заявками</span></div></section></main>
}

function ProfilePage({user,logout,onUpdate,notice}) {
  const [savedFields,setSavedFields]=useState([]);const [justSaved,setJustSaved]=useState(false);const [saving,setSaving]=useState(false);const [photoSaved,setPhotoSaved]=useState('');
  useEffect(()=>{if(!justSaved)return;const timer=setTimeout(()=>setJustSaved(false),4000);return()=>clearTimeout(timer)},[justSaved]);
  useEffect(()=>{if(!photoSaved)return;const timer=setTimeout(()=>setPhotoSaved(''),4000);return()=>clearTimeout(timer)},[photoSaved]);
  const save=async e=>{e.preventDefault();const values=Object.fromEntries(new FormData(e.currentTarget));const changed=Object.keys(values).filter(key=>String(values[key]||'').trim()!==String(user[key]||'').trim());if(!changed.length){notice('Вы ничего не изменили — данные уже актуальны');return}setSaving(true);try{const data=await api('/api/profile',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(values)});onUpdate(data.user);setSavedFields(changed);setJustSaved(true);notice('Изменения сохранены')}catch(err){notice(err.message)}finally{setSaving(false)}};
  const edited=event=>{const name=event.target.name;setJustSaved(false);setSavedFields(current=>current.filter(item=>item!==name))};
  const savedMark=name=>savedFields.includes(name)&&<em className="profile-saved-mark"><CheckCircle2/>Сохранено</em>;
  const avatar=async e=>{const file=e.target.files?.[0];if(!file)return;try{const data=await api('/api/profile/avatar',{method:'POST',headers:{'Content-Type':file.type},body:file});onUpdate(data.user);setPhotoSaved('Фото обновлено');notice('Фото профиля обновлено')}catch(err){notice(err.message)}e.target.value=''};
  const remove=async()=>{try{const data=await api('/api/profile/avatar',{method:'DELETE'});onUpdate(data.user);setPhotoSaved('Фото удалено');notice('Фото удалено')}catch(err){notice(err.message)}};
  const initials=user.full_name.split(' ').map(x=>x[0]).slice(0,2).join('').toUpperCase();
  const roleLabel=user.role==='admin'?'Администратор':'Пользователь';
  const checklist=[['full_name','ФИО',user.full_name],['position','Должность',user.position],['phone','Телефон',user.phone],['department','Подразделение',user.department],['avatar','Фото профиля',user.avatar_url]];
  const completion=Math.round(checklist.filter(([, ,value])=>Boolean(value)).length/checklist.length*100);
  const focusField=name=>name==='avatar'?document.getElementById('profile-avatar-input')?.click():document.querySelector(`.pv3-form [name="${name}"]`)?.focus();
  const ring=2*Math.PI*34;
  return <section className="content-page profile-v3">
    <div className="pv3-hero"><i className="pv3-shape a"/><i className="pv3-shape b"/><i className="pv3-shape c"/>
      <label className="pv3-avatar" title="Изменить фото">{user.avatar_url?<img src={user.avatar_url} alt="Фото профиля"/>:<span>{initials}</span>}<em><Camera/>Изменить</em><input id="profile-avatar-input" type="file" accept="image/jpeg,image/png,image/webp" onChange={avatar}/>{photoSaved&&<b className="profile-photo-saved"><CheckCircle2/></b>}</label>
      <div className="pv3-identity"><small>ЛИЧНЫЙ ПРОФИЛЬ</small><h1>{user.full_name}</h1><div className="pv3-chips"><span><ShieldCheck/>{roleLabel}</span>{user.position&&<span><Briefcase/>{user.position}</span>}{user.department&&<span><Building2/>{user.department}</span>}</div><p><Mail/>{user.email}</p></div>
      <div className="pv3-ring" role="img" aria-label={`Профиль заполнен на ${completion}%`}><svg viewBox="0 0 80 80"><circle cx="40" cy="40" r="34"/><circle className="value" cx="40" cy="40" r="34" strokeDasharray={`${ring*completion/100} ${ring}`}/></svg><b>{completion}%</b><small>{completion===100?'профиль заполнен':'заполнено'}</small></div>
    </div>
    <div className="pv3-layout">
      <form className="pv3-card pv3-form" onSubmit={save} onInput={edited}>
        <header><h2>Основная информация</h2></header>
        <div className="pv3-fields">
          <label className={`pv3-field full ${savedFields.includes('full_name')?'saved':''}`}><span>ФИО{savedMark('full_name')}</span><div><UserRound/><input name="full_name" defaultValue={user.full_name} placeholder="Иванов Иван Иванович" required/></div><small>ФИО используется как имя ответственного лица во всех созданных вами бронированиях.</small></label>
          <label className={`pv3-field ${savedFields.includes('position')?'saved':''}`}><span>Должность{savedMark('position')}</span><div><Briefcase/><input name="position" defaultValue={user.position||''} placeholder="Например, менеджер"/></div></label>
          <label className={`pv3-field ${savedFields.includes('phone')?'saved':''}`}><span>Телефон{savedMark('phone')}</span><div><Phone/><input name="phone" type="tel" defaultValue={user.phone||''} placeholder="+7 999 000-00-00"/></div></label>
          <label className={`pv3-field full ${savedFields.includes('department')?'saved':''}`}><span>Подразделение / кафедра{savedMark('department')}</span><div><Building2/><input name="department" defaultValue={user.department||''} placeholder="Название подразделения"/></div></label>
          <label className="pv3-field readonly"><span>Email</span><div><Mail/><input value={user.email} readOnly tabIndex={-1}/><Lock className="lock"/></div></label>
          <label className="pv3-field readonly"><span>Роль</span><div><ShieldCheck/><input value={roleLabel} readOnly tabIndex={-1}/><Lock className="lock"/></div></label>
        </div>
        <footer><small><Lock/>Email и роль изменить нельзя.</small><button className={`primary profile-save-button ${justSaved?'saved':''}`} disabled={saving}>{saving?'Сохраняем…':justSaved?<><CheckCircle2/>Изменения сохранены</>:'Сохранить изменения'}</button></footer>
      </form>
      <aside className="pv3-side">
        <div className="pv3-card"><h2>{completion===100?'Профиль заполнен':'Что ещё заполнить'}</h2><ul className="pv3-checklist">{checklist.map(([name,label,value])=><li className={value?'done':''} key={name}>{value?<CheckCircle2/>:<Circle/>}<span>{label}</span>{!value&&<button type="button" onClick={()=>focusField(name)}>Заполнить</button>}</li>)}</ul></div>
        <div className="pv3-card"><h2>Фото профиля{photoSaved&&<em className="profile-saved-mark"><CheckCircle2/>{photoSaved}</em>}</h2><p>JPG, PNG или WEBP, размером до 5 МБ.</p><label className="secondary profile-upload-button"><Upload/>Загрузить фото<input type="file" accept="image/jpeg,image/png,image/webp" onChange={avatar}/></label>{user.avatar_url&&<button className="danger-link" onClick={remove}>Удалить фотографию</button>}</div>
        <div className="pv3-card"><h2>Аккаунт</h2><dl className="pv3-account"><div><dt>Дата регистрации</dt><dd>{user.created_at?new Date(user.created_at).toLocaleDateString('ru-RU',{day:'numeric',month:'long',year:'numeric'}).replace(/\s*г\.$/,''):'—'}</dd></div><div><dt>Роль</dt><dd>{roleLabel}</dd></div></dl><button className="secondary pv3-logout" onClick={logout}><LogOut/>Выйти из аккаунта</button></div>
      </aside>
    </div>
  </section>
}

function RoomsPage({rooms,buildings,openBooking,initialBuilding=''}) {
  const [search,setSearch]=useState(''); const [building,setBuilding]=useState(''); const [type,setType]=useState(''); const [capacity,setCapacity]=useState(''); const [equipment,setEquipment]=useState([]); const [detail,setDetail]=useState(null); const [openBuilding,setOpenBuilding]=useState('all'); const [view,setView]=useState('grid');
  // null = the live state is unknown (not loaded yet or the request failed): no tag is better than a wrong "free".
  const [occupancy,setOccupancy]=useState(null);
  const liveStatus=room=>{if(!occupancy)return null;const state=occupancy[String(room.id)];if(state?.occupied)return {tone:'is-occupied',label:`${state.kind&&state.kind!=='booking'?'Недоступна':'Занята'} до ${state.until}`};return {tone:'is-free',label:state?.free_until?`Свободна до ${state.free_until}`:'Свободна сейчас'}};
  const [compare,setCompare]=useState([]);const [showCompare,setShowCompare]=useState(false);
  useEffect(()=>{if(!initialBuilding)return;setBuilding(String(initialBuilding));setOpenBuilding(Number(initialBuilding));window.setTimeout(()=>document.getElementById(`catalog-building-${initialBuilding}`)?.scrollIntoView({behavior:'smooth',block:'start'}),120)},[initialBuilding]);
  useEffect(()=>{let active=true;const loadOccupancy=()=>api('/api/rooms/occupancy').then(data=>active&&setOccupancy(data)).catch(()=>active&&setOccupancy(null));const onVisible=()=>{if(!document.hidden)loadOccupancy()};loadOccupancy();const timer=setInterval(loadOccupancy,30000);document.addEventListener('visibilitychange',onVisible);window.addEventListener('focus',onVisible);return()=>{active=false;clearInterval(timer);document.removeEventListener('visibilitychange',onVisible);window.removeEventListener('focus',onVisible)}},[]);
  useEffect(()=>{if(!building&&openBuilding===null)setOpenBuilding('all')},[building,openBuilding]);
  const matches=(r,exclude='')=>(exclude==='search'||!search||`${r.number} ${r.name} ${r.description} ${r.building} ${(r.equipment||[]).join(' ')}`.toLowerCase().includes(search.toLowerCase()))&&(exclude==='building'||!building||String(r.building_id)===building)&&(exclude==='type'||!type||r.type===type)&&(exclude==='capacity'||!capacity||r.capacity>=Number(capacity))&&(exclude==='equipment'||!equipment.length||equipment.every(x=>roomEquipmentCategories(r).includes(x)));
  const filtered=rooms.filter(r=>matches(r));
  const availableBuildingIds=new Set(rooms.filter(r=>matches(r,'building')).map(r=>r.building_id));
  const availableTypes=new Set(rooms.filter(r=>matches(r,'type')).map(r=>r.type));
  const availableEquipment=[...new Set(rooms.filter(r=>matches(r,'equipment')).flatMap(roomEquipmentCategories))].sort((a,b)=>a.localeCompare(b,'ru'));
  const capacityOptions=[10,25,50,100,150].filter(value=>rooms.some(r=>matches(r,'capacity')&&r.capacity>=value));
  const groups=buildings.filter(b=>availableBuildingIds.has(b.id)&&(!building||String(b.id)===building)).map(b=>({building:b,rooms:filtered.filter(r=>r.building_id===b.id)})).filter(g=>g.rooms.length);
  const reset=()=>{setSearch('');setBuilding('');setType('');setCapacity('');setEquipment([]);setOpenBuilding('all')};
  const openCorpus=id=>{setOpenBuilding(id);window.setTimeout(()=>document.getElementById(`catalog-building-${id}`)?.scrollIntoView({behavior:'smooth',block:'start'}),100)};
  const openRoom=room=>setDetail(room);
  const toggleCompare=(event,room)=>{event.stopPropagation();setCompare(current=>current.some(item=>item.id===room.id)?current.filter(item=>item.id!==room.id):current.length<3?[...current,room]:current)};
  return <section className="content-page rooms-catalog-page"><div className="rooms-catalog-hero"><div><small>КАТАЛОГ ПРОСТРАНСТВ</small><h1>Аудитории</h1><div className="room-live-legend"><span><i/>Свободна сейчас</span><span><i/>Занята сейчас</span><small>Статус обновляется автоматически</small></div></div><div className="rooms-view-switch">{[['grid','Средняя'],['compact','Компактная'],['list','Список']].map(([key,label])=><button className={view===key?'active':''} onClick={()=>setView(key)} key={key}>{label}</button>)}</div></div>
    <div className="rooms-catalog-filters dependent"><label className="catalog-search"><span>Поиск</span><div><Search/><input value={search} onChange={e=>setSearch(e.target.value)} placeholder="Номер, название или оснащение"/></div></label><label><span>Наименование корпуса</span><select value={building} onChange={e=>{setBuilding(e.target.value);setOpenBuilding(e.target.value?Number(e.target.value):null)}}><option value="">Все доступные корпуса</option>{buildings.filter(b=>availableBuildingIds.has(b.id)).map(b=><option value={b.id} key={b.id}>{b.name}</option>)}</select></label><label><span>Тип аудитории</span><select value={type} onChange={e=>setType(e.target.value)}><option value="">Все доступные типы</option>{Object.entries(ROOM_TYPES).filter(([v])=>availableTypes.has(v)).map(([v,l])=><option value={v} key={v}>{l}</option>)}</select></label><label><span>Вместимость</span><select value={capacity} onChange={e=>setCapacity(e.target.value)}><option value="">Любая доступная</option>{capacityOptions.map(v=><option value={v} key={v}>от {v} мест</option>)}</select></label><MultiFilter label="Техническое оснащение" options={availableEquipment.map(x=>({value:x,label:x}))} value={equipment} setValue={setEquipment}/><button onClick={reset}><RotateCcw/>Сбросить</button></div>
    <div className="rooms-building-selector">{groups.map(({building:b,rooms:items})=><button className={openBuilding===b.id?'active':''} style={{'--building-color':b.color}} key={b.id} onClick={()=>openCorpus(b.id)}><img src={b.image||buildingPhoto(b.id)} alt=""/><span><b>{b.name}</b><small>{b.address}</small><em>{items.length} аудиторий</em></span><ChevronDown/></button>)}</div>
    {groups.map(({building:b,rooms:items})=>(openBuilding==='all'||openBuilding===b.id)&&<section id={`catalog-building-${b.id}`} className="catalog-building-open" key={b.id}><header><h2>{b.name}</h2><span>{items.length} аудиторий</span></header><div className={`catalog-room-grid ${view}-view`}>{(openBuilding==='all'?items.slice(0,5):items).map(room=><article className={`catalog-room-card ${liveStatus(room)?.tone||''}`} key={room.id} onClick={()=>openRoom(room)}><div className="room-card-tools"><label onClick={event=>event.stopPropagation()}><input type="checkbox" checked={compare.some(item=>item.id===room.id)} onChange={event=>toggleCompare(event,room)}/>Сравнить</label></div>{liveStatus(room)&&<div className="room-live-status">{liveStatus(room).label}</div>}<img src={room.images?.[0]||roomPhoto(room.id)} alt={room.name}/><div className="catalog-room-body"><div className="catalog-badges"><span>{ROOM_TYPES[room.type]||room.type}</span><span className="floor-badge">{room.floor_display||`${room.floor} этаж`}</span><span className="capacity-badge">{room.capacity} мест</span></div><h3>{room.name}</h3>{room.area&&<p>Площадь: {String(room.area).replace('.',',')} м²</p>}<div className="equipment">{room.equipment.slice(0,3).map(item=><span key={item}>{item}</span>)}{room.equipment.length>3&&<span>+{room.equipment.length-3}</span>}</div><button className="primary" onClick={e=>{e.stopPropagation();openBooking(room,null)}}>Забронировать</button></div></article>)}</div>{openBuilding==='all'&&items.length>5&&<button className="secondary catalog-show-all" onClick={()=>openCorpus(b.id)}>Показать все аудитории корпуса: {items.length}</button>}</section>)}
    {!filtered.length&&<div className="empty"><Search/><strong>Аудитории не найдены</strong><span>Измените параметры фильтров.</span><button className="secondary" onClick={reset}>Сбросить фильтры</button></div>}{compare.length>0&&<div className="compare-dock"><span><b>Сравнение аудиторий</b><small>{compare.length} из 3 выбрано</small></span><div>{compare.map(room=><button key={room.id} onClick={event=>toggleCompare(event,room)}>Ауд. {room.number}<X/></button>)}</div><button className="primary" disabled={compare.length<2} onClick={()=>setShowCompare(true)}>Сравнить</button><button className="compare-cancel" aria-label="Отменить сравнение" title="Отменить сравнение" onClick={()=>{setCompare([]);setShowCompare(false)}}><X/></button></div>}{showCompare&&<RoomComparison rooms={compare} close={()=>setShowCompare(false)} book={room=>{setShowCompare(false);openBooking(room,null)}}/>}{detail&&<RoomDetailModal room={detail} close={()=>setDetail(null)} book={()=>{setDetail(null);openBooking(detail,null)}}/>}
  </section>
}

function RoomComparison({rooms,close,book}){return <div className="room-compare-overlay"><button className="backdrop" onClick={close}/><section className="room-compare-modal"><header><div><small>СРАВНЕНИЕ ВАРИАНТОВ</small><h2>Выберите подходящую аудиторию</h2></div><button className="icon" onClick={close}><X/></button></header><div className="room-compare-grid">{rooms.map(room=><article key={room.id}><img src={room.images?.[0]||roomPhoto(room.id)} alt=""/><h3>Аудитория {room.number}</h3><b>{room.building}</b><dl><div><dt>Тип</dt><dd>{ROOM_TYPES[room.type]||room.type}</dd></div><div><dt>Вместимость</dt><dd>{room.capacity} мест</dd></div><div><dt>Этаж</dt><dd>{room.floor_display||`${room.floor} этаж`}</dd></div><div><dt>Оснащение</dt><dd>{roomEquipmentCategories(room).join(', ')||'Не указано'}</dd></div></dl><button className="primary" onClick={()=>book(room)}>Забронировать</button></article>)}</div></section></div>}

function RoomDetailModal({room,close,book}) { const slides=(room.images||[]).slice(0,2);const [index,setIndex]=useState(0);const [showPlan,setShowPlan]=useState(false);return <div className="room-detail-overlay" onMouseDown={e=>e.target===e.currentTarget&&close()}><article className="room-detail-modal"><button className="room-detail-close" onClick={close}><X/></button><div className="room-detail-gallery"><img src={slides[index]||roomPhoto(room.id)} alt={room.name}/>{slides.length>1&&<><button className="prev" onClick={()=>setIndex((index-1+slides.length)%slides.length)}><ChevronLeft/></button><button className="next" onClick={()=>setIndex((index+1)%slides.length)}><ChevronRight/></button><span>{index+1} / {slides.length} · фото аудитории</span></>}</div><div className="room-detail-content"><div className="room-building-banner" style={{background:room.color}}><Building2/><span><small>КОРПУС</small><b>{room.building}</b></span></div><div className="catalog-badges detail-badges"><span>{ROOM_TYPES[room.type]||room.type}</span><span className="floor-badge">{room.floor_display||`${room.floor} этаж`}</span><span className="capacity-badge"><b>{room.capacity}</b> мест</span></div><h2>{room.name}</h2><details className="room-info-block general" open><summary><span><Info/>ОБЩАЯ ХАРАКТЕРИСТИКА</span><ChevronDown/></summary><div className="room-info-body"><p>{room.description}</p>{room.area&&<strong>Площадь: {String(room.area).replace('.',',')} м²</strong>}</div></details><details className="room-info-block technical"><summary><span><Wrench/>ТЕХНИЧЕСКИЕ ДАННЫЕ</span><ChevronDown/></summary><div className="room-info-body"><div className="equipment">{room.equipment.map(x=><span key={x}>{x}</span>)}</div></div></details><details className="room-info-block usage"><summary><span><CalendarCheck/>ВАРИАНТЫ ИСПОЛЬЗОВАНИЯ</span><ChevronDown/></summary><div className="room-info-body"><ul>{room.usage_options?.map(x=><li key={x}>{x}</li>)}</ul></div></details><button className="room-floor-plan-trigger" disabled={!room.floor_plan} onClick={()=>room.floor_plan&&setShowPlan(true)}><span><MapPin/>РАСПОЛОЖЕНИЕ НА ЭТАЖЕ<small>{room.floor_plan?'Открыть схему в полном размере':'Схема отсутствует в паспорте'}</small></span><ChevronRight/></button>{book&&<button className="primary room-detail-book" onClick={book}>Забронировать эту аудиторию</button>}</div></article>{showPlan&&<div className="floor-plan-overlay" onMouseDown={e=>e.target===e.currentTarget&&setShowPlan(false)}><figure><button onClick={()=>setShowPlan(false)}><X/></button><figcaption>{room.building} · {room.floor_display||`${room.floor} этаж`}</figcaption><div className="floor-plan-scroll"><img src={room.floor_plan} alt={`Схема: ${room.floor_display}`}/></div></figure></div>}</div> }

function BookingsPage({bookings}) {
  return <section className="content-page"><div className="page-heading"><div><h1>Бронирования</h1><p>Расписание на выбранный месяц</p></div><span className="count-pill">{bookings.length} записей</span></div><div className="bookings-table"><div className="table-row table-head"><span>Дата и время</span><span>Аудитория</span><span>Событие</span><span>Ответственный</span><span>Статус</span></div>{bookings.map(item=><div className="table-row" key={item.id}><span><b>{new Date(item.date+'T00:00:00').toLocaleDateString('ru-RU',{day:'2-digit',month:'short'})}</b><small>{item.time_start}–{item.time_end}</small></span><span><b>{item.room_number}</b><small>{item.building}</small></span><span><b>{item.title}</b><small>{item.teacher||item.group_name||'—'}</small></span><span>{item.booked_by}</span><span><i className="status-dot"/>Активно</span></div>)}</div></section>
}

function MyBookingsPage({notice,user,rooms,buildings,onChanged,goToRooms,initialRoom,clearInitialRoom,focusedBooking,active,refreshKey,seriesRequest,clearSeriesRequest}) {
  if(user?.role==='admin') return <AdminBookingCenter active={active} seriesRequest={seriesRequest} clearSeriesRequest={clearSeriesRequest} request={api} notice={notice} rooms={rooms} buildings={buildings} user={user} focusedBooking={focusedBooking} initialRoom={initialRoom} clearInitialRoom={clearInitialRoom} onChanged={onChanged}/>;
  return <UserBookingPortal refreshKey={refreshKey} active={active} seriesRequest={seriesRequest} clearSeriesRequest={clearSeriesRequest} request={api} notice={notice} user={user} rooms={rooms} buildings={buildings} focusedBooking={focusedBooking} initialRoom={initialRoom} clearInitialRoom={clearInitialRoom} onChanged={onChanged} goToRooms={goToRooms}/>;
}

function AdminPage({notice,items,buildings=[],focusId,refresh}) {
  const [period,setPeriod]=useState('all');const [building,setBuilding]=useState('');const [query,setQuery]=useState('');const [sort,setSort]=useState('oldest');
  const [rejectTarget,setRejectTarget]=useState(null);
  const todayValue=iso(new Date());const tomorrowValue=iso(addDays(new Date(),1));const weekEnd=iso(addDays(new Date(),7));
  const buildingOptions=useMemo(()=>buildings.map(item=>item.name).filter(Boolean).sort((a,b)=>a.localeCompare(b,'ru')),[buildings]);
  // Group first, then filter: a series must stay whole, otherwise approving a partly visible series approves only the visible dates.
  const filtered=useMemo(()=>groupSeriesItems(attachRoomSets(items)).filter(group=>(group.series_items||[group]).some(item=>(period==='all'||(period==='today'&&item.date===todayValue)||(period==='tomorrow'&&item.date===tomorrowValue)||(period==='week'&&item.date>=todayValue&&item.date<=weekEnd))&&(!building||item.building===building)&&(!query||`${item.title} ${item.booked_by} ${item.room_number} ${item.building} ${item.department_name||''}`.toLowerCase().includes(query.toLowerCase())))).sort((a,b)=>sort==='newest'?String(b.created_at).localeCompare(String(a.created_at)):sort==='event'?`${a.date} ${a.time_start}`.localeCompare(`${b.date} ${b.time_start}`):String(a.created_at).localeCompare(String(b.created_at))),[items,period,building,query,sort,todayValue,tomorrowValue,weekEnd]);
  const focusGroupId=filtered.find(item=>item.id===focusId||item.series_items?.some(entry=>entry.id===focusId))?.id;
  useEffect(()=>{if(!focusId)return;const timer=setTimeout(()=>document.getElementById(`moderation-${focusGroupId||focusId}`)?.scrollIntoView({behavior:'smooth',block:'center'}),100);return()=>clearTimeout(timer)},[focusId,focusGroupId,items.length]);
  const groupCount=useMemo(()=>groupSeriesItems(attachRoomSets(items)).length,[items]);
  const longDate=value=>new Date(value+'T00:00:00').toLocaleDateString('ru-RU',{day:'numeric',month:'long',year:'numeric'});
  const [approving,setApproving]=useState(null);const removeExtra=async extra=>{if(!window.confirm(`Убрать ауд. ${extra.room_number} (${extra.room_purpose}) из комплекта? Заявка на неё будет отклонена.`))return;try{await api(`/api/admin/bookings/${extra.id}/reject`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({reason:extra.has_conflict?'Аудитория занята — снята из комплекта':'Снята из комплекта администратором'})});notice('Аудитория убрана из комплекта')}catch(e){notice(e.message)}finally{await refresh()}};const setBlocked=item=>(item.set_extras||[]).some(extra=>extra.status==='pending'&&extra.has_conflict);const approve=async(item,skipConflicts=false)=>{if(approving)return;if(skipConflicts&&!window.confirm('Одобрить свободные даты серии? Даты, где аудитория уже занята, будут отклонены с причиной «Аудитория в эту дату уже занята».'))return;setApproving(item.id);try{if(item.series_items)await api(`/api/admin/booking-series/${item.series_id}/status`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({status:'approved',skip_conflicts:skipConflicts})});else await api(`/api/admin/bookings/${item.id}/approve`,{method:'POST'});notice(item.series_items?(skipConflicts?'Свободные даты серии одобрены, занятые отклонены':'Серия заявок одобрена'):'Заявка одобрена')}catch(e){notice(e.message)}finally{await refresh();setApproving(null)}};
  return <section className="content-page moderation-page"><div className="page-heading"><div><small>РАБОЧАЯ ОЧЕРЕДЬ</small><h1>Модерация заявок</h1><p>Проверьте дату, аудиторию и параметры мероприятия, затем примите решение.</p></div><span className="count-pill">{groupCount} на рассмотрении</span></div><div className="moderation-filters"><label className="moderation-search"><Search/><input value={query} onChange={event=>setQuery(event.target.value)} placeholder="Поиск по заявке, пользователю или аудитории"/></label><select value={period} onChange={event=>setPeriod(event.target.value)}><option value="all">Все даты</option><option value="today">Сегодня</option><option value="tomorrow">Завтра</option><option value="week">Ближайшие 7 дней</option></select><select value={building} onChange={event=>setBuilding(event.target.value)}><option value="">Все корпуса</option>{buildingOptions.map(value=><option key={value}>{value}</option>)}</select><select value={sort} onChange={event=>setSort(event.target.value)}><option value="oldest">Сначала поступившие раньше</option><option value="newest">Сначала новые</option><option value="event">По дате мероприятия</option></select>{(period!=='all'||building||query)&&<button className="secondary" onClick={()=>{setPeriod('all');setBuilding('');setQuery('')}}><RotateCcw/>Сбросить</button>}</div><div className="moderation-summary"><b>{filtered.length}</b><span>заявок соответствует выбранным условиям</span></div><div className="moderation-list">{filtered.length?filtered.map(item=><article id={`moderation-${item.id}`} className={focusGroupId===item.id?'focused':''} key={item.id}><span className="moderation-icon"><ShieldCheck/></span><div className="moderation-request-body"><div className="moderation-request-meta"><span>{item.series_items?`Серия заявок · ${item.series_count} бронирований`:item.set_extras?`Комплект № ${item.id} · основная + ${item.set_extras.length} доп. аудитории`:item.parent_booking_id?`Доп. аудитория к брони № ${item.parent_booking_id} · ${item.room_purpose||''}`:`Заявка № ${item.id}`}</span><time>Поступила {item.created_at?new Date(item.created_at).toLocaleString('ru-RU',{hour12:false}):'недавно'}</time></div><h3>{item.title}</h3>{item.series_items?<p><b>{[...new Set(item.series_items.map(entry=>entry.building))].join(', ')}</b><strong>{(numbers=>numbers.length===1?`Аудитория ${numbers[0]}`:`Аудитории ${numbers.join(', ')}`)([...new Set(item.series_items.map(entry=>entry.room_number))])}</strong></p>:<p><b>{item.building}</b><strong>Аудитория {item.room_number}</strong></p>}<div className="moderation-details"><span><CalendarDays/>{item.series_items?`${longDate(item.series_dates[0])} — ${longDate(item.series_dates[1])}`:longDate(item.date)}</span><span><Clock3/>{item.time_start}–{item.time_end}</span><span><Users/>{item.participants||'—'} участников</span><span><Users/>{item.booked_by}</span></div><div className="moderation-details"><span><Building2/>{item.department_name||'Подразделение не указано'}</span><span><Info/>{item.customer_name||item.booked_by}{item.customer_contact?` · ${item.customer_contact}`:''}</span></div>{item.requested_equipment?.length>0&&<p className="moderation-extra"><Wrench/>Дополнительное оснащение: <b>{item.requested_equipment.join(', ')}</b></p>}{(conflicts=>conflicts.length>0&&<p className="moderation-warning conflict"><AlertCircle/>{item.series_items?`Аудитория уже занята в ${conflicts.length} из ${item.series_count} дат серии — одобрить серию целиком нельзя`:`Аудитория уже занята: ${item.conflict?.time_start}–${item.conflict?.time_end} «${item.conflict?.title}»`}</p>)((item.series_items||[item]).filter(entry=>entry.has_conflict))}{(competing=>competing>0&&<p className="moderation-warning"><Info/>На это же время и аудиторию есть ещё заявок: {competing}. После одобрения одной остальные одобрить не получится.</p>)(Math.max(...(item.series_items||[item]).map(entry=>entry.competing_requests||0)))}{item.series_items&&<details className="moderation-series-list"><summary>Все даты серии ({item.series_count})</summary><ul>{item.series_items.map(entry=><li key={entry.id}>{longDate(entry.date)}, {entry.time_start}–{entry.time_end} · {entry.building} · ауд. {entry.room_number}{entry.has_conflict?' · конфликт по времени':''}</li>)}</ul></details>}{item.comment&&<blockquote>{item.comment}</blockquote>}<AttachmentList compact items={[...new Map((item.series_items||[item]).flatMap(entry=>entry.attachments||[]).map(file=>[file.id,file])).values()]} request={api} user={{role:'admin'}} onChanged={refresh}/><RoomSetList extras={item.set_extras||[]} title="Дополнительные аудитории комплекта" actions={extra=>extra.status==='pending'&&<button className="secondary" onClick={()=>removeExtra(extra)}>Убрать из комплекта</button>}/>{setBlocked(item)&&<p className="moderation-warning conflict"><AlertCircle/>Часть дополнительных аудиторий уже занята — уберите их из комплекта, затем одобрите остальное</p>}</div><div className="moderation-actions"><button className="secondary" disabled={approving===item.id} onClick={()=>setRejectTarget(item)}>{item.series_items?'Отклонить серию':'Отклонить'}</button>{item.series_items&&item.series_items.some(entry=>entry.has_conflict)&&!item.series_items.every(entry=>entry.has_conflict)&&<button className="secondary" disabled={Boolean(approving)} onClick={()=>approve(item,true)}>Одобрить свободные ({item.series_items.filter(entry=>!entry.has_conflict).length} из {item.series_count})</button>}<button className="primary" disabled={Boolean(approving)||(item.series_items||[item]).some(entry=>entry.has_conflict)||setBlocked(item)} title={(item.series_items||[item]).some(entry=>entry.has_conflict)?'Аудитория уже занята на это время':setBlocked(item)?'Уберите занятые дополнительные аудитории из комплекта':''} onClick={()=>approve(item)}>{approving===item.id?'Сохраняем…':item.series_items?'Одобрить серию':item.set_extras?'Одобрить комплект':'Одобрить'}</button></div></article>):<div className="empty compact"><ShieldCheck/><strong>{items.length?'По выбранным фильтрам заявок нет':'Новых заявок нет'}</strong><span>{items.length?'Измените или сбросьте фильтры.':'Все поступившие заявки рассмотрены.'}</span></div>}</div>{rejectTarget&&<ModerationRejectDialog item={rejectTarget} close={()=>setRejectTarget(null)} notice={notice} done={async()=>{const series=Boolean(rejectTarget.series_items);setRejectTarget(null);notice(series?'Серия заявок отклонена, причина сохранена':'Заявка отклонена, причина сохранена');await refresh()}}/>}</section>
}

function ModerationRejectDialog({item,close,notice,done}){const [reason,setReason]=useState('');const [comment,setComment]=useState('');const [saving,setSaving]=useState(false);const [attempted,setAttempted]=useState(false);const submit=async event=>{event.preventDefault();setAttempted(true);if(!reason)return;setSaving(true);try{const text=comment.trim()?`${reason}. ${comment.trim()}`:reason;if(item.series_items)await api(`/api/admin/booking-series/${item.series_id}/status`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({status:'rejected',reason:text})});else await api(`/api/admin/bookings/${item.id}/reject`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({reason:text})});await done()}catch(error){notice(error.message);setSaving(false)}};return <div className="modal moderation-reject-modal" role="dialog" aria-modal="true"><button className="backdrop" onClick={close}/><form className="moderation-reject-dialog" onSubmit={submit}><header><div><small>{item.series_items?`РЕШЕНИЕ ПО СЕРИИ · ${item.series_count} БРОНИРОВАНИЙ`:`РЕШЕНИЕ ПО ЗАЯВКЕ № ${item.id}`}</small><h2>Причина отклонения</h2><p>Пользователь увидит эту информацию в истории заявки.</p></div><button type="button" className="icon" onClick={close} aria-label="Закрыть"><X/></button></header><div className="moderation-reject-booking"><ShieldCheck/><span><b>{item.title}</b><small>{item.building} · аудитория {item.room_number}</small><em>{new Date(item.date+'T00:00:00').toLocaleDateString('ru-RU',{day:'numeric',month:'long',year:'numeric'})}{item.series_items?` — ${new Date(item.series_dates[1]+'T00:00:00').toLocaleDateString('ru-RU',{day:'numeric',month:'long',year:'numeric'})}`:''}, {item.time_start}–{item.time_end}</em></span></div><label className={attempted&&!reason?'invalid':''}><span>Причина *</span><select value={reason} onChange={event=>setReason(event.target.value)}><option value="">Выберите причину</option><option>Аудитория занята на выбранное время</option><option>Аудитория не подходит по вместимости</option><option>Необходимо уточнить параметры мероприятия</option><option>Требуемое оснащение недоступно</option><option>Заявка содержит неполные данные</option><option>Другая причина</option></select>{attempted&&!reason&&<small>Выберите причину отклонения</small>}</label><label><span>Комментарий администратора</span><textarea value={comment} onChange={event=>setComment(event.target.value)} maxLength={440} placeholder="Дополнительное пояснение для пользователя"/></label><footer><button type="button" className="secondary" onClick={close}>Вернуться</button><button className="soft-danger" disabled={saving}>{saving?'Сохраняем…':'Отклонить заявку'}</button></footer></form></div>}

function AuthModal({close,done,intent='user',initialRegister=false}) {
  const [register,setRegister]=useState(Boolean(initialRegister)); const [error,setError]=useState(''); const [saving,setSaving]=useState(false); const [showPassword,setShowPassword]=useState(false);
  const submit=async e=>{e.preventDefault();setSaving(true);setError('');const body=Object.fromEntries(new FormData(e.currentTarget));try{const data=await api(`/api/auth/${register?'register':'login'}`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});if(intent==='admin'&&data.user.role!=='admin'){csrfToken=data.csrf_token;await api('/api/auth/logout',{method:'POST'});csrfToken='';throw new Error('Эта учётная запись не имеет прав администратора')}done(data)}catch(err){setError(err.message);setSaving(false)}};
  return <div className="modal"><button className="backdrop" onClick={close}/><form className="auth-form" onSubmit={submit}><header><div><small>{register?'НОВАЯ УЧЁТНАЯ ЗАПИСЬ':intent==='admin'?'ВХОД ДЛЯ АДМИНИСТРАТОРА':'ВХОД ДЛЯ ПОЛЬЗОВАТЕЛЯ'}</small><h2>{register?'Регистрация':intent==='admin'?'Панель администратора':'Личный кабинет'}</h2></div><button type="button" className="icon" onClick={close}><X/></button></header>{register&&<label><span>Имя и фамилия</span><input name="full_name" required minLength="2" autoComplete="name"/></label>}<label><span>Email</span><input name="email" type="email" required autoComplete="email"/></label><label><span>Пароль</span><div className="password-field"><input name="password" type={showPassword?'text':'password'} required minLength="8" autoComplete={register?'new-password':'current-password'}/><button type="button" onClick={()=>setShowPassword(!showPassword)} aria-label={showPassword?'Скрыть пароль':'Показать пароль'} title={showPassword?'Скрыть пароль':'Показать пароль'}>{showPassword?<EyeOff/>:<Eye/>}</button></div></label>{error&&<p className="error">{error}</p>}<button className="primary" disabled={saving}>{saving?'Подождите…':register?'Зарегистрироваться':'Войти'}</button>{intent!=='admin'&&<button type="button" className="auth-switch" onClick={()=>{setRegister(!register);setError('')}}>{register?'Уже есть аккаунт? Войти':'Нет аккаунта? Зарегистрироваться'}</button>}</form></div>
}

function BookingModal({rooms,room,day,close,done,isAdmin=false,onSeries}) {const [files,setFiles]=useState([]);const [extraRooms,setExtraRooms]=useState([]);const [snap,setSnap]=useState({date:day?iso(day):'',time_start:'',time_end:''});
  const [error,setError]=useState(''); const [saving,setSaving]=useState(false);
  const [departments,setDepartments]=useState([]);
  const [departmentChoice,setDepartmentChoice]=useState('');const [departmentName,setDepartmentName]=useState('');const [phone,setPhone]=useState('');
  const [buildingId,setBuildingId]=useState(room?String(room.building_id):'');
  const [roomId,setRoomId]=useState(room?String(room.id):'');
  const buildingOptions=useMemo(()=>[...new Map(rooms.map(item=>[String(item.building_id),item.building])).entries()].sort((a,b)=>a[1].localeCompare(b[1],'ru')),[rooms]);
  const availableRooms=useMemo(()=>rooms.filter(item=>!buildingId||String(item.building_id)===buildingId),[rooms,buildingId]);
  const equipmentOptions=useMemo(()=>additionalEquipmentOptions(rooms),[rooms]);
  const currentRoom=rooms.find(item=>String(item.id)===roomId)||null;
  useEffect(()=>{let active=true;Promise.all([api('/api/departments').catch(()=>[]),isAdmin?Promise.resolve(null):api('/api/auth/me').catch(()=>null)]).then(([list,me])=>{if(!active)return;setDepartments(list);if(!me?.user)return;setPhone(me.user.phone||'');const own=String(me.user.department||'').trim();if(!own)return;const known=list.find(item=>item.name.toLowerCase()===own.toLowerCase());if(known)setDepartmentChoice(String(known.id));else{setDepartmentChoice('other');setDepartmentName(own)}});return()=>{active=false}},[isAdmin]);
  const selectBuilding=value=>{setBuildingId(value);if(!rooms.some(item=>String(item.id)===roomId&&String(item.building_id)===value))setRoomId('')};
  const submit=async e=>{e.preventDefault();setError('');const f=new FormData(e.currentTarget);const body=Object.fromEntries(f);body.requested_equipment=f.getAll('requested_equipment');body.participants=Number(body.participants);if(!extraRoomsReady(extraRooms)){setError('Для каждой дополнительной аудитории выберите аудиторию и назначение');return}body.extra_rooms=extraRoomsPayload(extraRooms);if(body.department_id==='other')delete body.department_id;else delete body.department_name;if(currentRoom&&body.participants>currentRoom.capacity){setError(`Аудитория ${currentRoom.number} вмещает ${currentRoom.capacity} чел. — выберите аудиторию больше или уменьшите число участников`);return}setSaving(true);try{const created=await api('/api/bookings',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});const failed=await uploadAttachments(api,{bookingId:created.id},files);done(uploadFailureNotice(failed))}catch(err){setError(err.message);setSaving(false)}};
  return <div className="modal"><button className="backdrop" onClick={close}/><form className="booking-form-v2" onSubmit={submit} onChange={event=>{const f=new FormData(event.currentTarget);setSnap({date:f.get('date')||'',time_start:f.get('time_start')||'',time_end:f.get('time_end')||''})}}><header><div><small>НОВАЯ ЗАПИСЬ</small><h2>Забронировать аудиторию</h2></div><button type="button" className="icon" onClick={close}><X/></button></header><p className="booking-form-hint">Заполняйте обязательные поля по порядку — готовые шаги будут отмечены зелёным.</p><div className="form-grid"><label className="required-step"><span>1. Корпус</span><select value={buildingId} onChange={event=>selectBuilding(event.target.value)} required><option value="" disabled>Выберите корпус</option>{buildingOptions.map(([id,name])=><option value={id} key={id}>{name}</option>)}</select></label><label className="required-step"><span>2. Аудитория</span><select name="room_id" value={roomId} onChange={event=>setRoomId(event.target.value)} required disabled={!buildingId}><option value="" disabled>{buildingId?'Выберите аудиторию':'Сначала выберите корпус'}</option>{availableRooms.map(r=><option key={r.id} value={r.id}>{r.number} — {r.name} ({r.capacity} мест)</option>)}</select></label><label className="required-step"><span>3. Дата</span><input name="date" type="date" defaultValue={day?iso(day):''} min={iso(new Date())} required/></label><label><span>Тип мероприятия</span><select name="booking_type"><option value="lecture">Лекция</option><option value="seminar">Семинар</option><option value="meeting">Совещание</option><option value="other">Другое</option></select></label><label className="required-step"><span>4. Начало</span><TimeSelect name="time_start"/></label><label className="required-step"><span>5. Окончание</span><TimeSelect name="time_end"/></label><label className="full required-step"><span>6. Название</span><input name="title" placeholder="Например, лекция по истории искусств" required minLength="2"/></label><label className="required-step"><span>7. Количество участников</span><input name="participants" type="number" min="1" max={currentRoom?.capacity||5000} placeholder={currentRoom?`До ${currentRoom.capacity} мест`:'Например, 25'} required/></label><label className="required-step"><span>8. ФИО ответственного</span><input name="customer_name" placeholder="Иванова Анна Сергеевна" required minLength="2"/></label><label className={`required-step ${departmentChoice&&(departmentChoice!=='other'||departmentName.trim().length>=2)?'field-complete':''}`}><span>9. Структурное подразделение</span><select name="department_id" value={departmentChoice} onChange={event=>setDepartmentChoice(event.target.value)} required><option value="" disabled>Выберите подразделение</option>{departments.map(item=><option value={item.id} key={item.id}>{isAdmin?`${item.code} · ${item.name}`:item.name}</option>)}{!isAdmin&&<option value="other">Нет в списке — указать вручную</option>}</select>{departmentChoice==='other'&&<input name="department_name" value={departmentName} onChange={event=>setDepartmentName(event.target.value)} placeholder="Полное название подразделения" required minLength="2"/>}</label><label className="required-step"><span>10. Телефон</span><input name="customer_contact" type="tel" value={phone} onChange={event=>setPhone(event.target.value)} placeholder="+7 999 000-00-00" required minLength="3"/></label><RoomEquipmentBlock className="full" rooms={[currentRoom]}/><div className="full equipment-request"><details><summary><span><Wrench/>Дополнительное техническое оснащение</span><ChevronDown/></summary><div>{equipmentOptions.map(item=><label key={item}><input type="checkbox" name="requested_equipment" value={item}/><span>{item}</span></label>)}</div></details><small>Выберите всё, что потребуется дополнительно для встречи.</small></div><label className="full"><span>Комментарий</span><input name="comment" placeholder="Дополнительная информация"/></label><ExtraRoomsPicker request={api} availabilityUrl={isAdmin?'/api/admin/availability':'/api/availability'} date={snap.date} timeStart={snap.time_start} timeEnd={snap.time_end} mainRoomId={roomId} value={extraRooms} onChange={setExtraRooms}/><AttachmentPicker files={files} onChange={setFiles}/></div>{error&&<p className="error">{error}</p>}<footer><button type="button" className="secondary" onClick={close}>Отмена</button>{onSeries&&<button type="button" className="secondary series-entry-button" onClick={()=>onSeries(currentRoom)}><CalendarCheck/>Серия бронирования</button>}<button className="primary" disabled={saving}>{saving?'Сохраняем…':isAdmin?'Забронировать аудиторию':'Отправить на модерацию'}</button></footer></form></div>
}

function TimeSelect({name}) { const times=Array.from({length:29},(_,i)=>{const minutes=8*60+i*30;return `${String(Math.floor(minutes/60)).padStart(2,'0')}:${String(minutes%60).padStart(2,'0')}`});return <select name={name} defaultValue="" required><option value="" disabled>Выберите время</option>{times.map(time=><option value={time} key={time}>{time}</option>)}</select> }
