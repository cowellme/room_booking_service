import { useMemo, useState } from 'react';
import { Ban, Building2, CalendarDays, ChevronLeft, ChevronRight, Copy, Link2, MessageSquarePlus, Repeat2, ShieldCheck, Users, X } from 'lucide-react';
import { formatDepartmentCode } from './bookingCenterConfig';

const iso = date => `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
const addDays = (date, count) => { const value = new Date(date); value.setDate(value.getDate() + count); return value };
const monday = date => addDays(date, -((date.getDay() + 6) % 7));
const times = Array.from({ length: 29 }, (_, index) => { const value = 8 * 60 + index * 30; return `${String(Math.floor(value / 60)).padStart(2, '0')}:${String(value % 60).padStart(2, '0')}` });
const dateLabel = value => new Date(`${value}T00:00:00`).toLocaleDateString('ru-RU', { weekday: 'short', day: 'numeric', month: 'short' });

export function OperationalGrid({ items, rooms, openBooking, openDetail }) {
  const [mode, setMode] = useState('week'); const [cursor, setCursor] = useState(() => monday(new Date())); const [building, setBuilding] = useState(''); const [limit, setLimit] = useState(30);
  const days = Array.from({ length: mode === 'day' ? 1 : 7 }, (_, index) => addDays(cursor, index));
  const buildingOptions = [...new Map(rooms.map(room => [room.building_id, room.building])).entries()];
  const matchingRooms = rooms.filter(room => !building || String(room.building_id) === building); const activeRooms = matchingRooms.slice(0, limit);
  const move = mode === 'day' ? 1 : 7; const columns = `160px repeat(${days.length}, minmax(${mode === 'day' ? 500 : 130}px, 1fr))`;
  return <section className={`operations-grid-shell ${mode}`}><header><div><small>ОПЕРАТИВНАЯ СЕТКА</small><h2>Аудитории × {mode === 'day' ? 'время дня' : 'дни недели'}</h2></div><div className="operations-grid-filters"><select aria-label="Корпус" value={building} onChange={event => setBuilding(event.target.value)}><option value="">Все корпуса</option>{buildingOptions.map(([id, name]) => <option value={id} key={id}>{name}</option>)}</select><button className={mode === 'day' ? 'active' : ''} onClick={() => { setMode('day'); setCursor(new Date()) }}>День</button><button className={mode === 'week' ? 'active' : ''} onClick={() => { setMode('week'); setCursor(monday(cursor)) }}>Неделя</button><button onClick={() => setCursor(addDays(cursor, -move))}><ChevronLeft /></button><button onClick={() => setCursor(mode === 'day' ? new Date() : monday(new Date()))}>Сегодня</button><button onClick={() => setCursor(addDays(cursor, move))}><ChevronRight /></button></div></header><div className="operations-grid"><div className="operations-grid-head" style={{ gridTemplateColumns: columns }}><b>Аудитория</b>{days.map(day => <span className={[0, 6].includes(day.getDay()) ? 'weekend' : ''} key={iso(day)}>{day.toLocaleDateString('ru-RU', { weekday: 'short', month: 'long' })}<strong>{day.getDate()}</strong></span>)}</div>{activeRooms.map(room => <div className="operations-grid-row" style={{ gridTemplateColumns: columns }} key={room.id}><div className="operations-room"><b>Ауд. {room.number}</b><small>{room.building}</small></div>{days.map(day => { const records = items.filter(item => item.room_id === room.id && item.date === iso(day) && !item.archived_at); return <div className="operations-cell" key={iso(day)}>{records.slice(0, mode === 'day' ? 12 : 3).map(item => <button className={`operations-entry ${item.record_kind || 'booking'} ${item.status}`} style={{ '--entry-color': item.color }} onClick={() => openDetail(item)} key={item.id}><time>{item.time_start}–{item.time_end}</time><span>{item.title}</span></button>)}{records.length > (mode === 'day' ? 12 : 3) && <small>+{records.length - (mode === 'day' ? 12 : 3)}</small>}<button className="operations-add" aria-label={`Забронировать аудиторию ${room.number} на ${dateLabel(iso(day))}`} onClick={() => openBooking({ date: iso(day), building_id: String(room.building_id), room_type: room.type || '', preferred_room_id: room.id, preferred_room: room })}>+</button></div> })}</div>)}</div>{matchingRooms.length > limit && <p className="operations-grid-note">Показано {limit} из {matchingRooms.length} аудиторий. <button type="button" className="secondary" onClick={() => setLimit(limit + 30)}>Показать ещё</button></p>}</section>
}

export function ServiceBlockDialog({ rooms, request, close, done }) { const [saving, setSaving] = useState(false); const [error, setError] = useState(''); const submit = async event => { event.preventDefault(); setSaving(true); setError(''); const data = new FormData(event.currentTarget); try { await request('/api/admin/service-blocks', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ room_ids: data.getAll('room_ids').map(Number), date: data.get('date'), date_end: data.get('date_end'), time_start: data.get('time_start'), time_end: data.get('time_end'), record_kind: data.get('record_kind'), title: data.get('title'), reason: data.get('reason') }) }); done() } catch (failure) { setError(failure.message); setSaving(false) } }; return <DialogShell title="Служебная блокировка" eyebrow="НЕДОСТУПНОСТЬ АУДИТОРИИ" close={close}><form className="operation-form" onSubmit={submit}><p>Ремонт, застройка и демонтаж будут отображаться в календаре и блокировать выбранное время.</p><label><span>Тип блокировки</span><select name="record_kind" required><option value="maintenance">Ремонт</option><option value="setup">Застройка / подготовка</option><option value="teardown">Демонтаж</option><option value="unavailable">Другая недоступность</option></select></label><label className="full"><span>Аудитории</span><select name="room_ids" multiple required size="7">{rooms.map(room => <option value={room.id} key={room.id}>Ауд. {room.number} · {room.building}</option>)}</select><small>Для выбора нескольких удерживайте Ctrl.</small></label><label><span>С даты</span><input name="date" type="date" required /></label><label><span>По дату</span><input name="date_end" type="date" required /></label><label><span>Начало</span><TimeSelect name="time_start" /></label><label><span>Окончание</span><TimeSelect name="time_end" /></label><label className="full"><span>Название</span><input name="title" required minLength="2" placeholder="Например, ремонт системы вентиляции" /></label><label className="full"><span>Причина и пояснение</span><textarea name="reason" required minLength="2" /></label>{error && <p className="error full">{error}</p>}<footer className="full"><button type="button" className="secondary" onClick={close}>Отмена</button><button className="primary" disabled={saving}><Ban />{saving ? 'Сохраняем…' : 'Создать блокировку'}</button></footer></form></DialogShell> }


export function BatchBookingDialog({ rooms, departments, request, close, done, initialRoomIds = [] }) { const [saving, setSaving] = useState(false); const [error, setError] = useState(''); const submit = async event => { event.preventDefault(); setSaving(true); setError(''); const data = new FormData(event.currentTarget); try { const result = await request('/api/admin/booking-series', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ room_ids: data.getAll('room_ids').map(Number), date: data.get('date'), date_end: data.get('date_end'), weekdays: data.getAll('weekdays').map(Number), time_start: data.get('time_start'), time_end: data.get('time_end'), title: data.get('title'), booking_type: 'other', participants: data.get('participants') ? Number(data.get('participants')) : null, customer_name: data.get('customer_name'), customer_contact: data.get('customer_contact'), department_id: Number(data.get('department_id')), external_channel: data.get('external_channel') || null, external_reference: data.get('external_reference') || null, external_url: data.get('external_url') || null, comment: data.get('comment') || null, requested_equipment: [] }) }); done(`Создано бронирований: ${result.created}`) } catch (failure) { setError(failure.message); setSaving(false) } }; return <DialogShell title="Серия бронирований" eyebrow="НЕСКОЛЬКО ДАТ И АУДИТОРИЙ" close={close}><form className="operation-form" onSubmit={submit}><label><span>Дата начала серии</span><input name="date" type="date" required /></label><label><span>Дата окончания серии</span><input name="date_end" type="date" required /></label><fieldset className="full weekday-choice"><legend>Дни повторения</legend>{['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс'].map((day, index) => <label key={day}><input type="checkbox" name="weekdays" value={index} defaultChecked={index < 5} /><span>{day}</span></label>)}</fieldset><label className="full"><span>Название программы или мероприятия</span><input name="title" required minLength="2" /></label><label className="full"><span>Аудитории</span><select name="room_ids" multiple required size="7" defaultValue={initialRoomIds.map(String)}>{rooms.map(room => <option value={room.id} key={room.id}>Ауд. {room.number} · {room.building}</option>)}</select><small>Для выбора нескольких удерживайте Ctrl.</small></label><label><span>Начало</span><TimeSelect name="time_start" /></label><label><span>Окончание</span><TimeSelect name="time_end" /></label><label><span>Участников</span><input name="participants" type="number" min="1" /></label><label><span>Структурное подразделение *</span><select name="department_id" required defaultValue=""><option value="" disabled>Выберите подразделение</option>{departments.map(item => <option value={item.id} key={item.id}>{item.code} · {item.name}</option>)}</select></label><label><span>ФИО ответственного *</span><input name="customer_name" required minLength="2" /></label><label><span>Телефон *</span><input name="customer_contact" type="tel" required minLength="3" placeholder="+7 999 000-00-00" /></label><label><span>Источник</span><select name="external_channel"><option value="">Сервис</option><option value="phone">Телефон</option><option value="pyrus">Pyrus</option><option value="telegram">Telegram</option><option value="email">Email</option></select></label><label><span>Номер внешней заявки</span><input name="external_reference" /></label><label className="full"><span>Ссылка на внешнюю заявку</span><input name="external_url" type="url" placeholder="https://..." /></label><label className="full"><span>Комментарий</span><textarea name="comment" /></label>{error && <p className="error full">{error}</p>}<footer className="full"><button type="button" className="secondary" onClick={close}>Отмена</button><button className="primary" disabled={saving}><Copy />{saving ? 'Создаём…' : 'Создать серию'}</button></footer></form></DialogShell> }


export function TransferDialog({ item, rooms, request, close, done }) { const [saving, setSaving] = useState(false); const [error, setError] = useState(''); const submit = async event => { event.preventDefault(); setSaving(true); setError(''); const data = Object.fromEntries(new FormData(event.currentTarget)); data.room_id = Number(data.room_id); data.participants = item.participants || null; data.requested_equipment = item.requested_equipment || []; data.booking_type = item.booking_type || 'other'; data.notify_customer = Boolean(data.notify_customer); try { await request(`/api/admin/booking-center/${item.id}/transfer`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) }); done() } catch (failure) { setError(failure.message); setSaving(false) } }; return <DialogShell title="Перенести бронирование" eyebrow={`БРОНЬ № ${item.id}`} close={close}><form className="operation-form" onSubmit={submit}><div className="full transfer-origin"><Repeat2 /><span><small>ИСХОДНАЯ БРОНЬ</small><b>{dateLabel(item.date)}, {item.time_start}–{item.time_end}</b><em>{item.building} · аудитория {item.room_number}</em></span></div><label className="full"><span>Новая аудитория</span><select name="room_id" defaultValue={item.room_id} required>{rooms.map(room => <option value={room.id} key={room.id}>Ауд. {room.number} · {room.building}</option>)}</select></label><label><span>Новая дата</span><input name="date" type="date" required /></label><label><span>Начало</span><TimeSelect name="time_start" /></label><label><span>Окончание</span><TimeSelect name="time_end" /></label><label className="full"><span>Название</span><input name="title" defaultValue={item.title} required minLength="2" /></label><label className="full"><span>Причина переноса</span><textarea name="reason" required minLength="3" placeholder="Почему и по чьей договорённости переносится бронь" /></label><input type="hidden" name="comment" value={item.comment || ''} /><label className="full check-line"><input type="checkbox" name="notify_customer" defaultChecked /><span>Нужно дополнительно сообщить заказчику о переносе</span></label>{error && <p className="error full">{error}</p>}<footer className="full"><button type="button" className="secondary" onClick={close}>Отмена</button><button className="primary" disabled={saving}><Repeat2 />{saving ? 'Переносим…' : 'Перенести и сохранить историю'}</button></footer></form></DialogShell> }


export function DepartmentsDialog({ departments, request, close, done }) { const [error, setError] = useState(''); const submit = async event => { event.preventDefault(); const form = event.currentTarget; const data = new FormData(form); try { await request('/api/admin/departments', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ code: data.get('code'), name: data.get('name'), curators: String(data.get('curators') || '').split(',').map(item => item.trim()).filter(Boolean) }) }); form.reset(); done() } catch (failure) { setError(failure.message) } }; return <DialogShell title="Подразделения и кураторы" eyebrow="СПРАВОЧНИК ПОДРАЗДЕЛЕНИЙ" close={close}><div className="departments-dialog"><form className="operation-form" onSubmit={submit}><label><span>Код</span><input name="code" required placeholder="Например, ГЗ" /></label><label><span>Название</span><input name="name" required /></label><label className="full"><span>Кураторы через запятую</span><input name="curators" placeholder="Иванова И. И., Петров П. П." /></label>{error && <p className="error full">{error}</p>}<footer className="full"><button className="primary"><Users />Добавить подразделение</button></footer></form><div className="department-list">{departments.map(item => <article key={item.id}><b>{formatDepartmentCode(item.code)}</b><span><strong>{item.name}</strong><small>{item.curators.map(curator => curator.full_name).join(', ') || 'Кураторы не указаны'}</small></span></article>)}</div></div></DialogShell> }


function TimeSelect({ name }) { return <select name={name} defaultValue="" required><option value="" disabled>Выберите время</option>{times.map(value => <option key={value}>{value}</option>)}</select> }
function DialogShell({ title, eyebrow, close, children }) { return <div className="center-modal nested"><button className="center-backdrop" onClick={close} /><section className="operation-dialog"><header><div><small>{eyebrow}</small><h2>{title}</h2></div><button className="icon" onClick={close}><X /></button></header>{children}</section></div> }
