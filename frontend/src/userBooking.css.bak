.user-booking-portal{max-width:none;background:linear-gradient(135deg,#fff 0,#fbf7f8 58%,#f2f7fb 100%);border-radius:22px;padding:26px;min-height:calc(100vh - 110px)}
.user-booking-hero{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-bottom:17px}.user-booking-hero small{font-size:10px;letter-spacing:.14em;font-weight:900;color:var(--wine)}.user-booking-hero h1{font-size:clamp(32px,3vw,46px);letter-spacing:-.045em;margin:4px 0}.user-booking-hero p{font-size:14px;color:var(--muted);margin:0}.user-booking-hero>button{display:flex;align-items:center;gap:8px}.user-booking-hero>button svg{width:18px}
.user-booking-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:11px;margin-bottom:17px}.user-booking-metrics article{display:flex;align-items:center;gap:12px;padding:14px 16px;background:#fff;border:1px solid var(--line);border-radius:14px;box-shadow:0 5px 18px #30202a0c}.user-booking-metrics article>svg{width:38px;height:38px;padding:9px;border-radius:11px;background:#fae9ee;color:var(--wine)}.user-booking-metrics span{display:grid}.user-booking-metrics b{font-size:23px}.user-booking-metrics small{font-size:10px;color:var(--muted)}
.user-portal-tabs{display:flex;gap:5px;padding:4px;width:max-content;border:1px solid var(--line);border-radius:12px;background:#fff;margin-bottom:16px}.user-portal-tabs button{display:flex;align-items:center;gap:7px;border:0;border-radius:8px;background:transparent;padding:10px 15px;font-weight:800;color:#655e67}.user-portal-tabs button.active{background:var(--wine);color:#fff;box-shadow:0 5px 14px #a60e3430}.user-portal-tabs svg{width:16px}.user-portal-tabs b{display:grid;place-items:center;min-width:20px;height:20px;border-radius:15px;background:#eee8eb;color:#625b63;font-size:9px}.user-portal-tabs .active b{background:#fff;color:var(--wine)}
.user-request-layout{display:grid;grid-template-columns:minmax(0,1fr) 260px;gap:15px;align-items:start}.user-request-form{background:#fff;border:1px solid var(--line);border-radius:17px;overflow:hidden;box-shadow:0 7px 25px #30202a0e}.user-request-form>header{display:flex;align-items:center;gap:12px;padding:18px 20px;border-bottom:1px solid var(--line);background:#fcfafb}.user-request-form>header>span{display:grid;place-items:center;width:36px;height:36px;border-radius:50%;background:var(--wine);color:#fff;font-weight:900}.user-request-form h2{font-size:20px;margin:0}.user-request-form header p{font-size:11px;color:var(--muted);margin:3px 0 0}.user-request-fields{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;padding:19px 20px}.user-request-fields>label{display:grid;gap:6px;position:relative}.user-request-fields>label>span{font-size:11px;font-weight:800;color:#5c555e}.user-request-fields input,.user-request-fields select,.user-request-fields textarea{width:100%;border:1px solid #dcd6da;background:#fff;border-radius:9px;padding:11px;font:inherit;font-size:13px}.user-request-fields textarea{min-height:78px;resize:vertical}.user-request-fields .full{grid-column:1/-1}.user-request-fields>label.complete input,.user-request-fields>label.complete select{border-color:#54ab72;background:#f2fbf5;box-shadow:0 0 0 2px #28945112}.user-request-fields>label.complete>span:after{content:'✓';display:inline-grid;place-items:center;margin-left:6px;width:15px;height:15px;border-radius:50%;background:#299658;color:#fff;font-size:9px}.user-check-button{display:flex;align-items:center;justify-content:center;gap:8px;margin:0 20px 20px;width:calc(100% - 40px);padding:13px}.user-check-button svg{width:17px}
.user-equipment{border:1px solid #dcd6da;border-radius:10px;overflow:hidden}.user-equipment summary{display:grid;grid-template-columns:1fr auto 18px;align-items:center;gap:8px;cursor:pointer;list-style:none;padding:12px}.user-equipment summary::-webkit-details-marker{display:none}.user-equipment summary>span{display:flex;align-items:center;gap:7px;font-size:12px;font-weight:800}.user-equipment summary svg{width:16px;color:var(--wine)}.user-equipment summary>svg{transition:.2s}.user-equipment[open] summary>svg{transform:rotate(90deg)}.user-equipment summary>b{font-size:9px;background:#f9e8ed;color:var(--wine);border-radius:20px;padding:5px 8px}.user-equipment>div{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;padding:10px;border-top:1px solid #eee8eb}.user-equipment>div label{display:flex;align-items:center;gap:6px;padding:8px;background:#faf8f9;border-radius:7px;font-size:10px}.user-equipment input{width:14px!important;height:14px;padding:0!important}
.user-request-guide{background:#26232b;color:#fff;border-radius:17px;padding:19px;box-shadow:0 10px 27px #20182324}.user-request-guide h3{font-size:17px;margin:0 0 15px}.user-request-guide>div{display:grid;grid-template-columns:28px 1fr;align-items:center;gap:9px;margin:10px 0}.user-request-guide>div b{display:grid;place-items:center;width:28px;height:28px;border-radius:50%;background:var(--wine);font-size:10px}.user-request-guide>div span{font-size:11px;font-weight:750}.user-request-guide>p{display:flex;gap:7px;margin:18px 0 0;padding:12px;border-radius:10px;background:#ffffff0d;color:#ddd4da;font-size:10px;line-height:1.45}.user-request-guide>p svg{width:17px;flex:none;color:#79d49a}
.user-availability{margin-top:16px;border:1px solid #c9e4d2;background:#f7fcf9;border-radius:17px;overflow:hidden;box-shadow:0 8px 25px #256b3d12}.user-availability>header{display:flex;align-items:center;justify-content:space-between;padding:17px 20px;border-bottom:1px solid #d6eadc}.user-availability header small{font-size:9px;letter-spacing:.12em;font-weight:900;color:#16834b}.user-availability h2{font-size:21px;margin:3px 0}.user-availability header p{font-size:11px;color:#55705e;margin:0}.user-availability header>span{display:grid;place-items:center;width:40px;height:40px;border-radius:50%;background:#16834b;color:#fff;font-weight:900}.user-available-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;padding:13px}.user-available-grid>button{display:grid;grid-template-columns:90px 1fr 20px;align-items:center;gap:10px;text-align:left;border:1px solid #d5e6db;background:#fff;border-radius:12px;padding:8px;transition:.18s}.user-available-grid>button:hover,.user-available-grid>button.selected{border-color:#16834b;box-shadow:0 7px 18px #196d3820;transform:translateY(-2px)}.user-available-grid>button.selected{background:#effaf3}.user-available-grid img{width:90px;height:72px;object-fit:cover;border-radius:8px}.user-available-grid small{font-size:9px;color:#16834b;font-weight:800}.user-available-grid h3{font-size:14px;margin:3px 0}.user-available-grid p{font-size:10px;color:var(--muted);margin:0}.user-available-grid svg{width:17px;color:#16834b}.user-no-availability{display:grid;justify-items:center;text-align:center;gap:6px;padding:35px;color:var(--muted)}.user-no-availability svg{width:30px;color:#ca4052}.user-no-availability b{font-size:15px;color:#363139}.user-no-availability span{font-size:11px}.user-availability>footer{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:14px 20px;background:#eaf7ef;border-top:1px solid #c9e4d2}.user-availability>footer>div{display:flex;align-items:center;gap:9px}.user-availability>footer>div>svg{width:27px;padding:5px;border-radius:50%;background:#16834b;color:#fff}.user-availability>footer span{display:grid}.user-availability>footer small{font-size:8px;color:#16834b;font-weight:900}.user-availability>footer b{font-size:13px}.user-availability>footer button{display:flex;align-items:center;gap:7px}.user-availability>footer button svg{width:16px}
.user-booking-history{background:#fff;border:1px solid var(--line);border-radius:17px;overflow:hidden}.user-booking-history>header{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:18px 20px;background:#fcfafb;border-bottom:1px solid var(--line)}.user-booking-history h2{font-size:21px;margin:0}.user-booking-history header p{font-size:11px;color:var(--muted);margin:3px 0 0}.user-booking-history header>div:last-child{display:flex;gap:5px;flex-wrap:wrap}.user-booking-history header button{border:1px solid var(--line);background:#fff;border-radius:20px;padding:7px 10px;font-size:9px;font-weight:800}.user-booking-history header button.active{background:#28232b;color:#fff}.user-history-list{display:grid;gap:9px;padding:12px}.user-history-list>article{display:grid;grid-template-columns:185px minmax(0,1fr) 145px;gap:16px;align-items:center;border:1px solid var(--line);border-radius:14px;padding:14px}.user-history-date{display:grid;gap:4px;padding-right:14px;border-right:1px solid var(--line)}.user-history-date b{font-size:12px}.user-history-date strong{font-size:20px}.user-history-date small{font-size:9px;color:var(--muted)}.user-history-main>em{font-size:9px}.user-history-main h3{font-size:17px;margin:7px 0}.user-history-room{display:flex;align-items:center;gap:9px;padding:9px 11px;border-radius:10px;background:linear-gradient(135deg,var(--room-color,#9c1238),color-mix(in srgb,var(--room-color,#9c1238) 70%,#14151b));color:#fff}.user-history-room>svg{width:18px}.user-history-room span{display:grid}.user-history-room small{font-size:7px;letter-spacing:.1em;opacity:.75}.user-history-room b{font-size:10px}.user-history-room>strong{margin-left:auto;font-size:14px}.user-history-main>p{font-size:10px;color:var(--muted);margin:7px 0}.user-decision{display:flex;gap:8px;padding:9px;border-radius:9px;margin-top:7px;font-size:10px}.user-decision>svg{width:17px;flex:none}.user-decision>span{display:grid;gap:2px}.user-decision b{font-size:10px}.user-decision small{font-size:9px}.user-decision.waiting{background:#fff6dc;color:#795800}.user-decision.approved{background:#e9f7ee;color:#176b38}.user-decision.rejected,.user-decision.cancelled{background:#fff0f2;color:#9b2536}.user-history-actions{display:grid;gap:9px;text-align:right}.user-history-actions>span{font-size:9px;color:var(--muted)}.user-history-empty{min-height:230px;display:grid;place-items:center;align-content:center;gap:8px;color:var(--muted)}.user-history-empty svg{width:30px}
.user-cancel-dialog{position:relative;width:min(520px,94vw);background:#fff;border-radius:17px;overflow:hidden;box-shadow:0 25px 70px #0006}.user-cancel-dialog>header{display:flex;justify-content:space-between;padding:20px;border-bottom:1px solid var(--line)}.user-cancel-dialog header small{font-size:9px;letter-spacing:.12em;color:var(--wine);font-weight:900}.user-cancel-dialog h2{font-size:23px;margin:3px 0}.user-cancel-dialog>p{padding:15px 20px;margin:0;background:#faf8f9;font-size:11px;line-height:1.6}.user-cancel-dialog>label{display:grid;gap:6px;margin:14px 20px}.user-cancel-dialog label>span{font-size:11px;font-weight:800}.user-cancel-dialog select,.user-cancel-dialog textarea{border:1px solid #dcd6da;border-radius:9px;padding:11px;font:inherit}.user-cancel-dialog textarea{min-height:90px;resize:vertical}.user-cancel-dialog>.error{margin:10px 20px}.user-cancel-dialog>footer{display:flex;justify-content:flex-end;gap:8px;padding:14px 20px;background:#faf8f9;border-top:1px solid var(--line)}
.catalog-room-card{position:relative}.room-live-status{position:absolute;z-index:2;top:10px;left:10px;border-radius:20px;padding:6px 9px;color:#fff;font-size:9px;font-weight:900;box-shadow:0 4px 12px #0003}.catalog-room-card.is-free .room-live-status{background:#16834b}.catalog-room-card.is-occupied .room-live-status{background:#c92f46}.room-live-legend{display:flex;align-items:center;gap:13px;margin-top:12px}.room-live-legend span{display:flex;align-items:center;gap:5px;font-size:10px;font-weight:800}.room-live-legend i{width:9px;height:9px;border-radius:50%;background:#16834b}.room-live-legend span:nth-child(2) i{background:#c92f46}.room-live-legend small{font-size:9px;color:var(--muted)}
@media(max-width:1100px){.user-request-layout{grid-template-columns:1fr}.user-request-guide{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.user-request-guide h3,.user-request-guide>p{grid-column:1/-1}.user-request-guide>div{margin:0}.user-request-fields{grid-template-columns:repeat(2,1fr)}.user-available-grid{grid-template-columns:repeat(2,1fr)}.user-history-list>article{grid-template-columns:160px 1fr}.user-history-actions{grid-column:1/-1;display:flex;align-items:center;justify-content:flex-end}}
@media(max-width:720px){.user-booking-portal{padding:15px}.user-booking-hero,.user-booking-history>header,.user-availability>footer{align-items:stretch;display:grid}.user-booking-metrics{grid-template-columns:1fr}.user-portal-tabs{width:100%;display:grid;grid-template-columns:1fr 1fr}.user-request-fields,.user-equipment>div,.user-available-grid,.user-request-guide{grid-template-columns:1fr}.user-history-list>article{grid-template-columns:1fr}.user-history-date{border-right:0;border-bottom:1px solid var(--line);padding:0 0 10px}.user-history-room{align-items:flex-start;display:grid;grid-template-columns:auto 1fr}.user-history-room>strong{grid-column:1/-1;margin:0}.user-available-grid>button{grid-template-columns:76px 1fr 18px}.user-available-grid img{width:76px;height:64px}.room-live-legend{align-items:flex-start;display:grid}}

/* Пользовательский подбор: форма и результаты занимают равные части экрана. */
.user-request-layout{grid-template-columns:minmax(0,1fr)}
.user-request-layout.has-matches{grid-template-columns:repeat(2,minmax(0,1fr));align-items:stretch}
.user-request-layout.has-matches>.user-request-form,.user-match-pane{min-width:0;height:100%}
.user-match-pane .user-availability{margin-top:0;height:100%;display:flex;flex-direction:column}
.user-match-pane .user-available-grid{grid-template-columns:1fr;max-height:620px;overflow:auto;align-content:start}
.user-match-pane .user-availability>footer{margin-top:auto}
.user-available-grid>button:disabled{cursor:default}
.user-request-fields>label.complete input,.user-request-fields>label.complete select{animation:user-field-complete .35s ease}
.user-request-fields>label.invalid input,.user-request-fields>label.invalid select{border-color:#d43a50;background:#fff1f3;box-shadow:0 0 0 3px #d43a501b;animation:user-field-invalid .32s ease 3}
.user-request-fields>label.invalid>span{color:#b72138}
@keyframes user-field-complete{0%{box-shadow:0 0 0 0 #29965855}100%{box-shadow:0 0 0 5px #29965800}}
@keyframes user-field-invalid{0%,100%{transform:translateX(0)}35%{transform:translateX(-4px)}70%{transform:translateX(4px)}}

.user-portal-tabs .user-guide-open{margin-left:8px;background:#f7edf0;color:var(--wine)}
.user-guide-overlay{position:fixed;z-index:1350;inset:0;display:grid;place-items:center;padding:20px}
.user-guide-backdrop{position:absolute;inset:0;border:0;background:#17131db8}
.user-guide-popup{position:relative;width:min(460px,94vw);padding:28px;animation:user-guide-in .25s ease}
.user-guide-popup h3{font-size:23px;margin-right:38px}
.user-guide-popup>div{grid-template-columns:38px 1fr;margin:14px 0}
.user-guide-popup>div b{width:38px;height:38px;font-size:13px}
.user-guide-popup>div span{font-size:14px}
.user-guide-popup>p{font-size:12px}
.user-guide-close{position:absolute;right:14px;top:14px;width:36px;height:36px;border:0;border-radius:50%;background:#fff;color:#27222a;display:grid;place-items:center}
.user-guide-close svg{width:18px}
@keyframes user-guide-in{from{opacity:0;transform:translateY(12px) scale(.98)}}

/* Высота левой галереи не зависит от раскрытия информационных блоков справа. */
.room-detail-modal{align-items:start}
.room-detail-modal .room-detail-gallery{position:sticky;top:0;height:min(72vh,590px);min-height:min(72vh,590px);max-height:min(72vh,590px);align-self:start}
.room-detail-modal .room-detail-gallery>img{width:100%;height:100%;position:absolute;inset:0;object-fit:cover}

@media(max-width:1100px){.user-request-layout.has-matches{grid-template-columns:1fr}.user-match-pane .user-available-grid{grid-template-columns:repeat(2,minmax(0,1fr));max-height:none}.room-detail-modal .room-detail-gallery{position:relative;height:480px;min-height:480px;max-height:480px}}
@media(max-width:720px){.user-portal-tabs{grid-template-columns:1fr 1fr}.user-portal-tabs .user-guide-open{grid-column:1/-1;margin-left:0}.user-match-pane .user-available-grid{grid-template-columns:1fr}.user-guide-popup{display:block}.user-guide-popup>div{display:grid}.room-detail-modal .room-detail-gallery{height:330px;min-height:330px;max-height:330px}}
.series-fields{grid-column:1/-1;display:grid;gap:10px;padding:12px 14px;border:1px solid #e6bfd0;border-radius:12px;background:#fff7fa}.series-fields label{display:grid;gap:5px}.series-fields>div>span{display:block;font-weight:700;font-size:12px;color:#5a2635}.series-weekdays{display:flex;flex-wrap:wrap;gap:6px}.series-weekdays button{border:1px solid #e3c5cf;background:#fff;border-radius:8px;padding:6px 10px;font-weight:700;color:#6f4a58}.series-weekdays button.active{background:#c81340;color:#fff;border-color:#c81340}.series-fields p{margin:0;color:#765563;font-size:12px}
.series-modal-mode{position:relative}.series-modal-mode:before{content:"";position:fixed;inset:0;background:rgba(20,17,28,.46);z-index:20;pointer-events:none}.series-modal-mode>*{position:relative;z-index:21}.series-modal-banner{display:flex;align-items:center;justify-content:space-between;gap:16px;grid-column:1/-1;padding:16px 20px;border-radius:16px;background:linear-gradient(120deg,#c81340,#8d1234);color:#fff;box-shadow:0 14px 40px rgba(80,10,30,.3);animation:seriesIn .28s ease-out}.series-modal-banner small{font-size:10px;letter-spacing:.12em;opacity:.8}.series-modal-banner h2{margin:4px 0;font-size:24px}.series-modal-banner p{margin:0;opacity:.88}.series-modal-banner .icon{border:1px solid rgba(255,255,255,.5);background:transparent;color:#fff;padding:8px 12px;border-radius:8px}.series-entry-button{display:inline-flex;align-items:center;gap:6px}@keyframes seriesIn{from{opacity:0;transform:translateY(-14px) scale(.98)}to{opacity:1;transform:none}}.user-history-list{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.user-history-list>article{min-width:0}@media(max-width:1200px){.user-history-list{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:900px){.user-history-list{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:620px){.user-history-list{grid-template-columns:1fr}}
/* Fix compact booking cards layout */
.user-history-list>article{display:flex;flex-direction:column;align-items:stretch;gap:10px;min-width:0;padding:16px}.user-history-date{display:grid;grid-template-columns:1fr auto;gap:4px;border-right:0;border-bottom:1px solid var(--line);padding:0 0 10px}.user-history-date small{grid-column:1/-1}.user-history-main{min-width:0}.user-history-actions{display:flex;align-items:center;justify-content:space-between;gap:8px;text-align:left;border-top:1px solid var(--line);padding-top:10px}.user-history-actions>span{min-width:0}.series-modal-banner .icon{white-space:nowrap;min-width:88px;flex:none;display:inline-flex;align-items:center;justify-content:center}
.booking-created-at{display:block;font-size:9px!important;color:var(--muted);font-weight:600}.user-history-date .booking-created-at{grid-column:1/-1;margin-top:2px}
