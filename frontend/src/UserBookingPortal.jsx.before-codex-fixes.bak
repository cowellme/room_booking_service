import {useEffect,useMemo,useRef,useState} from 'react';
import {AlertCircle,Building2,CalendarCheck,Check,ChevronRight,Clock3,History,
        MapPin,Search,Send,ShieldCheck,Users,Wrench,X} from 'lucide-react';
import {ROOM_TYPE_LABELS as ROOM_TYPES, additionalEquipmentOptions, equipmentSearchFilter, roomEquipmentCategories} from './roomConfig';
import {localIso} from './bookingCenterConfig';
import RoomEquipmentBlock from './RoomEquipmentBlock';
import { AttachmentList, AttachmentPicker, uploadAttachments, uploadFailureNotice } from './BookingAttachments';
import { ExtraRoomsPicker, RoomSetList, attachRoomSets, extraRoomsPayload, extraRoomsReady } from './RoomSets';

const STATUS={
  pending:{label:'На согласовании',hint:'Заявка отправлена администратору',tone:'pending'},
  approved:{label:'Подтверждено',hint:'Аудитория забронирована',tone:'approved'},
  rejected:{label:'Отклонено',hint:'Администратор отказал в бронировании',tone:'rejected'},
  cancelled:{label:'Отменено',hint:'Бронирование отменено',tone:'cancelled'},
  cancelled_by_user:{label:'Отменено вами',hint:'Отмена сохранена в истории',tone:'cancelled_by_user'},
  cancelled_by_admin:{label:'Отменено администратором',hint:'Посмотрите причину отмены',tone:'cancelled_by_admin'},
  completed:{label:'Состоялось',hint:'Мероприятие завершено',tone:'completed'},
  no_show:{label:'Неявка',hint:'Зафиксирована неявка',tone:'no_show'},
  transferred:{label:'Перенесено',hint:'Исходная бронь сохранена в истории',tone:'transferred'},
};
const CLOSED=['rejected','cancelled','cancelled_by_user','cancelled_by_admin','completed','no_show','transferred'];
const today=()=>localIso();
const formatDate=value=>new Date(`${value}T00:00:00`).toLocaleDateString('ru-RU',{day:'numeric',month:'long',year:'numeric'});
const timeOptions=Array.from({length:29},(_,index)=>{const minutes=8*60+index*30;return `${String(Math.floor(minutes/60)).padStart(2,'0')}:${String(minutes%60).padStart(2,'0')}`});
// A series card shows the state of its dates that still matter: one expired first date must not make the whole series look rejected.
const SERIES_STATUS_PRIORITY=['pending','approved','completed','no_show'];
const seriesRepresentative=group=>SERIES_STATUS_PRIORITY.map(status=>group.find(entry=>entry.status===status)).find(Boolean)||group[0];
const nowStamp=()=>{const now=new Date();return `${localIso()} ${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}`};
const canCancelEntry=entry=>!CLOSED.includes(entry.status)&&`${entry.date} ${String(entry.time_start).slice(0,5)}`>nowStamp();
const groupSeriesItems=items=>{const groups=new Map();for(const item of items){const key=item.series_id?'series:'+item.series_id:'item:'+item.id;if(!groups.has(key))groups.set(key,[]);groups.get(key).push(item)}return [...groups.values()].map(group=>{group.sort((a,b)=>String(a.date+' '+a.time_start).localeCompare(String(b.date+' '+b.time_start)));const first=group[0];const shown=seriesRepresentative(group);return group.length===1?first:{...shown,series_items:group,series_count:group.length,series_dates:[group[0].date,group[group.length-1].date]}})};
const cleanDate=value=>formatDate(value).replace(/\s*г\.$/,'');
const weekdayOf=(value,width)=>new Date(`${value}T00:00:00`).toLocaleDateString('ru-RU',{weekday:width});
const monthShort=value=>new Date(`${value}T00:00:00`).toLocaleDateString('ru-RU',{month:'short'}).replace('.','');
const dateRange=(from,to)=>{if(from===to)return cleanDate(from);const a=new Date(`${from}T00:00:00`),b=new Date(`${to}T00:00:00`);if(a.getFullYear()!==b.getFullYear())return `${cleanDate(from)} — ${cleanDate(to)}`;const head=a.getMonth()===b.getMonth()?String(a.getDate()):a.toLocaleDateString('ru-RU',{day:'numeric',month:'long'});return `${head} — ${cleanDate(to)}`};
const durationLabel=(start,end)=>{const [h1,m1]=start.split(':').map(Number),[h2,m2]=end.split(':').map(Number);const total=h2*60+m2-h1*60-m1,hours=Math.floor(total/60),minutes=total%60;return [hours?`${hours} ч`:'',minutes?`${minutes} мин`:''].filter(Boolean).join(' ')};
const plural=(count,one,few,many)=>{const n=Math.abs(count)%100,last=n%10;return n>10&&n<20?many:last===1?one:last>=2&&last<=4?few:many};
const chronological=(a,b)=>`${a.date||''} ${a.time_start||''} ${a.time_end||''}`.localeCompare(`${b.date||''} ${b.time_start||''} ${b.time_end||''}`)||Number(a.id||0)-Number(b.id||0);

export default function UserBookingPortal({request,notice,user,rooms,buildings,onChanged,goToRooms,focusedBooking,initialRoom,clearInitialRoom,active=true,refreshKey=0,seriesRequest,clearSeriesRequest}){
  const [items,setItems]=useState([]);const [tab,setTab]=useState('request');const [loading,setLoading]=useState(true);
  const [availability,setAvailability]=useState(null);const [selected,setSelected]=useState(null);const [checking,setChecking]=useState(false);const [saving,setSaving]=useState(false);
  const [cancelTarget,setCancelTarget]=useState(null);const resultsRef=useRef(null);const checkSeq=useRef(0);const [seriesMode,setSeriesMode]=useState(false);const [seriesRooms,setSeriesRooms]=useState([]);const [seriesDateEnd,setSeriesDateEnd]=useState('');const [seriesWeekdays,setSeriesWeekdays]=useState([0,1,2,3,4]);
  const [guideOpen,setGuideOpen]=useState(()=>{try{return localStorage.getItem('room-booking-user-guide-seen')!=='1'}catch{return true}});const [attempted,setAttempted]=useState(false);
  const closeGuide=()=>{setGuideOpen(false);try{localStorage.setItem('room-booking-user-guide-seen','1')}catch{}};
  const emptyForm={date:'',time_start:'',time_end:'',participants:'',building_id:'',room_type:'',title:'',comment:'',catering:'',equipment:[],department_id:'',department_name:user?.department||'',customer_name:'',customer_contact:user?.phone||''};
  const [form,setForm]=useState(emptyForm);const [departments,setDepartments]=useState([]);const [seriesBusy,setSeriesBusy]=useState({});const [files,setFiles]=useState([]);const [extraRooms,setExtraRooms]=useState([]);
  useEffect(()=>{request('/api/departments').then(list=>{setDepartments(list);setForm(current=>{if(current.department_id)return current;const known=list.find(item=>item.name.toLowerCase()===String(current.department_name||'').trim().toLowerCase());return known?{...current,department_id:String(known.id)}:current.department_name?{...current,department_id:'other'}:current})}).catch(()=>{})},[]);
  const load=()=>{setLoading(true);return request('/api/me/bookings').then(data=>setItems([...data].sort((a,b)=>String(b.created_at||b.date+' '+b.time_start).localeCompare(String(a.created_at||a.date+' '+a.time_start))||chronological(b,a)))).catch(error=>notice(error.message)).finally(()=>setLoading(false))};
  useEffect(()=>{if(active)load()},[active,refreshKey]);
  useEffect(()=>{if(!initialRoom)return;setTab('request');setForm(current=>({...current,building_id:String(initialRoom.building_id),room_type:initialRoom.type||''}));setSelected(initialRoom);setAvailability(null)},[initialRoom]);
  useEffect(()=>{if(focusedBooking?.id)setTab('history')},[focusedBooking?.token]);
  useEffect(()=>{if(!seriesRequest)return;setTab('request');setSeriesMode(true);setSeriesRooms(seriesRequest.room?[seriesRequest.room]:[]);setAvailability(null);clearSeriesRequest?.()},[seriesRequest?.token]);
  const equipmentRooms=(seriesMode?seriesRooms:[selected||initialRoom]).filter(Boolean).map(room=>rooms.find(item=>item.id===room.id)||room);
  const equipment=useMemo(()=>additionalEquipmentOptions(rooms),[rooms]);
  const searchEquipment=equipmentSearchFilter(form.equipment);
  const candidateRooms=useMemo(()=>rooms.filter(room=>(!form.building_id||String(room.building_id)===String(form.building_id))&&(!form.room_type||room.type===form.room_type)&&(!Number(form.participants)||Math.max(room.capacity,room.max_capacity||0)>=Number(form.participants))&&(!searchEquipment.length||searchEquipment.every(item=>roomEquipmentCategories(room).includes(item)))).slice(0,12),[rooms,form.building_id,form.room_type,form.participants,form.equipment]);
  // Only the search parameters invalidate the found rooms; contact fields and the comment keep the selection.
  const SEARCH_FIELDS=['date','time_start','time_end','participants','building_id','room_type','equipment'];
  const update=(key,value)=>{setForm(current=>({...current,[key]:value}));if(SEARCH_FIELDS.includes(key)){setAvailability(null);setSelected(initialRoom||null);if(key==='date')setExtraRooms([])}};
  const toggleEquipment=value=>update('equipment',form.equipment.includes(value)?form.equipment.filter(item=>item!==value):[...form.equipment,value]);
  const searchReady=Boolean(form.date&&form.time_start&&form.time_end&&form.time_end>form.time_start&&Number(form.participants)>0);
  const departmentReady=form.department_id==='other'?form.department_name.trim().length>=2:Boolean(form.department_id);
  const departmentPayload=form.department_id==='other'?{department_id:null,department_name:form.department_name.trim()}:{department_id:Number(form.department_id),department_name:null};
  const requiredReady=Boolean(searchReady&&form.title.trim().length>=2&&form.customer_name.trim().length>=2&&form.customer_contact.trim().length>=3&&departmentReady);
  const check=async(silent=false)=>{const seq=++checkSeq.current;if(!searchReady){if(!silent){setAttempted(true);notice('Укажите дату, время и количество участников')}return}setChecking(true);try{const result=await request('/api/availability',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({date:form.date,time_start:form.time_start,time_end:form.time_end,participants:Number(form.participants),building_id:form.building_id?Number(form.building_id):null,room_type:form.room_type||null,equipment:searchEquipment})});if(seq!==checkSeq.current)return;setAvailability(result);const preferred=result.free.find(room=>room.id===initialRoom?.id);setSelected(preferred||null);window.setTimeout(()=>resultsRef.current?.scrollIntoView({behavior:'smooth',block:'nearest'}),100)}catch(error){if(seq===checkSeq.current)notice(error.message)}finally{if(seq===checkSeq.current)setChecking(false)}};
  useEffect(()=>{if(!searchReady)return;const timer=setTimeout(()=>check(true),450);return()=>clearTimeout(timer)},[form.date,form.time_start,form.time_end,form.participants,form.building_id,form.room_type,form.equipment.join('|')]);
  useEffect(()=>{if(!seriesMode||!searchReady||!seriesDateEnd||seriesDateEnd<form.date||!seriesWeekdays.length){setSeriesBusy({});return}let active=true;const timer=setTimeout(()=>request('/api/booking-series/availability',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({date:form.date,date_end:seriesDateEnd,time_start:form.time_start,time_end:form.time_end,weekdays:seriesWeekdays})}).then(data=>active&&setSeriesBusy(data.busy||{})).catch(()=>active&&setSeriesBusy({})),300);return()=>{active=false;clearTimeout(timer)}},[seriesMode,form.date,seriesDateEnd,form.time_start,form.time_end,seriesWeekdays.join('|')]);
  const submit=async()=>{setAttempted(true);if(!selected||!requiredReady){notice('Заполните ФИО ответственного, подразделение, телефон и остальные обязательные поля');return}if(!extraRoomsReady(extraRooms)){notice('Для каждой дополнительной аудитории выберите аудиторию и назначение');return}setSaving(true);try{const created=await request('/api/bookings',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({room_id:selected.id,date:form.date,time_start:form.time_start,time_end:form.time_end,participants:Number(form.participants),title:form.title.trim(),booking_type:'other',teacher:null,group_name:null,comment:form.comment.trim()||null,catering_required:form.catering?form.catering==='yes':null,requested_equipment:form.equipment,...departmentPayload,customer_name:form.customer_name.trim(),customer_contact:form.customer_contact.trim(),extra_rooms:extraRoomsPayload(extraRooms)})});const failed=await uploadAttachments(request,{bookingId:created.id},files);setFiles([]);setExtraRooms([]);notice('Заявка отправлена администратору на согласование'+uploadFailureNotice(failed));setForm({...emptyForm,department_id:form.department_id,department_name:form.department_name.trim(),customer_contact:form.customer_contact.trim()});setAvailability(null);setSelected(null);setAttempted(false);clearInitialRoom?.();setTab('history');await load();onChanged?.()}catch(error){notice(error.message)}finally{setSaving(false)}};
  const seriesBusyDates=room=>seriesBusy[String(room.id)]||[];
  const toggleSeriesRoom=room=>setSeriesRooms(current=>current.some(item=>item.id===room.id)?current.filter(item=>item.id!==room.id):[...current,room]);
  const toggleSeriesDay=day=>setSeriesWeekdays(current=>current.includes(day)?current.filter(item=>item!==day):[...current,day]);
  const submitSeries=async()=>{setAttempted(true);if(!requiredReady||!seriesDateEnd||seriesDateEnd<form.date||seriesRooms.length===0){notice('Заполните поля серии и выберите хотя бы одну аудиторию');return}const blocked=seriesRooms.find(room=>seriesBusyDates(room).length);if(blocked){notice(`Аудитория ${blocked.number} занята в часть дат серии — выберите другую аудиторию или измените период`);return}setSaving(true);try{const created=await request('/api/booking-series',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({room_ids:seriesRooms.map(room=>room.id),date:form.date,date_end:seriesDateEnd,time_start:form.time_start,time_end:form.time_end,weekdays:seriesWeekdays,title:form.title.trim(),booking_type:'other',teacher:null,group_name:null,comment:form.comment.trim()||null,catering_required:form.catering?form.catering==='yes':null,requested_equipment:form.equipment,participants:Number(form.participants),customer_name:form.customer_name.trim(),customer_contact:form.customer_contact.trim(),...departmentPayload})});const failed=created.series_id?await uploadAttachments(request,{seriesId:created.series_id},files):[];setFiles([]);notice('Серия заявок отправлена администратору на согласование'+uploadFailureNotice(failed));setForm({...emptyForm,department_id:form.department_id,department_name:form.department_name.trim(),customer_contact:form.customer_contact.trim()});setSeriesRooms([]);setSeriesDateEnd('');setAvailability(null);setSelected(null);setSeriesMode(false);setAttempted(false);clearInitialRoom?.();setTab('history');await load();onChanged?.()}catch(error){notice(error.message)}finally{setSaving(false)}};
  const cancelDone=async()=>{const series=Boolean(cancelTarget?.series_items);setCancelTarget(null);notice(series?'Серия отменена, информация сохранена в истории':'Заявка отменена, информация сохранена в истории');await load();onChanged?.()};
  return <section className="content-page user-booking-portal">
    <header className="user-booking-hero"><div><small>ЛИЧНЫЙ КАБИНЕТ</small><h1>Мои бронирования</h1><p>Подберите свободную аудиторию, отправьте заявку и следите за решением администратора.</p></div><button className="secondary" onClick={goToRooms}><Building2/>Посмотреть все аудитории</button></header>
    <div className="user-portal-tabs"><button className={tab==='request'&&!seriesMode?'active':''} onClick={()=>{setTab('request');if(seriesMode){setSeriesMode(false);setSeriesRooms([]);setAvailability(null);setSelected(initialRoom||null)}}}><Send/>Новая заявка</button><button className={tab==='request'&&seriesMode?'active':''} onClick={()=>{setTab('request');if(!seriesMode){setSeriesMode(true);setSeriesRooms([]);setAvailability(null);setSelected(null)}}}><CalendarCheck/>Серия бронирований</button><button className={tab==='history'?'active':''} onClick={()=>setTab('history')}><History/>История заявок <b>{items.length}</b></button>{tab==='request'&&<button className="user-guide-open" onClick={()=>setGuideOpen(true)}><ShieldCheck/>Как это работает</button>}</div>
    {tab==='request'?<div className={`user-request-layout ${(form.building_id||form.room_type||availability)?'has-matches':''} ${seriesMode?'series-modal-mode':''}`}>{seriesMode&&<div className="series-modal-banner"><div><small>НОВЫЙ ФОРМАТ БРОНИРОВАНИЯ</small><h2>Серия бронирований</h2><p>Одна заявка на несколько дат и аудиторий</p></div><button type="button" className="icon" onClick={()=>{setSeriesMode(false);setSeriesRooms([])}}>Закрыть</button></div>}<section className="user-request-form"><header><span>1</span><div><h2>Параметры мероприятия</h2><p>Сначала укажите условия — сервис покажет только подходящие варианты.</p></div></header>{initialRoom&&<div className="user-preselected-room" style={{'--room-color':initialRoom.color}}><img src={initialRoom.images?.[0]} alt=""/><span><small>ВЫБРАННАЯ АУДИТОРИЯ</small><b>{initialRoom.building} · аудитория {initialRoom.number}</b><em>{initialRoom.name} · {initialRoom.capacity} мест</em></span><Check/></div>}<div className="user-request-fields">
      <label className={form.date?'complete':attempted?'invalid':''}><span>{seriesMode?'Дата начала серии *':'Дата *'}</span><input type="date" lang="ru-RU" min={today()} value={form.date} onChange={event=>update('date',event.target.value)}/></label>
      {seriesMode&&<label className={seriesDateEnd&&seriesDateEnd>=form.date?'complete':attempted?'invalid':''}><span>Дата окончания серии *</span><input type="date" lang="ru-RU" min={form.date||today()} value={seriesDateEnd} onChange={event=>setSeriesDateEnd(event.target.value)}/></label>}
      {seriesMode&&<div className="series-fields full"><div><span>Дни повторения *</span><div className="series-weekdays">{[['Пн',0],['Вт',1],['Ср',2],['Чт',3],['Пт',4],['Сб',5],['Вс',6]].map(([name,day])=><button type="button" className={seriesWeekdays.includes(day)?'active':''} onClick={()=>toggleSeriesDay(day)} key={day}>{name}</button>)}</div></div><p className="series-hint">Выберите аудитории справа — заявка будет отправлена одной серией на согласование.</p></div>}
      <label className={form.time_start?'complete':attempted?'invalid':''}><span>Начало *</span><select value={form.time_start} onChange={event=>update('time_start',event.target.value)}><option value="">Выберите время</option>{timeOptions.map(value=><option key={value}>{value}</option>)}</select></label>
      <label className={form.time_end&&form.time_end>form.time_start?'complete':attempted?'invalid':''}><span>Окончание *</span><select value={form.time_end} onChange={event=>update('time_end',event.target.value)}><option value="">Выберите время</option>{timeOptions.map(value=><option key={value}>{value}</option>)}</select></label>
      <label className={Number(form.participants)>0?'complete':attempted?'invalid':''}><span>Количество участников *</span><input type="number" min="1" max="5000" value={form.participants} onChange={event=>update('participants',event.target.value)} placeholder="Например, 25"/></label>
      <label><span>Корпус</span><select value={form.building_id} onChange={event=>update('building_id',event.target.value)}><option value="">Любой корпус</option>{buildings.map(item=><option value={item.id} key={item.id}>{item.name}</option>)}</select></label>
      <label><span>Тип аудитории</span><select value={form.room_type} onChange={event=>update('room_type',event.target.value)}><option value="">Любой тип</option>{Object.entries(ROOM_TYPES).map(([value,label])=><option value={value} key={value}>{label}</option>)}</select></label>
      <label className={`full ${form.title.trim().length>=2?'complete':attempted?'invalid':''}`}><span>Название мероприятия *</span><input value={form.title} onChange={event=>update('title',event.target.value)} placeholder="Например, совещание проектной группы"/></label>
      <label className={form.customer_name.trim().length>=2?'complete':attempted?'invalid':''}><span>ФИО ответственного *</span><input value={form.customer_name} onChange={event=>update('customer_name',event.target.value)} placeholder="Иванова Анна Сергеевна"/></label>
      <label className={departmentReady?'complete':attempted?'invalid':''}><span>Структурное подразделение *</span><select value={form.department_id} onChange={event=>update('department_id',event.target.value)}><option value="">Выберите подразделение</option>{departments.map(item=><option value={item.id} key={item.id}>{item.name}</option>)}<option value="other">Нет в списке — указать вручную</option></select>{form.department_id==='other'&&<input value={form.department_name} onChange={event=>update('department_name',event.target.value)} placeholder="Полное название подразделения"/>}</label>
      <label className={form.customer_contact.trim().length>=3?'complete':attempted?'invalid':''}><span>Телефон *</span><input type="tel" value={form.customer_contact} onChange={event=>update('customer_contact',event.target.value)} placeholder="+7 999 000-00-00"/></label>
      <RoomEquipmentBlock className="full" rooms={equipmentRooms}/>
      <details className="full user-equipment"><summary><span><Wrench/>Дополнительное техническое оснащение</span><b>{form.equipment.length||'Не выбрано'}</b><ChevronRight/></summary><div>{equipment.map(item=><label key={item}><input type="checkbox" checked={form.equipment.includes(item)} onChange={()=>toggleEquipment(item)}/><span>{item}</span></label>)}</div></details>
      <div className="full catering-question" role="radiogroup" aria-label="Требуется ли аудитория для организации питания?"><span>Требуется ли аудитория для организации питания?</span><div>{[['yes','Да'],['no','Нет']].map(([value,label])=><button type="button" role="radio" aria-checked={form.catering===value} className={form.catering===value?'active':''} onClick={()=>update('catering',form.catering===value?'':value)} key={value}>{label}</button>)}</div></div><AttachmentPicker files={files} onChange={setFiles}/><label className="full"><span>Комментарий администратору</span><textarea value={form.comment} onChange={event=>update('comment',event.target.value)} placeholder="Необязательное поле: важные детали или пожелания"/></label>
    </div><p className={`user-search-status ${searchReady?'ready':''}`}><Search/>{checking?'Ищем свободные аудитории…':searchReady?(availability?`Найдено свободных аудиторий: ${availability.free.length}. Список обновляется сам при изменении параметров.`:'Подбираем аудитории…'):'Укажите дату, время и количество участников — свободные аудитории появятся автоматически.'}</p></section>
    {(form.building_id||form.room_type||availability)&&<RoomMatchesPanel request={request} attempted={attempted} extraRooms={extraRooms} setExtraRooms={setExtraRooms} seriesBusyDates={seriesBusyDates} seriesMode={seriesMode} seriesRooms={seriesRooms} toggleSeriesRoom={toggleSeriesRoom} seriesSubmit={submitSeries} panelRef={resultsRef} rooms={availability?(availability.free.find(room=>room.id===initialRoom?.id)?availability.free.filter(room=>room.id===initialRoom.id):availability.free):(initialRoom?[initialRoom]:candidateRooms)} availability={availability} form={form} selected={selected} select={setSelected} saving={saving} submit={submit}/>}</div>:<UserBookingHistory items={items} loading={loading} focusedBooking={focusedBooking} cancel={setCancelTarget} request={request} user={user} reload={load}/>} 
    {guideOpen&&tab==='request'&&<div className="user-guide-overlay" role="dialog" aria-modal="true"><button className="user-guide-backdrop" aria-label="Закрыть" onClick={closeGuide}/><aside className="user-request-guide user-guide-popup"><button className="user-guide-close" aria-label="Закрыть" onClick={closeGuide}><X/></button><h3>Как это работает</h3>{[['1','Заполните параметры'],['2','Выберите свободную аудиторию'],['3','Отправьте заявку'],['4','Получите решение администратора']].map(([number,text])=><div key={number}><b>{number}</b><span>{text}</span></div>)}<p><ShieldCheck/>До подтверждения заявка не считается окончательной бронью.</p></aside></div>}
    {cancelTarget&&<UserCancelDialog item={cancelTarget} request={request} close={()=>setCancelTarget(null)} done={cancelDone}/>} 
  </section>
}

function RoomMatchesPanel({request,attempted,extraRooms,setExtraRooms,panelRef,rooms,availability,form,selected,select,saving,submit,seriesMode,seriesRooms,toggleSeriesRoom,seriesSubmit,seriesBusyDates}){const shortDate=value=>new Date(`${value}T00:00:00`).toLocaleDateString('ru-RU',{day:'2-digit',month:'2-digit'});return <aside className="user-match-pane" ref={panelRef}><section className="user-availability"><header><div><small>{availability?'РЕЗУЛЬТАТ ПОДБОРА':'ПОДХОДЯЩИЕ ВАРИАНТЫ'}</small><h2>{availability?'Свободные аудитории':'Подходящие аудитории'}</h2><p>{availability?`${formatDate(form.date)}, ${form.time_start}–${form.time_end} · ${form.participants} участников`:'Укажите дату, время и количество участников, чтобы проверить занятость.'}</p></div><span>{rooms.length}</span></header>{rooms.length?<div className="user-available-grid">{rooms.map(room=><button type="button" className={seriesMode?(seriesRooms?.some(item=>item.id===room.id)?'selected':''):(selected?.id===room.id?'selected':'')} onClick={()=>availability&&(seriesMode?(seriesBusyDates(room).length&&!seriesRooms?.some(item=>item.id===room.id)?null:toggleSeriesRoom(room)):select(room))} key={room.id}><img src={room.images?.[0]} alt=""/><div><small>{room.building}</small><h3>Аудитория {room.number}</h3><p>{room.capacity} мест{room.over_capacity?' (нужны доп. места)':''} · {ROOM_TYPES[room.type]||room.type}</p>{room.pending_requests?.length>0&&<em className="soft-request-warning">Есть ещё заявок: {room.pending_requests.length}</em>}{seriesMode&&seriesBusyDates(room).length>0&&<em className="soft-request-warning series-busy-warning">Занята в даты серии: {seriesBusyDates(room).slice(0,6).map(shortDate).join(', ')}{seriesBusyDates(room).length>6?` и ещё ${seriesBusyDates(room).length-6}`:''}</em>}</div>{seriesMode?(seriesRooms?.some(item=>item.id===room.id)?<Check/>:<ChevronRight/>):(availability?(selected?.id===room.id?<Check/>:<ChevronRight/>):<Clock3/>)}</button>)}</div>:<div className="user-no-availability"><AlertCircle/><b>{availability?'Свободных аудиторий нет':'Подходящих аудиторий нет'}</b><span>Измените вместимость, корпус, тип или оснащение.</span></div>}{seriesMode&&seriesRooms?.length>0&&<footer><div><Check/><span><small>ВЫБРАНО ДЛЯ СЕРИИ</small><b>{seriesRooms.length} аудиторий</b></span></div><button className="primary" disabled={saving} onClick={seriesSubmit}><Send/>{saving?'Отправляем…':'Отправить серию на согласование'}</button></footer>}{availability&&selected&&!seriesMode&&<ExtraRoomsPicker request={request} availabilityUrl="/api/availability" date={form.date} timeStart={form.time_start} timeEnd={form.time_end} mainRoomId={selected.id} value={extraRooms} onChange={setExtraRooms} attempted={attempted}/>}{availability&&selected&&!seriesMode&&<footer><div><Check/><span><small>ВЫБРАНО</small><b>{selected.building} · аудитория {selected.number}</b></span></div><button className="primary" disabled={saving} onClick={submit}><Send/>{saving?'Отправляем…':'Отправить на согласование'}</button></footer>}</section></aside>}

const HISTORY_STATUS_FILTERS=[['all','Все',null],['active','Активные',['pending','approved']],['pending','На согласовании',['pending']],['approved','Подтверждённые',['approved']],['completed','Состоявшиеся',['completed']],['rejected','Отклонённые',['rejected']],['cancelled','Отменённые',['cancelled','cancelled_by_user','cancelled_by_admin']]];
const HISTORY_KIND_FILTERS=[['all','Все заявки'],['single','Обычные'],['series','Серии']];

function UserBookingHistory({items,loading,focusedBooking,cancel,request,user,reload}){const [filter,setFilter]=useState('active');const [kind,setKind]=useState('all');const [highlighted,setHighlighted]=useState(null);useEffect(()=>{if(!focusedBooking?.id)return;setFilter('all');setKind('all');setHighlighted(focusedBooking.id);const scroll=setTimeout(()=>document.querySelector(`[data-booking-ids~="${focusedBooking.id}"]`)?.scrollIntoView({behavior:'smooth',block:'center'}),140);const clear=setTimeout(()=>setHighlighted(null),4200);return()=>{clearTimeout(scroll);clearTimeout(clear)}},[focusedBooking?.token,loading,items.length]);const statuses=HISTORY_STATUS_FILTERS.find(([value])=>value===filter)?.[2];const filtered=groupSeriesItems(attachRoomSets(items).filter(item=>(!statuses||statuses.includes(item.status))&&(kind==='all'||(kind==='series')===Boolean(item.series_id))));return <section className="user-booking-history"><header><div><h2>История заявок</h2><p>Здесь сохраняются все решения, отмены и состоявшиеся мероприятия.</p></div><div className="history-filters"><div className="history-filter-group"><span>Вид</span>{HISTORY_KIND_FILTERS.map(([value,label])=><button className={kind===value?'active':''} onClick={()=>setKind(value)} key={value}>{label}</button>)}</div><div className="history-filter-group"><span>Статус</span>{HISTORY_STATUS_FILTERS.map(([value,label])=><button className={filter===value?'active':''} onClick={()=>setFilter(value)} key={value}>{label}</button>)}</div></div></header>{loading?<div className="user-history-empty">Загрузка…</div>:filtered.length?<div className="user-history-list">{filtered.map(item=>{const status=STATUS[item.status]||{label:item.status,hint:'',tone:item.status};const entries=item.series_items||[item];const ids=entries.map(entry=>entry.id);const series=entries.length>1;const dates=[...new Set(entries.map(entry=>entry.date))];const roomNumbers=[...new Set(entries.map(entry=>entry.room_number))];const buildingNames=[...new Set(entries.map(entry=>entry.building))];return <article id={`user-booking-${item.id}`} data-booking-ids={ids.join(' ')} className={`request-card tone-${status.tone} ${ids.includes(highlighted)?'booking-focus-highlight':''}`} key={item.id}><header className="request-card-top"><em className={`status ${status.tone}`}>{status.label}</em>{series&&<span className="request-series-chip"><CalendarCheck/>Серия · {dates.length} {plural(dates.length,'дата','даты','дат')}</span>}</header><h3 title={item.title}>{item.title}</h3><ul className="request-facts"><li><CalendarCheck/><span><b>{series?dateRange(dates[0],dates[dates.length-1]):cleanDate(item.date)}</b><small>{series?`${dates.length} ${plural(dates.length,'дата','даты','дат')} в серии`:weekdayOf(item.date,'long')}</small></span></li><li><Clock3/><span><b>{item.time_start}–{item.time_end}</b><small>{durationLabel(item.time_start,item.time_end)}</small></span></li><li><MapPin/><span><b>{roomNumbers.length===1?`Аудитория ${roomNumbers[0]}`:`Аудитории ${roomNumbers.join(', ')}`}</b><small>{buildingNames.join(', ')}</small></span></li><li><Users/><span><b>{item.participants?`${item.participants} ${plural(item.participants,'участник','участника','участников')}`:'Участники не указаны'}</b><small>{item.department_name||'Подразделение не указано'}</small></span></li></ul>{series&&<div className="request-dates" aria-label="Даты серии">{dates.slice(0,14).map(day=>{const off=entries.filter(entry=>entry.date===day).every(entry=>CLOSED.includes(entry.status)&&entry.status!=='completed');return <span className={off&&!CLOSED.includes(item.status)?'off':''} title={off&&!CLOSED.includes(item.status)?'Эта дата отменена или отклонена':cleanDate(day)} key={day}><small>{weekdayOf(day,'short')}</small><b>{new Date(`${day}T00:00:00`).getDate()}</b><small>{monthShort(day)}</small></span>})}{dates.length>14&&<span className="more"><b>+{dates.length-14}</b></span>}</div>}{item.status==='approved'&&item.decided_by&&<p className="request-note approved"><ShieldCheck/><span>Подтвердил(а) <b>{item.decided_by}</b>{item.decision_at?` · ${new Date(item.decision_at).toLocaleDateString('ru-RU',{day:'2-digit',month:'2-digit'})}`:''}</span></p>}{item.status==='rejected'&&<p className="request-note rejected"><AlertCircle/><span><b>Причина отказа:</b> {item.decision_reason||'не указана'}</span></p>}{item.cancellation_reason&&<p className="request-note rejected"><AlertCircle/><span><b>Причина отмены:</b> {item.cancellation_reason}{item.cancellation_comment?` — ${item.cancellation_comment}`:''}</span></p>}<RoomSetList extras={item.set_extras||[]} actions={extra=>canCancelEntry(extra)&&<button className="danger-link" onClick={()=>cancel(extra)}>Отменить</button>}/><AttachmentList compact items={[...new Map(entries.flatMap(entry=>entry.attachments||[]).map(file=>[file.id,file])).values()]} request={request} user={user} onChanged={reload} uploadTarget={entries.some(canCancelEntry)?(series?{seriesId:item.series_id}:{bookingId:item.id}):null}/><footer className="request-card-foot">{item.created_at&&<small title={new Date(item.created_at).toLocaleString('ru-RU',{hour12:false})}>Создана {new Date(item.created_at).toLocaleString('ru-RU',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit',hour12:false})}</small>}{entries.some(canCancelEntry)&&<button className="danger-link" onClick={()=>cancel(item)}>{series?'Отменить серию':'Отменить заявку'}</button>}</footer></article>})}</div>:<div className="user-history-empty"><History/><b>В этой категории заявок нет</b></div>}</section>}

function UserCancelDialog({item,request,close,done}){const targets=(item.series_items||[item]).filter(canCancelEntry);const [saving,setSaving]=useState(false);const [error,setError]=useState('');const submit=async event=>{event.preventDefault();setSaving(true);const data=Object.fromEntries(new FormData(event.currentTarget));const body=JSON.stringify({reason:data.reason,comment:data.comment,replacement_offered:false,notify_customer:false});try{if(item.series_items)await request(`/api/me/booking-series/${item.series_id}/cancel`,{method:'POST',headers:{'Content-Type':'application/json'},body});else await request(`/api/me/bookings/${item.id}/cancel`,{method:'POST',headers:{'Content-Type':'application/json'},body});done()}catch(failure){setError(failure.message);setSaving(false)}};return <div className="modal"><button className="backdrop" onClick={close}/><form className="user-cancel-dialog" onSubmit={submit}><header><div><small>ОТМЕНА С СОХРАНЕНИЕМ ИСТОРИИ</small><h2>{item.series_items?'Отменить серию':'Отменить заявку'}</h2></div><button type="button" className="icon" onClick={close}><X/></button></header>{item.series_items?<p>Серия бронирований: будет отменено записей — {targets.length}<br/>{formatDate(item.series_dates[0])} — {formatDate(item.series_dates[1])}, {item.time_start}–{item.time_end}</p>:<p>{item.building} · аудитория {item.room_number}<br/>{formatDate(item.date)}, {item.time_start}–{item.time_end}</p>}<label><span>Причина отмены</span><select name="reason" required><option value="">Выберите причину</option><option>Изменились планы</option><option>Мероприятие перенесено</option><option>Аудитория больше не требуется</option><option>Ошибка в параметрах заявки</option><option>Другая причина</option></select></label><label><span>Комментарий</span><textarea name="comment" required minLength="2" placeholder="Уточните обстоятельства отмены"/></label>{error&&<p className="error">{error}</p>}<footer><button type="button" className="secondary" onClick={close}>Вернуться</button><button className="soft-danger" disabled={saving}>{saving?'Сохраняем…':'Подтвердить отмену'}</button></footer></form></div>}
