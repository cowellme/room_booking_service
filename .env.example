POSTGRES_DB=room_booking
HTTP_PORT=80
POSTGRES_USER=room_booking
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://room_booking:change-me@db:5432/room_booking
SECRET_KEY=replace-with-at-least-32-random-characters
COOKIE_SECURE=true
ALLOWED_ORIGINS=https://booking.example.org
SEED_DEMO_DATA=false
WORK_HOURS_START=8
WORK_HOURS_END=22
TIME_SLOT_MINUTES=30
MIN_BOOKING_MINUTES=30
MAX_BOOKING_MINUTES=840
APP_TIMEZONE=Europe/Moscow
# Automatic booking status processing, independent of page views.
LIFECYCLE_WORKER_ENABLED=true
LIFECYCLE_INTERVAL_SECONDS=30
# Домены почты, с которых разрешена регистрация, через запятую (например, university.ru).
# Пусто — подойдёт любой адрес, но код подтверждения всё равно нужен.
ALLOWED_EMAIL_DOMAINS=

# --- Почта (коды регистрации и сброса пароля) ---
# log — письма не отправляются, код печатается в консоль бэкенда (пока не подключена почта).
# smtp — настоящая отправка. Если EMAIL_MODE пуст, режим smtp включается сам, когда задан SMTP_USER.
EMAIL_MODE=log
# Яндекс 360: smtp.yandex.ru, порт 465, SSL. SMTP_USER — ящик на корпоративном домене
# (например, booking@university.ru), SMTP_PASSWORD — пароль приложения из id.yandex.ru
# (Безопасность → Пароли приложений → Почта), а не обычный пароль ящика.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
# Адрес отправителя; по умолчанию равен SMTP_USER. Яндекс требует, чтобы он совпадал с ящиком или его алиасом.
SMTP_FROM=
# Ссылка на сервис, попадает в текст письма.
APP_PUBLIC_URL=
EMAIL_CODE_TTL_MINUTES=15
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_PER_HOUR=6
EMAIL_CODE_MAX_ATTEMPTS=5

# --- Защита входа ---
# Считается по учётной записи, а не по IP: сотрудники с одного офисного IP не мешают друг другу.
# После LOGIN_MAX_FAILURES неверных паролей подряд аккаунт ждёт 1, 2, 4… минут (не больше LOGIN_LOCK_MAX_MINUTES).
# Сброс пароля по почте снимает паузу сразу.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=1
LOGIN_LOCK_MAX_MINUTES=15
LOGIN_FAILURE_WINDOW_MINUTES=30
# Грубый предохранитель на один IP за 15 минут; 0 — выключен.
LOGIN_IP_MAX_FAILURES=300
EMAIL_IP_MAX_CODES_PER_HOUR=300
